{
  "$schema": "https://raw.githubusercontent.com/academici/swissknifeman/main/packages/skiller/schema/swissknife.schema.json",
  "_comment": "Компактный marketplace-профиль PHP-пакета по образцу CoreX. Плагины атомарны; не добавляй архитектурные и системные бакеты без измеренного повода.",
  "plugins": [
    "core",
    "laravel-testing",
    "oss-dev",
    "php",
    "php-packages",
    "quality",
    "task"
  ],
  "providers": {
    "selection": {
      "claude-code": {
        "enabled": true
      },
      "codex": {
        "enabled": true
      },
      "cursor": {
        "enabled": true
      }
    },
    "contract_version": "1.0.0"
  }
}
