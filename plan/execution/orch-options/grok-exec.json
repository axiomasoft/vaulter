{
  "scout_enabled": true,
  "stages": [
    {
      "role": "context-scout",
      "provider": "grok",
      "model": "grok-4.5",
      "effort": "low"
    },
    {
      "role": "executor",
      "provider": "grok",
      "model": "grok-4.7",
      "effort": "xhigh"
    },
    {
      "role": "bounded-implementer",
      "provider": "grok",
      "model": "grok-4.7",
      "effort": "high"
    },
    {
      "role": "report-fixer",
      "provider": "grok",
      "model": "grok-4.5",
      "effort": "low"
    }
  ],
  "session": {
    "executor": "per-item"
  },
  "scope": {
    "fence": "plan",
    "outside": "block"
  },
  "checks": {
    "red_first": true,
    "fail_fast": false,
    "reuse": true
  },
  "limits": {
    "check_fixes": 2,
    "retries": 1,
    "repairs": 1,
    "prompt_core_tokens": 10000,
    "prompt_supporting_tokens": 16000,
    "stall_repeat_n": 4
  },
  "rules": [
    "Follow the packed task brief literally; never invent APIs or weaken tests.",
    "Respect all 12 CI stop-rails in plan/spec/engineering-standards.md (Zero-Royalty licenses, 64-bit hashtextextended, 0 unindexed FKs).",
    "Do not touch files outside --include; keep diff minimal and clean."
  ]
}
