# Actual values belong to repository root .env, never to the Vite source.
TIPTAP_ENVIRONMENT_ID=
TIPTAP_APP_ID=
TIPTAP_WS_URL=
TIPTAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
TIPTAP_PRO_TOKEN=
# Optional port overrides; local-only servers always bind 127.0.0.1.
TIPTAP_LAB_API_PORT=5194
TIPTAP_LAB_LOCAL_PORT=5195
