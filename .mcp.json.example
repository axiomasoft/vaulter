{
  "mcpServers": {
    "maind": {
      "command": "maind",
      "args": [
        "mcp",
        "--scope",
        "project:vaulter"
      ]
    },
    "codegraph": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena@026b007bb889366283c925527e9a3bab317f66c1",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "<ABS_PATH_TO_PROJECT>",
        "--enable-web-dashboard",
        "false"
      ]
    },
    "perplexity": {
      "command": "<HOME>/projects/packages/perplexity-web-mcp/start.sh",
      "args": [
        "--pool=default"
      ]
    }
  }
}
