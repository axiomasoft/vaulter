#!/usr/bin/env bash
# Keep Composer scripts and env-based PHP binaries on the same runtime.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bin="${PHP84_BIN:-$(command -v php8.4 || :)}"
if [[ -z "$bin" || ! -x "$bin" ]]; then
    echo "php84: php8.4 binary not found (set PHP84_BIN)" >&2
    exit 1
fi
bin="$(cd "$(dirname "$bin")" && pwd)/$(basename "$bin")"
shim="$root/build/php84/bin"
mkdir -p "$shim"
ln -sf "$bin" "$shim/php"
export PATH="$shim:$PATH"

if [[ "${1:-}" == "--check" ]]; then
    version="$(php -r 'echo PHP_VERSION;')"
    if [[ "$version" != 8.4.* ]]; then
        echo "php84: expected PHP 8.4.x, got $version" >&2
        exit 1
    fi
    required=(ctype curl dom fileinfo gd intl bcmath mbstring openssl pcntl posix pcov pdo_pgsql pdo_mysql pdo_sqlite sqlite3 sodium tokenizer xml zip)
    missing=()
    for ext in "${required[@]}"; do
        php -r "exit(extension_loaded('$ext') ? 0 : 1);" || missing+=("$ext")
    done
    if (( ${#missing[@]} )); then
        echo "php84: missing extensions: ${missing[*]}" >&2
        exit 1
    fi
    echo "php84 OK: $version"
    exit 0
fi

exec "$@"
