# P3.1 — PostgreSQL 16 profiling image: pg_stat_statements (preload via compose) + HypoPG 1.4.1.
FROM postgres:16-bookworm

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        build-essential \
        git \
        postgresql-server-dev-16; \
    git clone --depth 1 --branch 1.4.1 https://github.com/HypoPG/hypopg.git /tmp/hypopg; \
    make -C /tmp/hypopg; \
    make -C /tmp/hypopg install; \
    rm -rf /tmp/hypopg; \
    apt-get purge -y build-essential git postgresql-server-dev-16; \
    apt-get autoremove -y; \
    rm -rf /var/lib/apt/lists/*

COPY docker/postgres-init-profile.sql /docker-entrypoint-initdb.d/10-p3-profile.sql
