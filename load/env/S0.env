# VLT-LOAD — профиль S0 (CI-профиль, НЕ тир развёртывания).
# Источник чисел: plans/VLT-LOAD/reference-env.md §4.1 (D17/D21/Q3). Раннер (ubuntu-latest,
# 4 vCPU / 16 ГиБ / ~14 ГиБ диска) не строит непересекающиеся cpuset'ы (E-4) — поэтому НИ
# ОДИН CPUSET_* здесь не задаётся (пусто => docker compose опускает поле `cpuset` целиком,
# проверено `docker compose config`).  Только класс A; латентность с S0 недостоверна (D15).
TIER=S0

CPUSET_APP=
CPUSET_PG=
CPUSET_PGBOUNCER=
CPUSET_MINIO=
CPUSET_K6=

MEM_APP=1g
MEMSWAP_APP=1g
PM_MAX_CHILDREN=4
PHP_MEMORY_LIMIT=512M

MEM_PG=2g
MEMSWAP_PG=2g
# §1.2 в reference-env.md чисел для S0 не несёт (таблица только S/M/L) — деривация
# по тому же правилу E-3 (доли от cgroup-лимита 2 ГиБ), а не цитата чужого тира.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=16
PG_MAX_PARALLEL_WORKERS_PER_GATHER=0
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200
PG_CHECKPOINT_TIMEOUT=15min
PG_MAX_WAL_SIZE=1GB
PG_AUTOVACUUM_VACUUM_SCALE_FACTOR_ACTIVITY=0.01

MEM_PGBOUNCER=128m
MEMSWAP_PGBOUNCER=128m
PGBOUNCER_DEFAULT_POOL_SIZE=4
PGBOUNCER_MAX_CLIENT_CONN=50
PGBOUNCER_RESERVE_POOL_SIZE=1
PGBOUNCER_RESERVE_POOL_TIMEOUT=3

MEM_MINIO=512m
MEMSWAP_MINIO=512m

MEM_K6=1g
MEMSWAP_K6=1g

# Объёмы seed (P2.3) и максимальный размер файла в сценарии — reference-env.md §4.1.
SEED_NODES=20000
SEED_ACTIVITY=200000
SEED_EXPIRED_SESSIONS=5000
SEED_ORPHAN_BLOBS=2000
MAX_FIXTURE_BYTES=268435456
