# VLT-LOAD — тир M («типовой прод-хост»). D25: на ЭТОМ lab-box'е (i7-14700K, 8 P-ядер +
# 12 E-ядер) однородного 12-ядерного cpuset'а НЕТ — 8 P-ядер исчерпываются раньше, чем
# набираются 12 однородных. Поэтому CPUSET_* здесь ПУСТЫ (как в S0) — M гоняется на этом
# хосте только как класс A, с обязательной пометкой «латентность недостоверна»
# (reference-env.md §3/§4.2, open-questions.md Q4). Смешивать M-cpuset с гетерогенными
# P+E-ядрами запрещено (Code Guidance §8.5 плана: анти-самообман). Память/pm/PG — числа
# §1.1/§1.2/§1.3/§1.4 остаются валидны сами по себе (это лимиты cgroup, не зависят от
# ядерной раскладки) — их можно снять честно, только латентность на них не авторитетна.
TIER=M

CPUSET_APP=
CPUSET_PG=
CPUSET_PGBOUNCER=
CPUSET_MINIO=
CPUSET_K6=

MEM_APP=6g
MEMSWAP_APP=6g
PM_MAX_CHILDREN=32
PHP_MEMORY_LIMIT=512M

MEM_PG=16g
MEMSWAP_PG=16g
PG_SHARED_BUFFERS=4GB
PG_EFFECTIVE_CACHE_SIZE=12GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=1GB
PG_MAX_CONNECTIONS=64
PG_MAX_PARALLEL_WORKERS_PER_GATHER=2
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200
PG_CHECKPOINT_TIMEOUT=15min
PG_MAX_WAL_SIZE=16GB
PG_AUTOVACUUM_VACUUM_SCALE_FACTOR_ACTIVITY=0.01

MEM_PGBOUNCER=512m
MEMSWAP_PGBOUNCER=512m
PGBOUNCER_DEFAULT_POOL_SIZE=24
PGBOUNCER_MAX_CLIENT_CONN=800
PGBOUNCER_RESERVE_POOL_SIZE=4
PGBOUNCER_RESERVE_POOL_TIMEOUT=3

MEM_MINIO=1536m
MEMSWAP_MINIO=1536m

MEM_K6=4g
MEMSWAP_K6=4g

# Объёмный конверт (P2.3) — reference-env.md §2.1.
SEED_NODES=2000000
SEED_ACTIVITY=50000000
SEED_EXPIRED_SESSIONS=200000
SEED_ORPHAN_BLOBS=150000
MAX_FIXTURE_BYTES=5368709120
