{
    "scope": [
        "Vaulter\\Models\\Drive\\",
        "Vaulter\\Repositories\\Drive\\",
        "Vaulter\\Contracts\\Drive\\",
        "Vaulter\\Contracts\\Handlers\\",
        "Vaulter\\Contracts\\Presentation\\",
        "Vaulter\\Contracts\\Profiles\\",
        "Vaulter\\Contracts\\Activity\\",
        "Vaulter\\Handlers\\",
        "Vaulter\\Profiles\\",
        "Vaulter\\Naming\\",
        "Vaulter\\Quota\\",
        "Vaulter\\Queries\\",
        "Vaulter\\Activity\\",
        "Vaulter\\Changes\\",
        "Vaulter\\Models\\Activity\\",
        "Vaulter\\Repositories\\Activity\\",
        "Vaulter\\Repositories\\Changes\\",
        "Vaulter\\Http\\Controllers\\Activity\\",
        "Vaulter\\Http\\Controllers\\Changes\\",
        "Vaulter\\Data\\Activity\\",
        "Vaulter\\Data\\Changes\\",
        "Vaulter\\Data\\Drive\\",
        "Vaulter\\Data\\Snapshots\\",
        "Vaulter\\Enums\\Changes\\",
        "Vaulter\\Enums\\Drive\\",
        "Vaulter\\Enums\\Handlers\\",
        "Vaulter\\Enums\\Operations\\",
        "Vaulter\\Exceptions\\Changes\\",
        "Vaulter\\Exceptions\\Drive\\",
        "Vaulter\\Exceptions\\Files\\",
        "Vaulter\\Exceptions\\Nodes\\",
        "Vaulter\\Exceptions\\Profiles\\",
        "Vaulter\\ValueObjects\\Handlers\\",
        "Vaulter\\Operations\\ActivityOperations",
        "Vaulter\\Operations\\ChangeOperations",
        "Vaulter\\Operations\\DriveContext",
        "Vaulter\\Operations\\NodeLocator",
        "Vaulter\\Operations\\NodeSequence",
        "Vaulter\\Concerns\\HasDrives",
        "Vaulter\\Support\\DriveLifecycle",
        "Vaulter\\Support\\DriveNameRules",
        "Vaulter\\Support\\NodeName",
        "Vaulter\\Support\\TreeGuard",
        "Vaulter\\Console\\PruneChangesCommand",
        "Vaulter\\Console\\ResetChangesCommand",
        "Vaulter\\Console\\MakeFileHandlerCommand",
        "Vaulter\\Console\\MakeProfileCommand",
        "Vaulter\\VaulterManager",
        "Vaulter\\Facades\\"
    ],
    "rules": [
        {
            "match": "fqcn",
            "value": "Vaulter\\Data\\Snapshots\\Mapping\\SnapshotValue",
            "owner": "core",
            "action": "keep",
            "phase": "stay",
            "note": "generic base of snapshot mappers; drive mappers depend on it (kernel -> no domain knowledge)",
            "why": "architecture#kernel: Снимки — base rules of snapshot mappers stay in the kernel; SnapshotValue is the generic scalar/time/id conversion shared by the mappers"
        },
        {
            "match": "fqcn",
            "value": "Vaulter\\Exceptions\\Nodes\\SequenceOverflowException",
            "owner": "core",
            "action": "keep",
            "phase": "stay",
            "note": "thrown by the core Int64Counter (node sequence, state version, epoch)",
            "why": "architecture#kernel: Идентичность — the generic BIGINT counter contract (Int64Counter) stays in core and throws it"
        },
        {
            "match": "fqcn",
            "value": "Vaulter\\VaulterManager",
            "owner": "drive",
            "action": "replace",
            "phase": "P4",
            "target": "Vaulter\\Drive\\Vaulter",
            "note": "replaced by Vaulter\\Drive\\Vaulter (#[Api], final); withoutTenancy moves to core Tenancy::without",
            "why": "architecture#entry-point: VaulterManager moves to drive as the typed Vaulter\\Drive\\Vaulter (D10)"
        },
        {
            "match": "fqcn",
            "value": "Vaulter\\Facades\\Vaulter",
            "owner": "drive",
            "action": "replace",
            "phase": "P4",
            "target": "Vaulter\\Drive\\Facades\\Vaulter",
            "note": "replaced by Vaulter\\Drive\\Facades\\Vaulter; the Laravel alias Vaulter is declared by drive",
            "why": "architecture#entry-point: the facade moves to drive; the old FQCN is deleted without class_alias (D21)"
        }
    ]
}
