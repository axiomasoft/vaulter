{
    "roots": [
        "packages/collaboration/src",
        "packages/collaboration/routes",
        "packages/collaboration/config",
        "packages/collaboration/database",
        "packages/collaboration/resources"
    ],
    "dynamic": [
        {
            "consumer": "packages/collaboration/src/Providers/CollaborationRegistrar.php",
            "target": "config"
        },
        {
            "consumer": "packages/collaboration/src/Providers/CollaborationRegistrar.php",
            "target": "vaulter.config_validator.collaboration"
        },
        {
            "consumer": "packages/collaboration/src/Providers/CollaborationRegistrar.php",
            "target": "vaulter.config_validators"
        },
        {
            "consumer": "packages/collaboration/src/HostUserResolver.php",
            "target": "new $model as Illuminate\\Database\\Eloquent\\Model"
        }
    ]
}
