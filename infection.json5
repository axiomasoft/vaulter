{
  "$schema": "vendor/infection/infection/resources/schema.json",
  "source": {
    "directories": ["packages/core/src"]
  },
  "mutators": {
    "@default": true
  },
  // P4.1/F-P4.3-03: gate was fully disabled (minMsi:0 never fails). Local re-baseline
  // was not possible in the executing sandbox (no xdebug/pcov coverage driver, no
  // root/network to install one — see phases/P4.md P4.1 Known Deviations); the CI job
  // (`mutation.yml`) DOES run PHP 8.4 + xdebug, so it is the environment able to
  // measure the real MSI. These are conservative provisional non-zero floors (well
  // below what a mature suite typically scores) so the gate is no longer a no-op;
  // raise to the actual measured MSI/coveredMsi after the first CI run and drop this
  // comment.
  "minMsi": 50,
  "minCoveredMsi": 70
}
