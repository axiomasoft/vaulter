{
    "name": "axiomasoft/vaulter",
    "description": "Vaulter — embeddable file drive and documents for Laravel (core + media + drive + documents).",
    "type": "metapackage",
    "license": "MIT",
    "homepage": "https://github.com/axiomasoft/vaulter",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axiomasoft/vaulter/issues",
        "source": "https://github.com/axiomasoft/vaulter"
    },
    "replace": {
        "axioma-studio/vaulter": "self.version"
    },
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/vaulter-core": "self.version",
        "axiomasoft/vaulter-media": "self.version",
        "axiomasoft/vaulter-drive": "self.version",
        "axiomasoft/vaulter-documents": "self.version"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
