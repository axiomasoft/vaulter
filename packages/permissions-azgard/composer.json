{
    "name": "axioma-studio/vaulter-permissions-azgard",
    "description": "AzGuard/Corex permission bridge for Vaulter — a real AzgardGuard adapter delegating to AzGuard scoped roles and the Corex tenant context, so a host wires its ecosystem authorization into Vaulter's composite ACL with one binding.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "authorization", "permissions", "azguard", "corex", "vaulter"],
    "homepage": "https://github.com/axioma-studio/vaulter",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "axioma-studio/vaulter-core": "*",
        "axioma-studio/azguard-core": "*|dev-fix/coverage-gate as 0.1.99|dev-main as 0.1.99",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "axioma-studio/azguard-context": "*",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Vaulter\\Permissions\\Azgard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Permissions\\Azgard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaulter\\Permissions\\Azgard\\VaulterAzgardServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../../azguard/packages/core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../../azguard/packages/context",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    }
}
