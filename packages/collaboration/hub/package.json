{
  "name": "@vaulter/collaboration-hub",
  "version": "0.1.0",
  "description": "Vaulter collaboration hub: real-time server (Hocuspocus + Yjs). Loads, seeds and stores document state through the Laravel backend behind its epoch fence.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node --check src/index.js && node --check src/config.js && node --check src/webhook.js && node --check src/schema.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e/restore-epoch.e2e.js"
  },
  "dependencies": {
    "@hocuspocus/extension-logger": "^4.3",
    "@hocuspocus/extension-redis": "^4.3",
    "@hocuspocus/extension-throttle": "^4.3",
    "@hocuspocus/provider": "^4.3",
    "@hocuspocus/server": "^4.3",
    "@hocuspocus/transformer": "^4.3",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.11.1",
    "y-prosemirror": "^1.3.0",
    "yjs": "^13.6.8"
  },
  "devDependencies": {
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=22"
  }
}
