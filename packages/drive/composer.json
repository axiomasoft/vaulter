{
    "name": "axiomasoft/vaulter-drive",
    "description": "Drive behaviour for Vaulter — file/folder tree operations, storage manager and resumable uploads over the vaulter-core kernel and the vaulter-media CAS engine.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "drive", "file-manager", "uploads", "tus", "s3-multipart", "vaulter"],
    "homepage": "https://github.com/axiomasoft/vaulter",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axiomasoft/vaulter/issues",
        "source": "https://github.com/axiomasoft/vaulter"
    },
    "replace": {
        "axioma-studio/vaulter-drive": "self.version"
    },
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-plugins": "^0.1",
        "axiomasoft/packman-schema": "^0.1",
        "axiomasoft/vaulter-core": "self.version",
        "axiomasoft/vaulter-media": "self.version",
        "staudenmeir/laravel-adjacency-list": "^1.0"
    },
    "require-dev": {
        "axiomasoft/packman-testkit": "^0.1",
        "opis/json-schema": "^2.4",
        "symfony/yaml": "^8.0",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.2.16 <2.3.6",
        "spatie/laravel-permission": "^8.0"
    },
    "suggest": {
        "spatie/laravel-permission": "Required only when using the 'spatie' host-role driver (^8.0)."
    },
    "autoload": {
        "psr-4": {
            "Vaulter\\Drive\\": "src/",
            "Vaulter\\Drive\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Drive\\Tests\\": "tests/"
        }
    },
    "extra": {
        "packman": {
            "schema-version": 1,
            "package-type": "domain",
            "stability": "stable",
            "error-prefix": "drive",
            "owns": [
                "Access",
                "Actions",
                "Activity",
                "Changes",
                "Concerns",
                "Configuration",
                "Console",
                "Content",
                "Contracts",
                "Data",
                "Doctor",
                "Enums",
                "Errors",
                "Events",
                "Exceptions",
                "Facades",
                "Handlers",
                "Http",
                "Idempotency",
                "Jobs",
                "Models",
                "Naming",
                "Operations",
                "Policies",
                "Profiles",
                "Providers",
                "Queries",
                "Quota",
                "Repositories",
                "Rules",
                "Schema",
                "Security",
                "Sharing",
                "Support",
                "Tenancy",
                "Testing",
                "Uploads",
                "ValueObjects"
            ]
        },
        "laravel": {
            "providers": [
                "Vaulter\\Drive\\VaulterDriveServiceProvider"
            ],
            "aliases": {
                "Vaulter": "Vaulter\\Drive\\Facades\\Vaulter"
            }
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../../packman/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman": "0.1.x-dev",
                    "axiomasoft/packman-plugins": "0.1.x-dev",
                    "axiomasoft/packman-schema": "0.1.x-dev",
                    "axiomasoft/packman-testkit": "0.1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../media",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "../../scripts/t sqlite -p drive",
        "test:types": "vendor/bin/pest --type-coverage --min=100",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    }
}
