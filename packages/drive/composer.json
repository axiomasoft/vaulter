{
    "name": "axioma-studio/vaulter-drive",
    "description": "Drive behaviour for Vaulter — file/folder tree operations, storage manager and resumable uploads over the vaulter-core kernel and the vaulter-media CAS engine.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "drive", "file-manager", "uploads", "tus", "s3-multipart", "vaulter"],
    "homepage": "https://github.com/axioma-studio/vaulter",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axioma-studio/vaulter/issues",
        "source": "https://github.com/axioma-studio/vaulter"
    },
    "require": {
        "php": "^8.4",
        "axioma-studio/vaulter-core": "self.version",
        "axioma-studio/vaulter-media": "self.version",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "infection/infection": "^0.33",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Vaulter\\Drive\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Drive\\Tests\\": "tests/",
            "Vaulter\\Tests\\": "../core/tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaulter\\Drive\\VaulterDriveServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../media",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:types": "vendor/bin/pest --type-coverage --min=100",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "mutate": "vendor/bin/infection --threads=4"
    }
}
