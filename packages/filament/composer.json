{
    "name": "axioma-studio/docvault-filament",
    "description": "Filament 5 admin panel for DocVault — manage documents, folders, share links and comments.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "filament", "documents", "admin", "docvault"],
    "homepage": "https://github.com/axioma-studio/doc-vault",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "axioma-studio/docvault-core": "*",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "DocVault\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DocVault\\Filament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DocVault\\Filament\\DocVaultFilamentServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    }
}
