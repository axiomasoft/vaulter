{
    "name": "axioma-studio/vaulter-filament",
    "description": "Filament 5 admin panel for Vaulter — manage documents, folders, share links and comments.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "filament", "documents", "admin", "vaulter"],
    "homepage": "https://github.com/axiomasoft/vaulter",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axiomasoft/vaulter/issues",
        "source": "https://github.com/axiomasoft/vaulter"
    },
    "require": {
        "php": "^8.4",
        "axioma-studio/vaulter-core": "self.version",
        "axioma-studio/vaulter-drive": "self.version",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "axioma-studio/vaulter-media": "self.version",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/phpstan": "^2.0 <2.3.6",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Vaulter\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Filament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaulter\\Filament\\VaulterFilamentServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../drive",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../media",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "../../scripts/t sqlite -p filament",
        "test:types": "vendor/bin/pest --type-coverage --min=100",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "refactor:check": "vendor/bin/rector process --dry-run"
    }
}
