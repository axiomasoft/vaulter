{
  "name": "@docvault/vue",
  "version": "0.0.1",
  "description": "Vue 3 + TypeScript components, composables and API client for DocVault.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/docvault-vue.umd.cjs",
  "module": "./dist/docvault-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/docvault-vue.js",
      "require": "./dist/docvault-vue.umd.cjs"
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.4"
  },
  "dependencies": {
    "@hocuspocus/provider": "^2.13",
    "@tiptap/pm": "^2.10",
    "@tiptap/starter-kit": "^2.10",
    "@tiptap/vue-3": "^2.10",
    "yjs": "^13.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}
