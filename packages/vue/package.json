{
  "name": "@vaulter/vue",
  "version": "1.0.0",
  "description": "Vue 3 + TypeScript components, composables and API client for Vaulter.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "vaulter": {
    "api": "1"
  },
  "keywords": [
    "vue",
    "tiptap",
    "collaboration",
    "documents",
    "file-manager",
    "vaulter"
  ],
  "homepage": "https://github.com/axiomasoft/vaulter#readme",
  "bugs": "https://github.com/axiomasoft/vaulter/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axiomasoft/vaulter.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/vaulter-vue.umd.cjs",
  "module": "./dist/vaulter-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vaulter-vue.js",
      "require": "./dist/vaulter-vue.umd.cjs"
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "api:generate": "openapi-typescript ../../openapi/vaulter-v1.yaml -o src/api/schema.d.ts",
    "api:check": "node scripts/api-check.mjs",
    "test": "vitest run",
    "api:surface:check": "node ../../scripts/release/npm-surface.mjs vue",
    "api:surface:update": "node ../../scripts/release/npm-surface.mjs vue --update"
  },
  "peerDependencies": {
    "vue": "^3.4",
    "@tiptap/pm": "^3.0.0"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/vue-3": "^3.0.0"
  },
  "devDependencies": {
    "@testing-library/vue": "8.1.0",
    "@tiptap/pm": "^3.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.10.6",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}
