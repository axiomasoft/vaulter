{
    "name": "axioma-studio/vaulter-media",
    "description": "Content-addressed file/blob layer (CAS) for Vaulter — sha256 dedup, race-free commit, two-phase GC over Flysystem.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "cas", "content-addressed", "blob", "storage", "dedup", "vaulter"],
    "homepage": "https://github.com/axiomasoft/vaulter",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axiomasoft/vaulter/issues",
        "source": "https://github.com/axiomasoft/vaulter"
    },
    "require": {
        "php": "^8.4",
        "axioma-studio/vaulter-core": "self.version",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Vaulter\\Media\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Media\\Tests\\": "tests/",
            "Vaulter\\Drive\\": "../drive/src/",
            "Vaulter\\Drive\\Database\\Factories\\": "../drive/database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaulter\\Media\\VaulterMediaServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "../../scripts/t sqlite -p media",
        "test:types": "vendor/bin/pest --type-coverage --min=100",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "mutate": "vendor/bin/pest --mutate --path=src --covered-only --clear-cache --min=95"
    }
}
