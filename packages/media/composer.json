{
    "name": "axiomasoft/vaulter-media",
    "description": "Content-addressed file/blob layer (CAS) for Vaulter — sha256 dedup, race-free commit, two-phase GC over Flysystem.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "cas", "content-addressed", "blob", "storage", "dedup", "vaulter"],
    "homepage": "https://github.com/axiomasoft/vaulter",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axiomasoft/vaulter/issues",
        "source": "https://github.com/axiomasoft/vaulter"
    },
    "replace": {
        "axioma-studio/vaulter-media": "self.version"
    },
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/vaulter-core": "self.version"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.2.16 <2.3.6"
    },
    "autoload": {
        "psr-4": {
            "Vaulter\\Media\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Media\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaulter\\Media\\VaulterMediaServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "../../scripts/t sqlite -p media",
        "test:types": "vendor/bin/pest --type-coverage --min=100",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    }
}
