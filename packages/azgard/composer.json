{
    "name": "axioma-studio/vaulter-azgard",
    "description": "AzGuard permission bridge for Vaulter — a real AzgardGuard adapter delegating to AzGuard v1 panel checks on resources and assignment scopes, so a host wires its ecosystem authorization into Vaulter's composite ACL with one binding.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "authorization", "permissions", "azguard", "corex", "vaulter"],
    "homepage": "https://github.com/axiomasoft/vaulter",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axiomasoft/vaulter/issues",
        "source": "https://github.com/axiomasoft/vaulter"
    },
    "require": {
        "php": "^8.4",
        "axioma-studio/vaulter-core": "self.version",
        "axiomasoft/azguard": "^1.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Vaulter\\Azgard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Azgard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaulter\\Azgard\\VaulterAzgardServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../../azguard/packages/core",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    }
}
