{
    "name": "axiomasoft/vaulter-webhooks",
    "description": "Webhooks for Vaulter — signed outbound deliveries of drive events, endpoint management and retries, an outbox consumer over the vaulter-core kernel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "webhooks",
        "outbox",
        "events",
        "vaulter"
    ],
    "homepage": "https://github.com/axiomasoft/vaulter",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axiomasoft/vaulter/issues",
        "source": "https://github.com/axiomasoft/vaulter"
    },
    "replace": {
        "axioma-studio/vaulter-webhooks": "self.version"
    },
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/vaulter-core": "self.version",
        "axiomasoft/vaulter-drive": "self.version"
    },
    "require-dev": {
        "opis/json-schema": "^2.4",
        "symfony/yaml": "^8.0",
        "axiomasoft/vaulter-media": "self.version",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.2.16 <2.3.6"
    },
    "autoload": {
        "psr-4": {
            "Vaulter\\Webhooks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Webhooks\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaulter\\Webhooks\\VaulterWebhooksServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../drive",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../media",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "../../scripts/t sqlite -p webhooks",
        "test:types": "vendor/bin/pest --type-coverage --min=100",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    }
}
