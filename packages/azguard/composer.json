{
    "name": "axiomasoft/vaulter-azguard",
    "description": "AzGuard permission bridge for Vaulter — a real AzGuardGuard adapter delegating to AzGuard 2.x panel checks on resources and assignment scopes, so a host wires its ecosystem authorization into Vaulter's composite ACL with one binding.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "authorization",
        "permissions",
        "azguard",
        "vaulter"
    ],
    "homepage": "https://github.com/axiomasoft/vaulter",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axiomasoft/vaulter/issues",
        "source": "https://github.com/axiomasoft/vaulter"
    },
    "replace": {
        "axioma-studio/vaulter-azguard": "self.version"
    },
    "require": {
        "axiomasoft/azguard": "^2.0@dev",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-plugins": "^0.1",
        "axiomasoft/vaulter-core": "self.version",
        "axiomasoft/vaulter-drive": "self.version",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "php": ">=8.4 <8.6"
    },
    "require-dev": {
        "axiomasoft/vaulter-media": "self.version",
        "larastan/larastan": "^3.15.0",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "Vaulter\\AzGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\AzGuard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaulter\\AzGuard\\VaulterAzGuardServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "packman": {
            "schema-version": 1,
            "package-type": "integration",
            "stability": "stable",
            "owns": [
                "Configuration",
                "Contracts",
                "Doctor",
                "Providers",
                "Testing"
            ],
            "error-prefix": "azguard"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../drive",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../media",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../../azguard/packages/core",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "../../scripts/t sqlite -p azguard",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    }
}
