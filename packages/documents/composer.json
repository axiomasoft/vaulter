{
    "name": "axiomasoft/vaulter-documents",
    "description": "Structured documents for Vaulter: document types and codecs, revisions, comments, export and a protocol-neutral collaboration SPI.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "documents", "tiptap", "versioning", "editor", "vaulter"],
    "homepage": "https://github.com/axiomasoft/vaulter",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axiomasoft/vaulter/issues",
        "source": "https://github.com/axiomasoft/vaulter"
    },
    "replace": {
        "axioma-studio/vaulter-documents": "self.version"
    },
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-plugins": "^0.1",
        "axiomasoft/packman-schema": "^0.1",
        "axiomasoft/vaulter-core": "self.version",
        "axiomasoft/vaulter-drive": "self.version",
        "symfony/html-sanitizer": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "axiomasoft/packman-testkit": "^0.1",
        "opis/json-schema": "^2.4",
        "symfony/yaml": "^8.0",
        "axiomasoft/vaulter-media": "self.version",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "laravel/sanctum": "^4.0",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.2.16 <2.3.6",
        "spatie/laravel-permission": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Vaulter\\Documents\\": "src/",
            "Vaulter\\Documents\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Documents\\Tests\\": "tests/"
        }
    },
    "extra": {
        "packman": {
            "schema-version": 1,
            "package-type": "addon",
            "stability": "stable",
            "error-prefix": "documents",
            "owns": [
                "Access",
                "Actions",
                "Casts",
                "Configuration",
                "Console",
                "Content",
                "Contracts",
                "Data",
                "Doctor",
                "Enums",
                "Errors",
                "Events",
                "Exceptions",
                "Export",
                "Facades",
                "Http",
                "Idempotency",
                "Models",
                "Operations",
                "Presentation",
                "Profiles",
                "Providers",
                "Queries",
                "Repositories",
                "Rules",
                "Schema",
                "State",
                "Support",
                "Testing",
                "Types",
                "ValueObjects"
            ]
        },
        "laravel": {
            "providers": [
                "Vaulter\\Documents\\VaulterDocumentsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../../packman/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman": "0.1.x-dev",
                    "axiomasoft/packman-plugins": "0.1.x-dev",
                    "axiomasoft/packman-schema": "0.1.x-dev",
                    "axiomasoft/packman-testkit": "0.1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../drive",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../media",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "../../scripts/t sqlite -p documents",
        "test:types": "vendor/bin/pest --type-coverage --min=100",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    }
}
