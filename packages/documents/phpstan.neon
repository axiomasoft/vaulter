includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max

    paths:
        - src

    inferPrivatePropertyTypeFromConstructor: true
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Eloquent dynamic builder/property magic that Larastan cannot fully model
        # (mirrors the core analysis config — the documents actions/repositories query
        # the swappable Node/NodeComment/NodeDocumentVersion models via the generic
        # Eloquent builder).
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder#'
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model#'

        # Shipped for host test suites: the trait is consumed by Pest `uses()` in the
        # host's own tests, never inside this package's src.
        -
            identifier: trait.unused
            path: src/Testing/Contracts/DocumentTypeContractTests.php
