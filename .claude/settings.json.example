{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \<ABS_PATH_TO_PROJECT\>/maind-memory.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/run-report/run-report.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \<ABS_PATH_TO_PROJECT\>/maind-feature-log.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/review-gate.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-approve/auto-approve.sh"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-approve/auto-approve.sh"
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": false,
  "plansDirectory": "plans"
}
