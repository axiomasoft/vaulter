+
+declare(strict_types=1);
+
+namespace Vaulter\Exceptions\Profiles;
+
+use Vaulter\Exceptions\Contracts\ProblemException;
+use Vaulter\Exceptions\VaulterException;
+
+final class ProfileRestrictionException extends VaulterException implements ProblemException
+{
+    public static function forOperation(string $operation): self
+    {
+        return new self('[Vaulter] The profile does not allow ['.$operation.']. Why: the effective profile restricts this operation. Fix: use an operation enabled by the drive profile. Docs: '.self::docs('profile-restriction'));
+    }
+
+    public function problemCode(): string
+    {
+        return 'profile_restriction';
+    }
+
+    public function httpStatus(): int
+    {
+        return 403;
+    }
+}
diff --git a/packages/core/src/Operations/NodeLocator.php b/packages/core/src/Operations/NodeLocator.php
new file mode 100644
index 00000000..57a1f89e
--- /dev/null
+++ b/packages/core/src/Operations/NodeLocator.php
@@ -0,0 +1,84 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Vaulter\Operations;
+
+use Illuminate\Database\Eloquent\Builder;
+use Vaulter\Configuration\VaulterConfig;
+use Vaulter\Database\VaulterDatabase;
+use Vaulter\Exceptions\Nodes\NodeNotFoundException;
+use Vaulter\Models\Drive\Node;
+
+final readonly class NodeLocator
+{
+    public function __construct(
+        private VaulterConfig $config,
+        private VaulterDatabase $database,
+    ) {}
+
+    public function find(OperationContext $context, Node|int|string $key, bool $includeTrashed = false): Node
+    {
+        $id = $this->key($key);
+        if ($id === null) {
+            throw NodeNotFoundException::forId('unpersisted');
+        }
+        $query = $this->query($context);
+        if ($includeTrashed) {
+            $query->withTrashed();
+        }
+        $node = $query->whereKey($id)->first();
+
+        return $node ?? throw NodeNotFoundException::forId($id);
+    }
+
+    /**
+     * @internal Rebind untrusted listing candidates in one scoped query.
+     *
+     * @param  iterable<Node> $nodes
+     * @return list<Node>
+     */
+    public function findMany(OperationContext $context, iterable $nodes): array
+    {
+        $keys = [];
+        foreach ($nodes as $node) {
+            $key = $this->key($node);
+            if ($key !== null) {
+                $keys[] = $key;
+            }
+        }
+        if ($keys === []) {
+            return [];
+        }
+        $found = $this->query($context)->whereKey($keys)->get()->keyBy(fn (Node $node): string => (string) $node->id);
+        $result = [];
+        foreach ($keys as $key) {
+            $node = $found->get((string) $key);
+            if ($node !== null) {
+                $result[] = $node;
+            }
+        }
+
+        return $result;
+    }
+
+    /** @return Builder<Node> */
+    private function query(OperationContext $context): Builder
+    {
+        $class = $this->config->model('node');
+        $model = new $class;
+        $model->setConnection($this->database->connection()->getName());
+
+        return $model->newQuery()->where(column: 'drive_id', operator: '=', value: $context->driveId());
+    }
+
+    private function key(Node|int|string $key): int|string|null
+    {
+        if (!$key instanceof Node) {
+            return $key === '' ? null : $key;
+        }
+        $id = $key->getRawOriginal($key->getKeyName());
+
+        return $key->exists && (is_int($id) || is_string($id)) && $id !== '' ? $id : null;
+    }
+}
