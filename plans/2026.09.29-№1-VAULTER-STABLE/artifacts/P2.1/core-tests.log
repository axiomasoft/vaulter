n+Vaulter\\Schema\\VaulterSchema\n   actor(\\Illuminate\\Database\\Schema\\Blueprint $table, string $column, bool $nullable = true): void\n   bits(\\Illuminate\\Database\\Schema\\Blueprint $table, string $column, int $default = 0): void\n   extraData(\\Illuminate\\Database\\Schema\\Blueprint $table): void\n@@ @@\n   tenant(\\Illuminate\\Database\\Schema\\Blueprint $table): void\n \n Vaulter\\Http\\Support\\HttpResourceResolver\n-  __construct(\\Vaulter\\Repositories\\Drive\\StorageReadRepository $storages, \\Vaulter\\Repositories\\Drive\\NodeReadRepository $nodes)\n+  __construct(\\Vaulter\\Repositories\\Drive\\DriveReadRepository $storages, \\Vaulter\\Repositories\\Drive\\NodeReadRepository $nodes)\n   node(int|string $id): \\Vaulter\\Models\\Drive\\Node\n-  storage(int|string $id): \\Vaulter\\Models\\Drive\\Storage\n+  storage(int|string $id): \\Vaulter\\Models\\Drive\\Drive\n \n Vaulter\\Exceptions\\Contracts\\ProblemException\n   httpStatus(): int\n@@ @@\n   render(\\Illuminate\\Http\\Request $request): \\Illuminate\\Http\\JsonResponse|false\n \n FACADE Vaulter\\Facades\\Vaulter\n-  static \\Vaulter\\Contracts\\Drive\\DriveHandle for(\\Illuminate\\Database\\Eloquent\\Model $entity, ?string $panel = null)\n-  static \\Vaulter\\Contracts\\Drive\\DriveHandle forStorage(\\Vaulter\\Models\\Drive\\Storage $storage)\n-  static \\Vaulter\\Contracts\\Handlers\\DocumentExporter exporter(string $format)\n-  static \\Vaulter\\Contracts\\Handlers\\HandlerRegistry handlers()\n-  static \\Vaulter\\Panels\\Panel panel(string $name = 'default')\n-  static \\Vaulter\\Panels\\PanelRegistry panels()\n+  static DocumentExporter exporter(string $format)\n+  static DriveHandle for(Model $entity, ?string $panel = null)\n+  static DriveHandle forStorage(Drive $storage)\n+  static FileHandlerRegistry handlers()\n+  static \\Vaulter\\Profiles\\ProfileRegistry profiles()\n   static array<string, array<string, mixed>> documentTypes()\n   static list<string> exporterFormats()\n   static void registerDocumentType(string $type, array<string, mixed> $definition)\n-  static void registerExporter(\\Vaulter\\Contracts\\Handlers\\DocumentExporter|class-string<\\Vaulter\\Contracts\\Handlers\\DocumentExporter> $exporter)\n-  static void registerHandler(\\Vaulter\\Contracts\\Handlers\\FileHandler|class-string<\\Vaulter\\Contracts\\Handlers\\FileHandler> $handler)\n-  static void registerPanel(\\Vaulter\\Panels\\StoragePanelProvider|\\Vaulter\\Panels\\Panel $panel)\n+  static void registerExporter(DocumentExporter|class-string<DocumentExporter> $exporter)\n \n Vaulter\\Events\\Access\\NodeGrantCreated\n   __construct(\\Vaulter\\Models\\Access\\NodeGrant $grant, int|null|string $actorId = null, ?string $eventId = null)"},{"test":"P\\Packages\\core\\tests\\IdStrategy\\Bigint\\DriveMigrationsBigintTest::__pest_evaluable_it_\u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442_\u0431\u0430\u0437\u043e\u0432\u044b\u0435_Drive_\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0438_\u043f\u043e\u0434_bigint_\u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0435\u0439","file":"/home/vostrikov/projects/packages/vaulter/packages/core/tests/Schema/DriveSchemaAssertions.php","line":74,"message":"table v_storages should carry all M1a columns\nFailed asserting that false is true."},{"test":"P\\Packages\\core\\tests\\IdStrategy\\Ulid\\DriveMigrationsUlidTest::__pest_evaluable_it_\u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442_\u0431\u0430\u0437\u043e\u0432\u044b\u0435_Drive_\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0438_\u043f\u043e\u0434_ulid_\u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0435\u0439","file":"/home/vostrikov/projects/packages/vaulter/packages/core/tests/Schema/DriveSchemaAssertions.php","line":74,"message":"table v_storages should carry all M1a columns\nFailed asserting that false is true."},{"test":"P\\Packages\\core\\tests\\IdStrategy\\Uuid7\\DriveMigrationsUuid7Test::__pest_evaluable_it_\u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442_\u0431\u0430\u0437\u043e\u0432\u044b\u0435_Drive_\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0438_\u043f\u043e\u0434_uuid7_\u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0435\u0439","file":"/home/vostrikov/projects/packages/vaulter/packages/core/tests/Schema/DriveSchemaAssertions.php","line":74,"message":"table v_storages should carry all M1a columns\nFailed asserting that false is true."},{"test":"P\\Packages\\core\\tests\\Schema\\NodeGrantSchemaTest::__pest_evaluable_it_creates_the_v__node__grants_table_with_every_column","file":"/home/vostrikov/projects/packages/vaulter/packages/core/tests/Schema/NodeGrantSchemaTest.php","line":25,"message":"Failed asserting that false is true."},{"test":"P\\Packages\\core\\tests\\Support\\DocsDriftGuardTest::__pest_evaluable_it_documents_all_7_previously_undocumented_public_contracts_in_contracts_md__F_P2_1_03","file":"/home/vostrikov/projects/packages/vaulter/packages/core/tests/Support/DocsDriftGuardTest.php","line":118,"message":"Failed asserting that '---\\n\ntitle: Contracts\\n\ndescription: Every Vaulter\\Contracts interface by domain \u2014 method signatures and when to implement.\\n\noutline: deep\\n\n---\\n\n\\n\n# Contracts\\n\n\\n\nVaulter's variance seams live under the `Vaulter\\Contracts\\*` namespace. Each is a\\n\nSemVer-frozen public interface you can implement to swap a behaviour \u2014 authorization,\\n\nstorage, collaboration transport, document formats, sharing tokens, id strategy, or\\n\nupload protocols. This page lists every contract by domain with its exact method\\n\nsignatures and the binding point you swap it through.\\n\n\\n\n| Domain | Contract | Swap via |\\n\n|---|---|---|\\n\n| Access | `HostRoleDriver` | `config('vaulter.drivers.permission')` + `permission_drivers` map |\\n\n| Access | `AzgardGuard` | container binding (host adapter) |\\n\n| Access | `AzgardBackedUser` (azgard) | implemented by the host `User` model when `drivers.permission=azgard` |\\n\n| Access | `GrantAuthoritativeDriver` | opt-in capability a `HostRoleDriver` implements |\\n\n| Cas | `BlobStore` | `config('vaulter.cas.blob_store')` |\\n\n| Cas | `ContentStore` | `config('vaulter.cas.content_store')` |\\n\n| Cas | `ListableContentStore` | opt-in capability a `ContentStore` implements |\\n\n| Cas | `ListableStorageDriver` | opt-in capability a `StorageDriver` implements |\\n\n| Cas | `StorageDriver` | `config('vaulter.cas.storage_driver')` |\\n\n| Cas | `StagedObject` | returned by `ContentStore::stage()` |\\n\n| Cas | `StorageAdapter` | `config('vaulter.storage_adapter')` (legacy) |\\n\n| Collaboration | `NodeCollaborationDriver` | container binding (node path) |\\n\n| Collaboration | `HostUserResolver` | container binding |\\n\n| Handlers | `DocumentContent` | returned by a `FileHandler`'s content parser |\\n\n| Handlers | `FileHandler` | `config('vaulter.handlers')` / `Vaulter::registerHandler()` |\\n\n| Handlers | `DocumentExporter` | `config('vaulter.exporters')` / `Vaulter::registerExporter()` |\\n\n| Handlers | `HandlerRegistry` | `Vaulter::handlers()` / `Vaulter::registerHandler()` |\\n\n| Handlers | `NodeHandlerResolver` | container binding (core) |\\n\n| Sharing | `ShareTokenGenerator` | `config('vaulter.share_token_generator')` / `config('vaulter.share.token_generator')` |\\n\n| Uploads | `UploadProtocolHandler` | bundled (tus / S3-multipart) |\\n\n| \u2014 | `IdStrategy` | `config('vaulter.ids.strategies')` |\\n\n\\n\n---\\n\n\\n\n## Access\\n\n\\n\n### `Vaulter\\Contracts\\Access\\HostRoleDriver`\\n\n\\n\nThe pluggable, per-panel **role lane** the Vaulter-owned (non-swappable)\\n\n`AccessResolver` combines with the `v_node_grants` ACL. It bridges your identity +\\n\nrole system into Vaulter without leaking Vaulter's domain: it never receives a `Node`\\n\nand never deals in magic-string actions \u2014 only an `Authorizable` actor and an\\n\n`AclScope` (panel + workspace coordinates + node owner). Swap it via\\n\n`config('vaulter.drivers.permission')` against the `permission_drivers` map; the\\n\ndefault is the standalone `DatabasePermissionResolver`.\\n\n\\n\n```php\\n\ninterface HostRoleDriver\\n\n{\\n\n    public function resolve(Subject $subject, Authorizable $actor, AclScope $scope): ?Decision;\\n\n\\n\n    public function override(Authorizable $actor, AclScope $scope): ?Effect;\\n\n\\n\n    /** @return list<Subject> */\\n\n    public function subjectsFor(Authorizable $actor): array;\\n\n\\n\n    public function canCreateInWorkspace(Authorizable $actor, string $workspaceType, int|string $workspaceId): bool;\\n\n}\\n\n```\\n\n\\n\n- `resolve()` \u2014 the host's role decision, or `null` when the host role system has\\n\n  nothing to say. Folded as `roleAllow` into `granted = max(aclAllow, roleAllow)` \u2014\\n\n  it can **raise** access but can never override a deny (the final veto still\\n\n  applies).\\n\n- `override()` \u2014 an absolute host override (super-admin / `Gate::before`):\\n\n  `Effect::Allow` short-circuits to full access, `Effect::Deny` to no access, both\\n\n  before any ACL walk.\\n\n- `subjectsFor()` \u2014 expand an actor into the set of `Subject`s whose grants apply\\n\n  (the user plus its host roles/teams). Vaulter builds\\n\n  `WHERE (subject_type, subject_id) IN (...)` from this list.\\n\n- `canCreateInWorkspace()` \u2014 the folder/upload create gate, where there is no\\n\n  existing node to resolve against.\\n\n\\n\n::: info Frozen from M2a\\n\nEvery bundled driver (`database`, `gate`, `spatie`, `azgard`, `null`) implements\\n\nexactly this surface, and a contract test asserts they all yield identical\\n\n`AccessResolver` decisions on a shared fixture.\\n\n:::\\n\n\\n\n**Implement when** you have a role system the bundled drivers don't cover. See\\n\n[Recipes \u2192 Custom resolver](/guide/recipes).\\n\n\\n\n### `Vaulter\\Contracts\\Access\\AzgardGuard`\\n\n\\n\nThe narrow Vaulter-owned seam the host's AzGuard-backed actor satisfies, so\\n\n`vaulter-core` carries **no** hard dependency on `azguard`/`corex`. The\\n\n`azgard` permission driver talks only to this interface \u2014 never AzGuard's classes.\\n\n\\n\n```php\\n\ninterface AzgardGuard\\n\n{\\n\n    public function hasScopedPermission(string $permission, object $entity): bool;\\n\n\\n\n    public function hasPermissionIn(string $contextType, int|string $contextId, string $permission): bool;\\n\n\\n\n    public function isSuperAdmin(): bool;\\n\n}\\n\n```\\n\n\\n\nMethod shapes mirror AzGuard 1:1, so a host adapter is a thin pass-through to\\n\n`hasScopedPermission` / `hasPermissionIn` / the SuperAdmin wildcard. No real binding\\n\nships by default \u2014 tests bind `Vaulter\\Testing\\FakeAzgardGuard`.\\n\n\\n\n**Implement when** `config('vaulter.drivers.permission') = 'azgard'` \u2014 bind a real\\n\nadapter and align ULID morphs (`vaulter.ids.default=ulid` + `corex.ids.strategy=Ulid`\\n\n+ `AZ_GUARD_MORPH_TYPE=ulid`). See [Auth \u2192 Host role driver](/guide/permission-drivers).\\n\n\\n\n### `Vaulter\\Azgard\\Contracts\\AzgardBackedUser` (azgard)\\n\n\\n\nThe host `User` model contract the `AzgardGuardAdapter` bridges into Vaulter,\\n\ncomposed straight from AzGuard's own public contracts (`HasPermissions` +\\n\n`HasScopedRoles`) \u2014 no re-declared signature to drift out of sync.\\n\n\\n\n```php\\n\ninterface AzgardBackedUser extends HasPermissions, HasScopedRoles {}\\n\n```\\n\n\\n\n**Implement when** `config('vaulter.drivers.permission') = 'azgard'` \u2014 the host\\n\n`User` model satisfies it with no extra method bodies by composing\\n\n`AzGuard\\Concerns\\HasAzGuard` + `AzGuard\\Concerns\\HasScopedRoles`.\\n\n\\n\n### `Vaulter\\Contracts\\Access\\GrantAuthoritativeDriver`\\n\n\\n\nAn opt-in capability a `HostRoleDriver` implements to declare that `v_node_grants` is\\n\nthe sole read-visibility authority for that driver instance, so a listing may safely\\n\nnarrow to the actor's grant-reachable candidate set. Absence is the conservative,\\n\nBC-safe default (the listing stays open, never wrongly hiding a row) \u2014 only the\\n\nbundled `database` driver declares it.\\n\n\\n\n```php\\n\ninterface GrantAuthoritativeDriver\\n\n{\\n\n    public function isGrantAuthoritative(): bool;\\n\n}\\n\n```\\n\n\\n\n**Implement when** your `HostRoleDriver` confers access ONLY through\\n\n`v_node_grants` (no host roles/teams, no workspace-create gate, no super-admin\\n\noverride) \u2014 returning `false` (or not implementing the interface) is always safe.\\n\n\\n\n---\\n\n\\n\n## Cas (content-addressed storage)\\n\n\\n\n### `Vaulter\\Contracts\\Cas\\BlobStore`\\n\n\\n\nThe high-level, race-free CAS blob lifecycle. `commit()` is the single entry point \u2014\\n\nstage \u2192 hash \u2192 find-or-create the blob by its per-scope dedup key inside one locked\\n\ntransaction, resurrecting a tombstoned match and promoting bytes only when the row is\\n\nnewly created. Liveness truth is the edge in `v_file_version_blobs`, not a\\n\nsynchronous `ref_count`. Swap via `config('vaulter.cas.blob_store')`.\\n\n\\n\n```php\\n\ninterface BlobStore\\n\n{\\n\n    /** @param resource $stream */\\n\n    public function commit(mixed $stream, ?int $tenantId = null, ?int $storageId = null, ?string $disk = null): Blob;\\n\n\\n\n    /** @param array{role?: string, ordinal?: int, offset_bytes?: int|null, length_bytes?: int|null} $attributes */\\n\n    public function attach(FileVersion $version, Blob $blob, array $attributes = []): void;\\n\n\\n\n    public function detach(FileVersion $version, Blob $blob, string $role = 'data', int $ordinal = 0): void;\\n\n\\n\n    /** @return resource|null */\\n\n    public function read(Blob $blob): mixed;\\n\n}\\n\n```\\n\n\\n\n### `Vaulter\\Contracts\\Cas\\ContentStore`\\n\n\\n\nThe low-level byte side of the CAS: stage an incoming stream to a local seekable temp\\n\nfile (hashing those durable bytes server-side), then promote the staged bytes to\\n\ntheir canonical scope-qualified key. Knows only bytes, hashes and keys \u2014 never the\\n\n`v_blobs` row. Swap via `config('vaulter.cas.content_store')`.\\n\n\\n\n```php\\n\ninterface ContentStore\\n\n{\\n\n    /** @param resource $stream */\\n\n    public function stage(mixed $stream): StagedObject;\\n\n\\n\n    public function promote(StagedObject $staged, string $key, ?string $disk = null): void;\\n\n\\n\n    /** @return resource|null */\\n\n    public function get(string $key, ?string $disk = null): mixed;\\n\n\\n\n    public function exists(string $key, ?string $disk = null): bool;\\n\n\\n\n    public function delete(string $key, ?string $disk = null): void;\\n\n\\n\n    /** Build the scope-qualified, sharded key \"<scope>/ab/cd/<sha256>\". */\\n\n    public function keyFor(string $scope, string $sha256): string;\\n\n}\\n\n```\\n\n\\n\n### `Vaulter\\Contracts\\Cas\\ListableContentStore`\\n\n\\n\nAn opt-in capability a `ContentStore` implements to declare it can enumerate stored\\n\nobjects and report their age \u2014 the seam the orphan disk-walk (CAS reconciler) uses\\n\nto find bytes with no `v_blobs` row. Absence is the conservative default: the orphan\\n\nwalk refuses cleanly (skipped, never a fatal error) instead of erroring.\\n\n\\n\n```php\\n\ninterface ListableContentStore\\n\n{\\n\n    public function lastModified(string $key, ?string $disk = null): ?int;\\n\n\\n\n    /** @return iterable<string> */\\n\n    public function listKeys(?string $disk = null): iterable;\\n\n}\\n\n```\\n\n\\n\n**Implement when** your `ContentStore` should participate in orphan reconciliation.\\n\n\\n\n### `Vaulter\\Contracts\\Cas\\StagedObject`\\n\n\\n\nThe result of staging an upload to a local, seekable temp file. The sha256 is\\n\nrecomputed from these durable bytes \u2014 never the live stream, a client hash, or an S3\\n\nmultipart ETag. Read-only and self-cleaning. Returned by `ContentStore::stage()`.\\n\n\\n\n```php\\n\ninterface StagedObject\\n\n{\\n\n    public function path(): string;\\n\n\\n\n    public function sha256(): string;\\n\n\\n\n    public function sizeBytes(): int;\\n\n\\n\n    /** @return resource */\\n\n    public function readStream(): mixed;\\n\n\\n\n    public function discard(): void;\\n\n}\\n\n```\\n\n\\n\n### `Vaulter\\Contracts\\Cas\\StorageDriver`\\n\n\\n\nA thin abstraction over a Flysystem disk \u2014 the byte plane under the CAS. Swap to add\\n\nobject-store specifics (`x-amz-checksum-sha256`, `If-None-Match: *`) while keeping\\n\nthe local/sqlite test disk working. Swap via `config('vaulter.cas.storage_driver')`.\\n\n\\n\n```php\\n\ninterface StorageDriver\\n\n{\\n\n    public function disk(?string $disk = null): Filesystem;\\n\n\\n\n    /**\\n\n     * @param resource             $stream\\n\n     * @param array<string, mixed> $options\\n\n     */\\n\n    public function put(string $key, mixed $stream, ?string $disk = null, bool $ifNoneMatch = false, array $options = []): bool;\\n\n\\n\n    /** @return resource|null */\\n\n    public function get(string $key, ?string $disk = null): mixed;\\n\n\\n\n    public function exists(string $key, ?string $disk = null): bool;\\n\n\\n\n    public function delete(string $key, ?string $disk = null): void;\\n\n\\n\n    public function temporaryUrl(string $key, \\DateTimeInterface $expiresAt, ?string $disk = null): ?string;\\n\n}\\n\n```\\n\n\\n\nWhen `$ifNoneMatch` is true the driver attempts a conditional create; a 412/409 means\\n\nwe were overtaken and must re-SELECT + reuse \u2014 surfaced as `put()` returning `false`,\\n\nnot an exception. On a local disk the condition degrades to a best-effort `exists()`\\n\nguard.\\n\n\\n\n### `Vaulter\\Contracts\\Cas\\ListableStorageDriver`\\n\n\\n\nAn opt-in capability a `StorageDriver` implements to declare it can enumerate the\\n\ndisk and report object age \u2014 the seam the orphan disk-walk (CAS reconciler) uses to\\n\nfind bytes with no `v_blobs` row. Absence is the conservative default: the driver is\\n\nreported as non-listable and skipped, never a fatal error.\\n\n\\n\n```php\\n\ninterface ListableStorageDriver\\n\n{\\n\n    public function lastModified(string $key, ?string $disk = null): ?int;\\n\n\\n\n    /** @return iterable<string> */\\n\n    public function listContents(?string $disk = null): iterable;\\n\n}\\n\n```\\n\n\\n\n**Implement when** your `StorageDriver` should participate in orphan reconciliation.\\n\nThe bundled Flysystem storage driver implements it out of the box.\\n\n\\n\n### `Vaulter\\Contracts\\Cas\\StorageAdapter` (legacy)\\n\n\\n\nPluggable storage for **legacy** binary attachments. Vaulter itself stores JSON\\n\ncontent; binary files in the legacy document path are delegated here. Swap via\\n\n`config('vaulter.storage_adapter')`.\\n\n\\n\n```php\\n\ninterface StorageAdapter\\n\n{\\n\n    /** @param string|resource $contents */\\n\n    public function store(string $filename, mixed $contents): string;\\n\n\\n\n    public function delete(string $url): void;\\n\n\\n\n    public function url(string $path): string;\\n\n}\\n\n```\\n\n\\n\n::: tip Which CAS contract do I implement?\\n\nFor a custom byte backend (S3 / local), implement `StorageDriver` and bind it \u2014 the\\n\n`ContentStore` and `BlobStore` stay as-is. See\\n\n[Recipes \u2192 Storage driver](/guide/recipes).\\n\n:::\\n\n\\n\n---\\n\n\\n\n## Collaboration\\n\n\\n\n### `Vaulter\\Contracts\\Collaboration\\NodeCollaborationDriver`\\n\n\\n\nThe **node-tree** realtime-collaboration transport (the current path). Abstracts how\\n\na document node (`kind=document`, content on `v_node_document_versions`) is joined for\\n\nrealtime editing. The authorization decision is **not** the driver's job \u2014 the\\n\ncontroller resolves it through `AccessResolver` and passes the granted ability in; the\\n\ndriver only encodes it into the session descriptor (`readOnly = ability is not Edit`).\\n\n\\n\n```php\\n\ninterface NodeCollaborationDriver\\n\n{\\n\n    public function type(): CollaborationDriverType;\\n\n\\n\n    /** @param int|string $actorId the connecting host user's id (the JWT `sub`) */\\n\n    public function issueSession(Node $node, Ability $ability, int|string $actorId): CollaborationSession;\\n\n}\\n\n```\\n\n\\n\n### `Vaulter\\Contracts\\Collaboration\\HostUserResolver`\\n\n\\n\nMaterialises a host user (`Authorizable`) by id, so the server-to-server\\n\ncollaboration webhook \u2014 which carries only a user id, no session \u2014 can run the\\n\n`AccessResolver` against a real actor. Returns `null` when the id resolves to nothing\\n\n(the webhook then answers `allowed=false` rather than failing open). The default\\n\n`Vaulter\\Documents\\Collaboration\\HostUserResolver` defers to the configured auth user-provider; bind\\n\nyour own to override.\\n\n\\n\n```php\\n\ninterface HostUserResolver\\n\n{\\n\n    public function find(int|string $id): ?Authorizable;\\n\n}\\n\n```\\n\n\\n\nSee [Collaboration \u2192 Drivers](/guide/collaboration).\\n\n\\n\n---\\n\n\\n\n## Handlers\\n\n\\n\n### `Vaulter\\Contracts\\Handlers\\FileHandler`\\n\n\\n\nA pluggable document-processing handler \u2014 the format-extensibility headline. A\\n\nhandler claims a set of mime types (exact or wildcards like `\"image/*\"`) and/or\\n\nextensions, declares its capabilities and front-end mount descriptor per file, and the\\n\n`Vaulter\\Engines\\DocumentHandlerRegistry` resolves the best one for a `FileDescriptor`. Register via\\n\n`config('vaulter.handlers')` (FQCN list), the tagged binding `'vaulter.handlers'`, or\\n\n`Vaulter::registerHandler()`.\\n\n\\n\n```php\\n\ninterface FileHandler\\n\n{\\n\n    public function id(): string;\\n\n\\n\n    /** @return list<string> */\\n\n    public function mimeTypes(): array;\\n\n\\n\n    /** @return list<string> */\\n\n    public function extensions(): array;\\n\n\\n\n    public function priority(): int;\\n\n\\n\n    public function capabilities(FileDescriptor $file): HandlerCapabilities;\\n\n\\n\n    public function ui(FileDescriptor $file): HandlerUi;\\n\n}\\n\n```\\n\n\\n\n- `id()` \u2014 a stable unique string id (`'tiptap'`, `'preview'`, `'download'`,\\n\n  `'univer'`, \u2026). Surfaced to the client so it can pick the editor/preview impl.\\n\n- `mimeTypes()` \u2014 exact (`\"application/pdf\"`), wildcard (`\"image/*\"`), or catch-all\\n\n  (`\"*\"`). Routing prefers the sniffed mime over the claimed one.\\n\n- `extensions()` \u2014 lower-case, no dot; the extension fallback used when the mime\\n\n  didn't match.\\n\n- `priority()` \u2014 higher wins among handlers matching the same file + capability; the\\n\n  `DownloadOnlyHandler` null-object sits lowest.\\n\n- `capabilities()` \u2014 editable / previewable / downloadable / thumbnailable /\\n\n  collaborative, computed per file.\\n\n- `ui()` \u2014 the Vue component + open route + props the client mounts.\\n\n\\n\nSee [Recipes \u2192 Custom handler](/guide/recipes) and [Writing a Handler/Engine](/guide/writing-an-engine)\\n\nfor a full worked example.\\n\n\\n\n`Vaulter\\Engines\\Handlers\\AbstractFileHandler` is an optional DX base a third-party\\n\nhandler MAY extend \u2014 it only defaults `extensions()` to `[]`; every other method stays\\n\nhandler-specific. Implementing `FileHandler` directly is always enough; the base class\\n\nsaves nothing beyond that one line. The built-in handlers do not extend it \u2014 they stay\\n\n`final` with zero inheritance (H.5).\\n\n\\n\n### `Vaulter\\Contracts\\Handlers\\DocumentExporter`\\n\n\\n\nRenders a document's content (`DocumentContent`, the same opaque payload the write path\\n\nstores) into an export format \u2014 the contract does not assume TipTap. Built-in HTML and\\n\nMarkdown exporters ship; register your own (PDF, DOCX, \u2026) via `config('vaulter.exporters')`\\n\nor `Vaulter::registerExporter()`. Binary formats should return an encoded string (e.g.\\n\nbase64) and advertise the matching mime type.\\n\n\\n\n```php\\n\ninterface DocumentExporter\\n\n{\\n\n    /** The format key (e.g. 'html', 'pdf'); also echoed in the API. */\\n\n    public function format(): string;\\n\n\\n\n    public function mimeType(): string;\\n\n\\n\n    /** File extension, without the dot. */\\n\n    public function extension(): string;\\n\n\\n\n    public function export(DocumentContent $content): string;\\n\n}\\n\n```\\n\n\\n\nSee [Recipes \u2192 Custom export](/guide/recipes).\\n\n\\n\n### `Vaulter\\Contracts\\Handlers\\DocumentContent`\\n\n\\n\nThe content payload a document version stores. A handler decides the shape: a\\n\nrich-text handler produces a validated TipTap doc (`TipTapContent`); a non-rich-text\\n\nhandler produces an opaque JSON snapshot the core stores verbatim\\n\n(`OpaqueDocumentContent`).\\n\n\\n\n```php\\n\ninterface DocumentContent\\n\n{\\n\n    /** @return array<string, mixed> */\\n\n    public function toArray(): array;\\n\n\\n\n    public function contentHash(): string;\\n\n\\n\n    public function sizeInBytes(): int;\\n\n}\\n\n```\\n\n\\n\n**Implement when** your `FileHandler` needs a content shape other than TipTap or\\n\nthe bundled opaque snapshot.\\n\n\\n\n### `Vaulter\\Contracts\\Handlers\\HandlerRegistry`\\n\n\\n\nThe format-extensibility registry seam behind `Vaulter::registerHandler()` /\\n\n`Vaulter::handlers()`. Both the contract and the concrete engine\\n\n(`Vaulter\\Engines\\DocumentHandlerRegistry`, the SSOT resolver \u2014 final, H.5) are\\n\ncore-owned: this binding always resolves, even without vaulter-documents installed\\n\n(a drive-only host still gets preview/download resolution). Packages like\\n\nvaulter-documents only ADD handlers (TipTap, Univer, \u2026) to this same registry.\\n\n\\n\n```php\\n\ninterface HandlerRegistry\\n\n{\\n\n    /** @param FileHandler|class-string<FileHandler> $handler */\\n\n    public function register(FileHandler|string $handler): void;\\n\n\\n\n    /** @return list<FileHandler> */\\n\n    public function all(): array;\\n\n}\\n\n```\\n\n\\n\n### `Vaulter\\Contracts\\Handlers\\NodeHandlerResolver`\\n\n\\n\nResolves the format-handler descriptor for a node \u2014 the `(id + capabilities + ui)`\\n\nbundle the `GET .../handler` endpoint returns, so the Vue client routes the node to\\n\nthe right editor/preview/download surface. Both the contract and the concrete\\n\n`Vaulter\\Engines\\NodeHandlerResolver` are core-owned (D10): `app(NodeHandlerResolver::class)`\\n\nalways resolves, even without vaulter-documents installed \u2014 a drive-only host still gets a\\n\npreview/download descriptor. Packages like vaulter-documents only ADD handlers to the\\n\nregistry the resolver consults.\\n\n\\n\n```php\\n\ninterface NodeHandlerResolver\\n\n{\\n\n    public function describe(Node $node, ?string $detectedMime = null): HandlerDescriptor;\\n\n}\\n\n```\\n\n\\n\n---\\n\n\\n\n## Sharing\\n\n\\n\n### `Vaulter\\Contracts\\Sharing\\ShareTokenGenerator`\\n\n\\n\nGenerates the opaque token for a public share link. A token must be unique and fit the\\n\ntoken column (\u2264 64 chars). Swap the legacy document-share token via\\n\n`config('vaulter.share_token_generator')`, and the bearer node-share token via\\n\n`config('vaulter.share.token_generator')`.\\n\n\\n\n```php\\n\ninterface ShareTokenGenerator\\n\n{\\n\n    public function generate(): string;\\n\n}\\n\n```\\n\n\\n\nThe default is `Vaulter\\Support\\RandomShareTokenGenerator`. See\\n\n[Recipes \u2192 Share token generator](/guide/recipes).\\n\n\\n\n---\\n\n\\n\n## Uploads\\n\n\\n\n### `Vaulter\\Drive\\Contracts\\Uploads\\UploadProtocolHandler`\\n\n\\n\nThe per-protocol strategy behind a resumable-upload session. Two implementations\\n\nship \u2014 `TusUploadHandler` (tus.io CORE: Creation + HEAD + PATCH, any Flysystem disk)\\n\nand `S3MultipartHandler` (object-store multipart, S3-style disks only). Every handler\\n\naccumulates bytes resumably onto the staged temp, advancing the authoritative\\n\nserver-side `received_bytes`, and reports when the session is fully assembled. The\\n\nassemble \u2192 commit step is **outside** the handler (`CommitUploadAction` \u2192\\n\n`BlobStore::commit`), so the \"assembled bytes always go through the one race-free CAS\"\\n\ninvariant holds for both protocols.\\n\n\\n\n```php\\n\ninterface UploadProtocolHandler\\n\n{\\n\n    public function protocol(): UploadProtocol;\\n\n\\n\n    /** @return array<string, mixed> */\\n\n    public function initialise(UploadSession $session): array;\\n\n\\n\n    public function isComplete(UploadSession $session): bool;\\n\n\\n\n    public function abort(UploadSession $session): void;\\n\n}\\n\n```\\n\n\\n\nSee [Usage \u2192 Uploads](/guide/uploads).\\n\n\\n\n---\\n\n\\n\n## Identity\\n\n\\n\n### `Vaulter\\Contracts\\IdStrategy`\\n\n\\n\nThe primary-key strategy: drives column types in migrations plus the matching model\\n\nconcern, so \"ulid vs uuid7 vs bigint\" is decided from `config('vaulter.ids.default')`\\n\nrather than hard-coded. Implementations live in `Vaulter\\Schema\\*`\\n\n(`AutoIncrementIds`, `UlidIds`, `Uuid7Ids`); a host may register its own under\\n\n`config('vaulter.ids.strategies')`.\\n\n\\n\n```php\\n\ninterface IdStrategy\\n\n{\\n\n    public function key(Blueprint $table, string $column = 'id'): void;\\n\n\\n\n    public function reference(Blueprint $table, string $column, bool $nullable = false): void;\\n\n\\n\n    public function actor(Blueprint $table, string $column, bool $nullable = false): void;\\n\n\\n\n    /** Eloquent cast for the key type. */\\n\n    public function cast(): string;\\n\n\\n\n    /** @return class-string|null Model concern (trait FQCN), or null for bigint. */\\n\n    public function modelConcern(): ?string;\\n\n\\n\n    /** Mint a fresh key, or null for auto-increment keys. */\\n\n    public function newId(): string|int|null;\\n\n}\\n\n```\\n\n\\n\n- `key()` \u2014 define the primary-key column.\\n\n- `reference()` \u2014 define a FK to another Vaulter entity (same key type).\\n\n- `actor()` \u2014 define a reference to a host user id (no DB-level FK; the host owns the\\n\n  users table).\\n\n\\n\n::: info Default is `ulid`\\n\nULID is the default so morph keys line up with the Corex/Azgard ecosystem; `uuid7`\\n\nmaps onto native Postgres `uuid` columns; `bigint` is the legacy auto-increment path.\\n\nSee [Auth \u2192 Multi-tenancy](/guide/multi-tenancy) for morph alignment.\\n\n:::\\n\n\\n\n## See also\\n\n\\n\n- [Facade & Manager](/reference/facade) \u2014 the methods that accept and return these\\n\n- [Configuration reference](/reference/configuration) \u2014 the binding keys\\n\n- [Events reference](/reference/events) \u2014 what's dispatched across these seams\\n\n' [UTF-8](length: 22795) contains \"FileHandlerRegistry\" [ASCII](length: 19)."},{"test":"P\\Packages\\core\\tests\\Support\\FacadeMethodDocblockTest::__pest_evaluable_it_lists_every_public_VaulterManager_method_in_the_facade__method_docblock__F_P2_1_01","file":"/home/vostrikov/projects/packages/vaulter/packages/core/tests/Support/FacadeMethodDocblockTest.php","line":26,"message":"Failed asserting that actual size 9 matches expected size 12."},{"test":"P\\Packages\\core\\tests\\Support\\UpgradeGuideCoverageTest::__pest_evaluable_it_UPGRADE_md_\u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438\u0440\u0443\u0435\u0442__\u0447\u0442\u043e_\u043f\u0430\u043d\u0435\u043b\u0438_\u0447\u0438\u0442\u0430\u044e\u0442\u0441\u044f_\u043d\u0430_boot_\u0435_\u2014_\u0438_\u0440\u0435\u0437\u043e\u043b\u0432_\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e_\u0442\u0430\u043c","file":"/home/vostrikov/projects/packages/vaulter/packages/core/tests/Support/UpgradeGuideCoverageTest.php","line":119,"message":"Failed asserting that 'public function packageBooted(): void\\n\n    {\\n\n        (new HttpRegistrar)->boot($this->app);\\n\n        (new AccessRegistrar)->boot($this->app);\\n\n        (new EventsRegistrar)->boot($this->app);\\n\n        (new BindingsRegistrar)->boot($this->app);\\n\n    }\\n\n}\\n\n' [ASCII](length: 248) contains \"$this->app->make(ProfileRegistry::class)\" [ASCII](length: 40)."}],"errors":11,"error_details":[{"test":"P\\Packages\\core\\tests\\IdStrategy\\Bigint\\VaulterSchemaBigintTest::__pest_evaluable_it_emits_every_convention_column_under_the_bigint_strategy","file":"/home/vostrikov/projects/packages/vaulter/packages/core/src/Schema/VaulterSchema.php","line":81,"message":"Class \"Vaulter\\Schema\\Config\" not found"},{"test":"P\\Packages\\core\\tests\\IdStrategy\\Bigint\\VaulterSchemaBigintTest::__pest_evaluable_it_shapes_Vaulter_keys_and_references_as_bigint_columns_and_host_keys_independently","file":"/home/vostrikov/projects/packages/vaulter/packages/core/src/Schema/VaulterSchema.php","line":81,"message":"Class \"Vaulter\\Schema\\Config\" not found"},{"test":"P\\Packages\\core\\tests\\IdStrategy\\Bigint\\VaulterSchemaBigintTest::__pest_evaluable_it_defaults_the_panel_discriminator_and_carries_a_bitmask_column","file":"/home/vostrikov/projects/packages/vaulter/packages/core/src/Schema/VaulterSchema.php","line":81,"message":"Class \"Vaulter\\Schema\\Config\" not found"},{"test":"P\\Packages\\core\\tests\\IdStrategy\\Ulid\\VaulterSchemaUlidTest::__pest_evaluable_it_emits_every_convention_column_under_the_ulid_strategy","file":"/home/vostrikov/projects/packages/vaulter/packages/core/src/Schema/VaulterSchema.php","line":81,"message":"Class \"Vaulter\\Schema\\Config\" not found"},{"test":"P\\Packages\\core\\tests\\IdStrategy\\Ulid\\VaulterSchemaUlidTest::__pest_evaluable_it_shapes_Vaulter_keys_and_references_as_char_26__columns_and_host_keys_independently","file":"/home/vostrikov/projects/packages/vaulter/packages/core/src/Schema/VaulterSchema.php","line":81,"message":"Class \"Vaulter\\Schema\\Config\" not found"},{"test":"P\\Packages\\core\\tests\\IdStrategy\\Ulid\\VaulterSchemaUlidTest::__pest_evaluable_it_defaults_the_panel_discriminator_and_carries_a_bitmask_column","file":"/home/vostrikov/projects/packages/vaulter/packages/core/src/Schema/VaulterSchema.php","line":81,"message":"Class \"Vaulter\\Schema\\Config\" not found"},{"test":"P\\Packages\\core\\tests\\IdStrategy\\Uuid7\\VaulterSchemaUuid7Test::__pest_evaluable_it_emits_every_convention_column_under_the_uuid7_strategy","file":"/home/vostrikov/projects/packages/vaulter/packages/core/src/Schema/VaulterSchema.php","line":81,"message":"Class \"Vaulter\\Schema\\Config\" not found"},{"test":"P\\Packages\\core\\tests\\IdStrategy\\Uuid7\\VaulterSchemaUuid7Test::__pest_evaluable_it_shapes_Vaulter_keys_and_references_as_uuid_columns_and_host_keys_independently","file":"/home/vostrikov/projects/packages/vaulter/packages/core/src/Schema/VaulterSchema.php","line":81,"message":"Class \"Vaulter\\Schema\\Config\" not found"},{"test":"P\\Packages\\core\\tests\\IdStrategy\\Uuid7\\VaulterSchemaUuid7Test::__pest_evaluable_it_defaults_the_panel_discriminator_and_carries_a_bitmask_column","file":"/home/vostrikov/projects/packages/vaulter/packages/core/src/Schema/VaulterSchema.php","line":81,"message":"Class \"Vaulter\\Schema\\Config\" not found"},{"test":"P\\Packages\\core\\tests\\Schema\\HostKeyColumnsSchemaTest::__pest_evaluable_it_preserves_nullable_and_index_conventions_for_migration_helpers","file":"/home/vostrikov/projects/packages/vaulter/packages/core/src/Schema/VaulterSchema.php","line":81,"message":"Class \"Vaulter\\Schema\\Config\" not found"},{"test":"P\\Packages\\core\\tests\\Unit\\EnumTest::__pest_evaluable_it_orders_permission_levels","file":"/home/vostrikov/projects/packages/vaulter/packages/core/tests/Unit/EnumTest.php","line":17,"message":"Class \"Vaulter\\Enums\\Access\\PermissionLevel\" not found"}],"skipped":28,"risky":17}
