@@ -0,0 +1,118 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { nextTick } from 'vue'
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/vue'
+import VaulterDrive from '../../src/components/VaulterDrive.vue'
+import VaulterUploader from '../../src/components/VaulterUploader.vue'
+import { VaulterApiError } from '../../src/api/errors'
+import type { Node } from '../../src/api/types'
+import { makeFile, pageOf } from '../support/nodes'
+import { withClient } from '../support/mount'
+
+// Testing Library only auto-cleans when the test globals are enabled; this package keeps them off.
+afterEach(cleanup)
+
+const rows = () => screen.getAllByRole('option')
+
+/** A drive whose listing, rename and trash are fakes that remember what was asked. */
+function fakeDrive(initial: Node[]) {
+  let current = initial
+  const children = vi.fn().mockImplementation(() => Promise.resolve(pageOf(current)))
+  const update = vi.fn().mockImplementation((id: string, patch: { name: string }) =>
+    Promise.resolve({ ...current.find((node) => node.id === id)!, name: patch.name }))
+  const trash = vi.fn().mockImplementation((id: string) => {
+    current = current.filter((node) => node.id !== id)
+    return Promise.resolve({ ...initial.find((node) => node.id === id)!, trashed_at: 'now' })
+  })
+
+  return {
+    children, update, trash,
+    client: { nodes: { children, update, trash, getWithIncludes: vi.fn() }, folders: { create: vi.fn() }, files: { downloadUrl: vi.fn() } },
+  }
+}
+
+describe('VaulterDrive — keyboard scenarios', () => {
+  it('Delete trashes the focused node with its etag, then focus lands on the neighbour', async () => {
+    const files = [
+      makeFile({ id: '1', name: 'a.txt', etag: '"1.1.aa"' }),
+      makeFile({ id: '2', name: 'b.txt', etag: '"2.1.bb"' }),
+      makeFile({ id: '3', name: 'c.txt', etag: '"3.1.cc"' }),
+    ]
+    const { client, trash } = fakeDrive(files)
+    render(VaulterDrive, { props: { driveId: '7', confirm: () => true }, ...withClient(client) })
+    await waitFor(() => expect(rows()).toHaveLength(3))
+
+    rows()[1].focus()
+    await fireEvent.keyDown(rows()[1], { key: 'Delete' })
+
+    await waitFor(() => expect(rows()).toHaveLength(2))
+    expect(trash).toHaveBeenCalledWith('2', { etag: '"2.1.bb"' })
+    await nextTick()
+    expect(document.activeElement).toBe(rows()[1])
+    expect(document.activeElement?.textContent).toContain('c.txt')
+  })
+
+  it('F2 opens the name dialog prefilled; submitting renames with the etag', async () => {
+    const files = [makeFile({ id: '1', name: 'old.txt', etag: '"1.4.dd"' })]
+    const { client, update } = fakeDrive(files)
+    render(VaulterDrive, { props: { driveId: '7' }, ...withClient(client) })
+    await waitFor(() => expect(rows()).toHaveLength(1))
+
+    rows()[0].focus()
+    await fireEvent.keyDown(rows()[0], { key: 'F2' })
+
+    const field = await screen.findByLabelText('Name') as HTMLInputElement
+    expect(field.value).toBe('old.txt')
+
+    await fireEvent.update(field, 'new.txt')
+    await fireEvent.keyDown(field, { key: 'Enter' })
+
+    await waitFor(() => expect(update).toHaveBeenCalledWith('1', { name: 'new.txt' }, { etag: '"1.4.dd"' }))
+  })
+
+  it('Enter on a folder navigates into it', async () => {
+    const folder = makeFile({ id: '1', name: 'Docs', kind: 'folder', presentation: null })
+    const { client, children } = fakeDrive([folder])
+    ;(client.nodes.getWithIncludes as ReturnType<typeof vi.fn>).mockResolvedValue({ ...folder, breadcrumb: [{ id: '1', name: 'Docs' }] })
+    render(VaulterDrive, { props: { driveId: '7' }, ...withClient(client) })
+    await waitFor(() => expect(rows()).toHaveLength(1))
+
+    rows()[0].focus()
+    await fireEvent.keyDown(rows()[0], { key: 'Enter' })
+
+    await waitFor(() => expect(children).toHaveBeenLastCalledWith('7', { parent: '1' }))
+  })
+
+  it('shows a mutation failure in an alert region', async () => {
+    const files = [makeFile({ id: '1', name: 'a.txt' })]
+    const { client, trash } = fakeDrive(files)
+    trash.mockRejectedValueOnce(new VaulterApiError({ status: 403, code: 'permission_denied', detail: 'You may not trash this.' }))
+    render(VaulterDrive, { props: { driveId: '7', confirm: () => true }, ...withClient(client) })
+    await waitFor(() => expect(rows()).toHaveLength(1))
+
+    rows()[0].focus()
+    await fireEvent.keyDown(rows()[0], { key: 'Delete' })
+
+    // The uploader keeps its own (empty) live region in the toolbar, so find the alert by its text.
+    const alert = await screen.findByText('You may not trash this.')
+    expect(alert.getAttribute('role')).toBe('alert')
+  })
+})
+
+describe('VaulterUploader — failures are announced', () => {
+  it('exposes an assertive live region that receives the failure text', async () => {
+    const upload = vi.fn().mockRejectedValue(new VaulterApiError({
+      status: 413, code: 'file_size_limit_exceeded', title: 'Too large', detail: 'The file is too large.',
+    }))
+    const { container } = render(VaulterUploader, { props: { driveId: '7' }, ...withClient({ files: { upload } }) })
+    const input = container.querySelector('input[type="file"]') as HTMLInputElement
+    const file = new File(['x'], 'huge.bin')
+
+    await fireEvent.update(input, '')
+    Object.defineProperty(input, 'files', { value: [file], configurable: true })
+    await fireEvent.change(input)
+
+    const announcement = await screen.findByText('Upload of huge.bin failed: The file is too large.')
+    expect(announcement.getAttribute('aria-live')).toBe('assertive')
+    expect(announcement.getAttribute('role')).toBe('alert')
+  })
+})
diff --git a/packages/vue/tests/a11y/node-list.test.ts b/packages/vue/tests/a11y/node-list.test.ts
new file mode 100644
index 00000000..3132a88e
--- /dev/null
+++ b/packages/vue/tests/a11y/node-list.test.ts
@@ -0,0 +1,207 @@
+import { afterEach, describe, expect, it } from 'vitest'
+import { defineComponent, h, nextTick, ref } from 'vue'
+import { cleanup, fireEvent, render, screen, within } from '@testing-library/vue'
+import VaulterNodeList from '../../src/components/VaulterNodeList.vue'
+import type { Node } from '../../src/api/types'
+import { makeFile, makeNode } from '../support/nodes'
+
+// Testing Library only auto-cleans when the test globals are enabled; this package keeps them off.
+afterEach(cleanup)
+
+const listOf = (...names: string[]): Node[] => names.map((name, index) => makeFile({ id: String(index + 1), name }))
+
+const rows = () => screen.getAllByRole('option')
+const focused = () => document.activeElement as HTMLElement
+
+describe('VaulterNodeList — listbox semantics', () => {
+  it('is a labelled listbox of options, with exactly one tab stop', () => {
+    render(VaulterNodeList, { props: { nodes: listOf('a.txt', 'b.txt', 'c.txt') } })
+
+    const listbox = screen.getByRole('listbox', { name: 'Files' })
+    expect(within(listbox).getAllByRole('option')).toHaveLength(3)
+    expect(rows().map((row) => row.getAttribute('tabindex'))).toEqual(['0', '-1', '-1'])
+  })
+
+  it('accepts a custom accessible name', () => {
+    render(VaulterNodeList, { props: { nodes: listOf('a.txt'), label: 'Shared files' } })
+
+    expect(screen.getByRole('listbox', { name: 'Shared files' })).toBeTruthy()
+  })
+
+  it('reflects the selection in aria-selected', () => {
+    render(VaulterNodeList, { props: { nodes: listOf('a.txt', 'b.txt'), selectedId: '2' } })
+
+    expect(rows().map((row) => row.getAttribute('aria-selected'))).toEqual(['false', 'true'])
+  })
+
+  it('moves the single tab stop to the selected row', () => {
+    render(VaulterNodeList, { props: { nodes: listOf('a.txt', 'b.txt'), selectedId: '2' } })
+
+    expect(rows().map((row) => row.getAttribute('tabindex'))).toEqual(['-1', '0'])
+  })
+})
+
+describe('VaulterNodeList — keyboard', () => {
+  it('ArrowDown / ArrowUp move focus between rows and stop at the ends', async () => {
+    render(VaulterNodeList, { props: { nodes: listOf('a.txt', 'b.txt', 'c.txt') } })
+    rows()[0].focus()
+
+    await fireEvent.keyDown(focused(), { key: 'ArrowDown' })
+    await nextTick()
+    expect(focused()).toBe(rows()[1])
+
+    await fireEvent.keyDown(focused(), { key: 'ArrowDown' })
+    await nextTick()
+    expect(focused()).toBe(rows()[2])
+
+    await fireEvent.keyDown(focused(), { key: 'ArrowDown' })
+    await nextTick()
+    expect(focused()).toBe(rows()[2])
+
+    await fireEvent.keyDown(focused(), { key: 'ArrowUp' })
+    await nextTick()
+    expect(focused()).toBe(rows()[1])
+  })
+
+  it('Home and End jump to the first and last row, and the tab stop follows the focus', async () => {
+    render(VaulterNodeList, { props: { nodes: listOf('a.txt', 'b.txt', 'c.txt') } })
+    rows()[1].focus()
+
+    await fireEvent.keyDown(focused(), { key: 'End' })
+    await nextTick()
+    expect(focused()).toBe(rows()[2])
+    expect(rows().map((row) => row.getAttribute('tabindex'))).toEqual(['-1', '-1', '0'])
+
+    await fireEvent.keyDown(focused(), { key: 'Home' })
+    await nextTick()
+    expect(focused()).toBe(rows()[0])
+  })
+
+  it('Enter opens the focused node, Space selects it', async () => {
+    const { emitted } = render(VaulterNodeList, { props: { nodes: listOf('a.txt', 'b.txt') } })
+    rows()[1].focus()
+
+    await fireEvent.keyDown(focused(), { key: 'Enter' })
+    await fireEvent.keyDown(focused(), { key: ' ' })
+
+    expect(emitted().open[0]).toEqual([expect.objectContaining({ id: '2' })])
+    expect(emitted().select[0]).toEqual([expect.objectContaining({ id: '2' })])
+  })
+
+  it('F2 asks to rename and Delete asks to trash the focused node', async () => {
+    const { emitted } = render(VaulterNodeList, {
+      props: { nodes: listOf('a.txt'), actions: ['rename', 'trash'] },
+    })
+    rows()[0].focus()
+
+    await fireEvent.keyDown(focused(), { key: 'F2' })
+    await fireEvent.keyDown(focused(), { key: 'Delete' })
+
+    expect(emitted().action).toEqual([
+      ['rename', expect.objectContaining({ id: '1' })],
+      ['trash', expect.objectContaining({ id: '1' })],
+    ])
+  })
+
+  it('F2 and Delete do nothing when the caller lacks the ability or the action is not offered', async () => {
+    const readOnly = makeNode({ id: '1', kind: 'file', abilities: { edit: false, trash: false } })
+    const { emitted, rerender } = render(VaulterNodeList, { props: { nodes: [readOnly], actions: ['rename', 'trash'] } })
+    rows()[0].focus()
+
+    await fireEvent.keyDown(focused(), { key: 'F2' })
+    await fireEvent.keyDown(focused(), { key: 'Delete' })
+    expect(emitted().action).toBeUndefined()
+
+    // Able to, but the host did not offer trash: still no event.
+    await rerender({ nodes: listOf('a.txt'), actions: ['rename'] })
+    rows()[0].focus()
+    await fireEvent.keyDown(focused(), { key: 'Delete' })
+    expect(emitted().action).toBeUndefined()
+  })
+
+  it('ignores keys pressed on a button inside a row', async () => {
+    const { emitted } = render(VaulterNodeList, { props: { nodes: listOf('a.txt', 'b.txt'), actions: ['download'] } })
+    const button = screen.getAllByRole('button', { name: 'download a.txt' })[0]
+
+    await fireEvent.keyDown(button, { key: 'ArrowDown' })
+    await fireEvent.keyDown(button, { key: 'Delete' })
+
+    expect(emitted().action).toBeUndefined()
+  })
+
+  it('keeps every row action reachable by keyboard (buttons stay in the tab order)', () => {
+    render(VaulterNodeList, { props: { nodes: listOf('a.txt'), actions: ['download', 'share'] } })
+
+    for (const button of screen.getAllByRole('button')) {
+      expect(button.getAttribute('tabindex')).toBeNull()
+    }
+  })
+})
+
+describe('VaulterNodeList — focus after a mutation', () => {
+  /** A host that owns the list, like VaulterDrive does, and can drop a node. */
+  function host(initial: Node[]) {
+    const nodes = ref(initial)
+    const Host = defineComponent({
+      setup() {
+        return () => h(VaulterNodeList, { nodes: nodes.value, actions: ['trash'] })
+      },
+    })
+
+    return { Host, drop: (id: string) => { nodes.value = nodes.value.filter((node) => node.id !== id) } }
+  }
+
+  it('moves focus to the next row when the focused row is removed', async () => {
+    const { Host, drop } = host(listOf('a.txt', 'b.txt', 'c.txt'))
+    render(Host)
+    rows()[1].focus()
+
+    drop('2')
+    await nextTick()
+    await nextTick()
+
+    expect(rows().map((row) => row.textContent)).toEqual([expect.stringContaining('a.txt'), expect.stringContaining('c.txt')])
+    expect(focused()).toBe(rows()[1])
+    expect(focused().textContent).toContain('c.txt')
+  })
+
+  it('moves focus to the previous row when the last row is removed', async () => {
+    const { Host, drop } = host(listOf('a.txt', 'b.txt', 'c.txt'))
+    render(Host)
+    rows()[2].focus()
+
+    drop('3')
+    await nextTick()
+    await nextTick()
+
+    expect(focused()).toBe(rows()[1])
+    expect(focused().textContent).toContain('b.txt')
+  })
+
+  it('does not steal focus from elsewhere on the page when a row is removed', async () => {
+    const { Host, drop } = host(listOf('a.txt', 'b.txt'))
+    const outside = document.createElement('input')
+    document.body.appendChild(outside)
+    render(Host)
+    outside.focus()
+
+    drop('2')
+    await nextTick()
+    await nextTick()
+
+    expect(focused()).toBe(outside)
+    outside.remove()
+  })
+
+  it('keeps one tab stop on the neighbour after the removal', async () => {
+    const { Host, drop } = host(listOf('a.txt', 'b.txt', 'c.txt'))
+    render(Host)
+    rows()[0].focus()
+
+    drop('1')
+    await nextTick()
+    await nextTick()
+
+    expect(rows().map((row) => row.getAttribute('tabindex'))).toEqual(['0', '-1'])
+  })
+})
diff --git a/packages/vue/tests/api/client.test.ts b/packages/vue/tests/api/client.test.ts
