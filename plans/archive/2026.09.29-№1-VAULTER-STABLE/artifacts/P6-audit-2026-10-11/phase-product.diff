+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Http\UploadedFile;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Testing\TestResponse;
+use Vaulter\Data\Drive\UploadSource;
+use Vaulter\Drive\Tests\Http\DriveV1;
+use Vaulter\Tests\Drive\DriveTestHelpers;
+use Vaulter\Tests\Http\V1;
+
+/**
+ * File content over v1: single-shot upload, revisions (list, add, restore, retention,
+ * delete) and strict-mode downloads of the head and of one exact revision.
+ */
+uses(RefreshDatabase::class);
+
+beforeEach(function (): void {
+    Storage::fake('local');
+    $this->drive = V1::drive(userId: 1);
+    $this->driveId = (string) $this->drive->model()->getKey();
+    $this->actingAs(V1::user(1));
+});
+
+function streamedContent(TestResponse $response): string
+{
+    return $response->streamedContent();
+}
+
+it('uploads a file in one request and answers 201 with the node and its tag', function (): void {
+    $folder = V1::folder($this->drive, 'docs');
+
+    $response = $this->post(V1::url('drives/'.$this->driveId.'/files'), [
+        'parent_id' => $folder->id,
+        'file' => UploadedFile::fake()->createWithContent('report.txt', 'hello drive'),
+    ], ['Accept' => 'application/json'])
+        ->assertCreated()
+        ->assertJsonPath('data.kind', 'file')
+        ->assertJsonPath('data.parent_id', $folder->id)
+        ->assertJsonPath('data.size_bytes', 11)
+        ->assertJsonPath('data.file.revision_number', 1);
+
+    expect($response->headers->get('ETag'))->toBe($response->json('data.etag'))
+        ->and($response->json('data'))->not->toHaveKeys(['file_id', 'storage_id', 'current_version_id']);
+});
+
+it('lists revisions newest first, adds one with If-Match and restores an older one', function (): void {
+    $file = V1::file($this->drive, 'v.txt', 'one');
+
+    $added = $this->post(V1::url('files/'.$file->id.'/revisions'), [
+        'file' => UploadedFile::fake()->createWithContent('v.txt', 'two two'),
+    ], ['Accept' => 'application/json', 'If-Match' => DriveV1::etag($this, $file->id)])
+        ->assertCreated()
+        ->assertJsonPath('data.number', 2)
+        ->assertJsonPath('data.is_head', true)
+        ->assertJsonPath('data.size_bytes', 7);
+    expect(array_keys($added->json('data')))->toBe(['id', 'number', 'size_bytes', 'mime', 'declared_mime', 'sha256', 'scan_status', 'keep_forever', 'is_head', 'created_by', 'created_at']);
+
+    $list = $this->getJson(V1::url('files/'.$file->id.'/revisions'))->assertOk()
+        ->assertJsonPath('data.0.number', 2)
+        ->assertJsonPath('data.1.number', 1)
+        ->assertJsonPath('meta.next_cursor', null);
+    $first = $list->json('data.1.id');
+
+    $this->postJson(V1::url('files/'.$file->id.'/revisions/'.$first.'/restore'), [], ['If-Match' => DriveV1::etag($this, $file->id)])
+        ->assertOk()
+        ->assertJsonPath('data.number', 3)
+        ->assertJsonPath('data.is_head', true);
+    expect(streamedContent($this->get(V1::url('files/'.$file->id.'/download'))->assertOk()))->toBe('one');
+});
+
+it('pins a revision, refuses to delete the head and deletes an old revision', function (): void {
+    $file = V1::file($this->drive, 'r.txt', 'old');
+    $this->drive->files()->addRevision($file->id, UploadSource::fromString('new', 'r.txt'));
+    [$head, $old] = $this->getJson(V1::url('files/'.$file->id.'/revisions'))->json('data');
+
+    $this->patchJson(V1::url('files/'.$file->id.'/revisions/'.$old['id']), ['keep_forever' => true])
+        ->assertOk()->assertJsonPath('data.keep_forever', true);
+    $this->deleteJson(V1::url('files/'.$file->id.'/revisions/'.$old['id']))->assertStatus(409)->assertJsonPath('code', 'revision_pinned');
+    $this->patchJson(V1::url('files/'.$file->id.'/revisions/'.$old['id']), ['keep_forever' => false])->assertOk();
+
+    $this->deleteJson(V1::url('files/'.$file->id.'/revisions/'.$head['id']))->assertStatus(409)->assertJsonPath('code', 'cannot_delete_head_revision');
+    $this->deleteJson(V1::url('files/'.$file->id.'/revisions/'.$old['id']))->assertNoContent();
+    $this->getJson(V1::url('files/'.$file->id.'/revisions'))->assertJsonCount(1, 'data');
+});
+
+it('downloads the head and one exact revision through the strict responder', function (): void {
+    $file = V1::file($this->drive, 'отчёт.txt', 'first', 'text/plain');
+    $first = (string) DriveTestHelpers::model($file)->file()->firstOrFail()->currentRevision()->firstOrFail()->getKey();
+    $this->drive->files()->addRevision($file->id, UploadSource::fromString('second', 'отчёт.txt'));
+
+    $head = $this->get(V1::url('files/'.$file->id.'/download'))->assertOk();
+    expect(streamedContent($head))->toBe('second')
+        ->and($head->headers->get('Content-Disposition'))->toStartWith('attachment; filename=')->toContain("filename*=utf-8''")
+        ->and($head->headers->get('X-Content-Type-Options'))->toBe('nosniff')
+        ->and($head->headers->get('Content-Security-Policy'))->toBe("sandbox; default-src 'none'")
+        ->and($head->headers->get('Cache-Control'))->toContain('private')->toContain('no-store')
+        ->and($head->headers->get('X-Vaulter-Api-Version'))->toBe('1');
+
+    expect(streamedContent($this->get(V1::url('files/'.$file->id.'/revisions/'.$first.'/download'))->assertOk()))->toBe('first');
+});
+
+it('answers not_a_file for content routes on a folder', function (): void {
+    $folder = V1::folder($this->drive, 'not-a-file');
+
+    $this->getJson(V1::url('files/'.$folder->id.'/revisions'))->assertStatus(422)->assertJsonPath('code', 'not_a_file');
+    $this->getJson(V1::url('files/'.$folder->id.'/download'))->assertStatus(422)->assertJsonPath('code', 'not_a_file');
+});
diff --git a/packages/drive/tests/Http/IfMatchRequiredTest.php b/packages/drive/tests/Http/IfMatchRequiredTest.php
new file mode 100644
index 00000000..f4c297a3
--- /dev/null
+++ b/packages/drive/tests/Http/IfMatchRequiredTest.php
@@ -0,0 +1,97 @@
+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Http\UploadedFile;
+use Illuminate\Support\Facades\Storage;
+use Vaulter\Access\Roles\RoleRegistry;
+use Vaulter\Contracts\Drive\DriveHandle;
+use Vaulter\Tests\Access\AccessTestHelpers;
+use Vaulter\Tests\Drive\DriveTestHelpers;
+use Vaulter\Tests\Http\V1;
+
+/**
+ * Every route that changes an existing node refuses to run blind: without If-Match, or
+ * with `*` (which matches anything), it answers 428 and changes nothing.
+ */
+uses(RefreshDatabase::class);
+
+beforeEach(function (): void {
+    Storage::fake('local');
+});
+
+/**
+ * The request of one IM route against fresh fixtures of an owner's drive.
+ *
+ * @return array{0: string, 1: string, 2: array<string, mixed>, 3: string}
+ */
+function imRequest(string $route, DriveHandle $drive): array
+{
+    $file = V1::file($drive, 'target.txt', 'first');
+    $folder = V1::folder($drive, 'destination');
+    $trashed = V1::folder($drive, 'binned');
+    $drive->nodes()->trash($trashed->id);
+    $revision = (string) DriveTestHelpers::model($file)->file()->firstOrFail()->currentRevision()->firstOrFail()->getKey();
+
+    return match ($route) {
+        'nodes.update' => ['PATCH', 'nodes/'.$file->id, ['name' => 'renamed.txt'], $file->id],
+        'nodes.properties.update' => ['PATCH', 'nodes/'.$file->id.'/properties', ['namespace' => 'acme', 'set' => ['k' => 'v']], $file->id],
+        'nodes.move' => ['POST', 'nodes/'.$file->id.'/move', ['destination_id' => $folder->id], $file->id],
+        'nodes.trash' => ['POST', 'nodes/'.$file->id.'/trash', [], $file->id],
+        'nodes.restore' => ['POST', 'nodes/'.$trashed->id.'/restore', [], $trashed->id],
+        'nodes.purge' => ['DELETE', 'nodes/'.$trashed->id, [], $trashed->id],
+        'files.revisions.store' => ['POST', 'files/'.$file->id.'/revisions', ['file' => UploadedFile::fake()->createWithContent('target.txt', 'second')], $file->id],
+        'files.revisions.restore' => ['POST', 'files/'.$file->id.'/revisions/'.$revision.'/restore', [], $file->id],
+        'uploads.store' => ['POST', 'drives/'.$drive->model()->getKey().'/uploads', ['protocol' => 'tus', 'node_id' => $file->id, 'total_size_bytes' => 3], $file->id],
+    };
+}
+
+dataset('im routes', ['nodes.update', 'nodes.properties.update', 'nodes.move', 'nodes.trash', 'nodes.restore', 'nodes.purge', 'files.revisions.store', 'files.revisions.restore', 'uploads.store']);
+
+it('answers 428 without If-Match and leaves the node as it was', function (string $route): void {
+    $drive = V1::drive(userId: 1);
+    [$method, $path, $body, $target] = imRequest($route, $drive);
+    $before = DriveTestHelpers::model($target)->sequence;
+    $this->actingAs(V1::user(1));
+
+    $this->json($method, V1::url($path), $body)
+        ->assertStatus(428)
+        ->assertHeader('Content-Type', 'application/problem+json')
+        ->assertJsonPath('code', 'precondition_required')
+        ->assertJsonPath('meta.header', 'If-Match');
+
+    expect(DriveTestHelpers::model($target)->sequence)->toBe($before);
+})->with('im routes');
+
+it('answers 428 to If-Match: * because it would match any representation', function (string $route): void {
+    $drive = V1::drive(userId: 1);
+    [$method, $path, $body] = imRequest($route, $drive);
+    $this->actingAs(V1::user(1));
+
+    $this->json($method, V1::url($path), $body, ['If-Match' => '*'])
+        ->assertStatus(428)
+        ->assertJsonPath('code', 'precondition_required')
+        ->assertJsonPath('meta.reason', 'wildcard_not_allowed');
+})->with('im routes');
+
+it('answers a caller who cannot see the node 404, not 428', function (string $route): void {
+    $drive = V1::drive(userId: 1);
+    [$method, $path, $body] = imRequest($route, $drive);
+    $this->actingAs(V1::user(2));
+
+    $this->json($method, V1::url($path), $body)->assertNotFound();
+})->with('im routes');
+
+it('answers a caller who may view but not change the node 403 before any precondition', function (string $route): void {
+    $drive = V1::drive(userId: 1);
+    [$method, $path, $body, $target] = imRequest($route, $drive);
+    AccessTestHelpers::grant(DriveTestHelpers::model($drive->root()), RoleRegistry::READER, subjectId: 2);
+    $before = DriveTestHelpers::model($target)->sequence;
+    $this->actingAs(V1::user(2));
+
+    $this->json($method, V1::url($path), $body)->assertForbidden()->assertJsonPath('code', 'permission_denied');
+    $this->json($method, V1::url($path), $body, ['If-Match' => '"stale"'])->assertForbidden();
+
+    expect(DriveTestHelpers::model($target)->sequence)->toBe($before);
+})->with('im routes');
diff --git a/packages/drive/tests/Http/NodeEtagRepresentationTest.php b/packages/drive/tests/Http/NodeEtagRepresentationTest.php
new file mode 100644
index 00000000..8e2b3148
--- /dev/null
+++ b/packages/drive/tests/Http/NodeEtagRepresentationTest.php
@@ -0,0 +1,83 @@
+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Storage;
+use Vaulter\Access\Roles\RoleRegistry;
+use Vaulter\Database\VaulterDatabase;
+use Vaulter\Drive\Tests\Http\DriveV1;
+use Vaulter\Models\Access\NodeGrant;
+use Vaulter\Tests\Access\AccessTestHelpers;
+use Vaulter\Tests\Drive\DriveTestHelpers;
+use Vaulter\Tests\Http\V1;
+
+/**
+ * A node's tag validates the representation the caller receives, not just the node's
+ * sequence: anything that changes what this caller sees (its abilities, its star)
+ * changes its tag, and only its tag.
+ */
+uses(RefreshDatabase::class);
+
+beforeEach(function (): void {
+    Storage::fake('local');
+});
+
+it('gives the owner and a reader different tags for the same node', function (): void {
+    $drive = V1::drive(userId: 1);
+    $node = V1::file($drive, 'shared.txt');
+    AccessTestHelpers::grant(DriveTestHelpers::model($node), RoleRegistry::READER, subjectId: 2);
+
+    $this->actingAs(V1::user(1));
+    $owner = $this->getJson(V1::url('nodes/'.$node->id))->assertOk();
+    $this->actingAs(V1::user(2));
+    $reader = $this->getJson(V1::url('nodes/'.$node->id))->assertOk();
+
+    expect($owner->json('data.sequence'))->toBe($reader->json('data.sequence'))
+        ->and($owner->headers->get('ETag'))->not->toBe($reader->headers->get('ETag'))
+        ->and($reader->json('data.abilities.edit'))->toBeFalse();
+});
+
+it('changes the reader tag when a grant makes it a writer, though the node did not change', function (): void {
+    $drive = V1::drive(userId: 1);
+    $node = V1::file($drive, 'promoted.txt');
+    $grant = AccessTestHelpers::grant(DriveTestHelpers::model($node), RoleRegistry::READER, subjectId: 2);
+    $this->actingAs(V1::user(2));
+    $before = $this->getJson(V1::url('nodes/'.$node->id))->assertOk();
+
+    app(VaulterDatabase::class)->write(static fn () => NodeGrant::query()->whereKey($grant->getKey())->delete());
+    AccessTestHelpers::grant(DriveTestHelpers::model($node), RoleRegistry::WRITER, subjectId: 2);
+    $after = $this->getJson(V1::url('nodes/'.$node->id))->assertOk();
+
+    expect($after->json('data.sequence'))->toBe($before->json('data.sequence'))
+        ->and($after->json('data.abilities.edit'))->toBeTrue()
+        ->and($after->headers->get('ETag'))->not->toBe($before->headers->get('ETag'));
+});
+
+it('changes only the starring caller tag on star', function (): void {
+    $drive = V1::drive(userId: 1);
+    $node = V1::file($drive, 'star.txt');
+    AccessTestHelpers::grant(DriveTestHelpers::model($node), RoleRegistry::READER, subjectId: 2);
+    $this->actingAs(V1::user(2));
+    $readerBefore = DriveV1::etag($this, $node->id);
+    $this->actingAs(V1::user(1));
+    $ownerBefore = DriveV1::etag($this, $node->id);
+
+    $starred = $this->putJson(V1::url('nodes/'.$node->id.'/star'))->assertOk()->assertJsonPath('data.viewer.starred', true);
+
+    expect($starred->headers->get('ETag'))->not->toBe($ownerBefore)
+        ->and(DriveV1::etag($this, $node->id))->toBe($starred->headers->get('ETag'));
+    $this->actingAs(V1::user(2));
+    expect(DriveV1::etag($this, $node->id))->toBe($readerBefore);
+});
+
+it('puts the same tag in the body and in the ETag header', function (): void {
+    $drive = V1::drive(userId: 1);
+    $node = V1::folder($drive, 'same');
+    $this->actingAs(V1::user(1));
+
+    $response = $this->getJson(V1::url('nodes/'.$node->id))->assertOk();
+
+    expect($response->json('data.etag'))->toBe($response->headers->get('ETag'))
+        ->and($response->json('data.etag'))->toStartWith('"'.$node->id.'.'.$response->json('data.sequence').'.');
+});
diff --git a/packages/drive/tests/Http/NodesV1Test.php b/packages/drive/tests/Http/NodesV1Test.php
new file mode 100644
index 00000000..ea0b6b18
--- /dev/null
+++ b/packages/drive/tests/Http/NodesV1Test.php
@@ -0,0 +1,133 @@
+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Storage;
+use Vaulter\Access\Roles\RoleRegistry;
+use Vaulter\Drive\Tests\Http\DriveV1;
+use Vaulter\Tests\Access\AccessTestHelpers;
+use Vaulter\Tests\Drive\DriveTestHelpers;
+use Vaulter\Tests\Http\V1;
+
+/**
+ * The node tree over v1: create, list (cursor pages, no totals), show, rename, move,
+ * copy, search, abilities, shared-with-me — every node as the caller's representation.
+ */
+uses(RefreshDatabase::class);
+
+beforeEach(function (): void {
+    Storage::fake('local');
+    $this->drive = V1::drive(userId: 1);
+    $this->driveId = (string) $this->drive->model()->getKey();
+    $this->actingAs(V1::user(1));
+});
+
+it('creates a folder and lists the root in a cursor page without a total', function (): void {
+    $created = $this->postJson(V1::url('drives/'.$this->driveId.'/folders'), ['name' => 'Docs'])
+        ->assertCreated()
+        ->assertJsonPath('data.kind', 'folder')
+        ->assertJsonPath('data.presentation', null)
+        ->assertJsonPath('data.parent_id', $this->drive->root()->id);
+    expect($created->headers->get('ETag'))->toBe($created->json('data.etag'));
+
+    V1::folder($this->drive, 'Media');
+    $page = $this->getJson(V1::url('drives/'.$this->driveId.'/nodes?per_page=1'))->assertOk()->assertJsonCount(1, 'data');
+    expect($page->json('meta'))->toHaveKeys(['next_cursor', 'per_page'])->not->toHaveKey('total')
+        ->and($page->json('meta.per_page'))->toBe(1);
+
+    $next = $this->getJson(V1::url('drives/'.$this->driveId.'/nodes?per_page=1&cursor='.urlencode($page->json('meta.next_cursor'))))->assertOk();
+    expect($next->json('data.0.id'))->not->toBe($page->json('data.0.id'));
+
+    $this->getJson(V1::url('drives/'.$this->driveId.'/nodes?per_page=500'))->assertStatus(422)->assertJsonPath('code', 'validation_failed');
+});
+
+it('lists a named folder and shows a node with the v1 fields only', function (): void {
+    $folder = V1::folder($this->drive, 'Docs');
+    $file = V1::file($this->drive, 'a.txt', 'abc', parent: $folder->id);
+
+    $this->getJson(V1::url('drives/'.$this->driveId.'/nodes?parent='.$folder->id))->assertOk()->assertJsonPath('data.0.id', $file->id);
+
+    $node = $this->getJson(V1::url('nodes/'.$file->id))->assertOk()->json('data');
+    expect($node['id'])->toBeString()
+        ->and($node['drive_id'])->toBe($this->driveId)
+        ->and($node)->not->toHaveKeys(['storage_id', 'file_id', 'current_version_id', 'handler', 'is_pinned', 'pinned', 'position', 'owned_by'])
+        ->and(array_keys($node['abilities']))->toHaveCount(12)
+        ->and($node['file']['revision_number'])->toBe(1);
+});
+
+it('renames and moves with If-Match and copies without it', function (): void {
+    $file = V1::file($this->drive, 'old.txt');
+    $target = V1::folder($this->drive, 'Target');
+
+    $renamed = $this->patchJson(V1::url('nodes/'.$file->id), ['name' => 'new.txt'], ['If-Match' => DriveV1::etag($this, $file->id)])
+        ->assertOk()->assertJsonPath('data.name', 'new.txt');
+    $this->postJson(V1::url('nodes/'.$file->id.'/move'), ['destination_id' => $target->id], ['If-Match' => $renamed->headers->get('ETag')])
+        ->assertOk()->assertJsonPath('data.parent_id', $target->id);
+
+    $this->postJson(V1::url('nodes/'.$file->id.'/copy'), ['destination_id' => $target->id])
+        ->assertCreated()->assertJsonPath('data.name', 'new (2).txt');
+    $this->postJson(V1::url('nodes/'.$file->id.'/copy'), ['destination_id' => $target->id, 'name' => 'named.txt'])
+        ->assertCreated()->assertJsonPath('data.name', 'named.txt');
+});
+
+it('refuses a move onto a taken name unless on_conflict=rename', function (): void {
+    $file = V1::file($this->drive, 'same.txt');
+    $target = V1::folder($this->drive, 'Target');
+    V1::file($this->drive, 'same.txt', parent: $target->id);
+
+    $this->postJson(V1::url('nodes/'.$file->id.'/move'), ['destination_id' => $target->id], ['If-Match' => DriveV1::etag($this, $file->id)])
+        ->assertStatus(409);
+    $this->postJson(V1::url('nodes/'.$file->id.'/move'), ['destination_id' => $target->id, 'on_conflict' => 'rename'], ['If-Match' => DriveV1::etag($this, $file->id)])
+        ->assertOk()->assertJsonPath('data.name', 'same (2).txt');
+});
+
+it('searches a drive by name', function (): void {
+    V1::file($this->drive, 'quarterly-report.txt');
+    V1::file($this->drive, 'notes.txt');
+
+    $this->getJson(V1::url('drives/'.$this->driveId.'/search?q=report'))
+        ->assertOk()
+        ->assertJsonCount(1, 'data')
+        ->assertJsonPath('data.0.name', 'quarterly-report.txt');
+    $this->getJson(V1::url('drives/'.$this->driveId.'/search'))->assertStatus(422);
+});
+
+it('shows abilities and explains them only to a manager', function (): void {
+    $file = V1::file($this->drive, 'x.txt');
+    AccessTestHelpers::grant(DriveTestHelpers::model($file), RoleRegistry::READER, subjectId: 2);
+
+    $this->getJson(V1::url('nodes/'.$file->id.'/abilities?explain=edit'))
+        ->assertOk()
+        ->assertJsonPath('data.abilities.manage', true)
+        ->assertJsonPath('data.explain.ability', 'edit')
+        ->assertJsonPath('data.explain.allowed', true);
+
+    $this->actingAs(V1::user(2));
+    $this->getJson(V1::url('nodes/'.$file->id.'/abilities'))
+        ->assertOk()
+        ->assertJsonPath('data.abilities.view', true)
+        ->assertJsonPath('data.abilities.edit', false)
+        ->assertJsonPath('data.explain', null);
+    $this->getJson(V1::url('nodes/'.$file->id.'/abilities?explain=edit'))->assertForbidden()->assertJsonPath('code', 'permission_denied');
+    $this->getJson(V1::url('nodes/'.$file->id.'/abilities?explain=fly'))->assertStatus(422);
+});
+
+it('lists what was shared with the caller across drives, with its abilities', function (): void {
+    $file = V1::file($this->drive, 'for-two.txt');
+    AccessTestHelpers::grant(DriveTestHelpers::model($file), RoleRegistry::READER, subjectId: 2);
+    $this->actingAs(V1::user(2));
+
+    $this->getJson(V1::url('shared'))
+        ->assertOk()
+        ->assertJsonPath('data.0.id', $file->id)
+        ->assertJsonPath('data.0.abilities.view', true)
+        ->assertJsonPath('data.0.abilities.edit', false)
+        ->assertJsonPath('meta.next_cursor', null);
+});
+
+it('refuses the shared listing with 403 profile_restriction when grants are off', function (): void {
+    config()->set('vaulter.features.grants', false);
+
+    $this->getJson(V1::url('shared'))->assertForbidden()->assertJsonPath('code', 'profile_restriction');
+});
diff --git a/packages/drive/tests/Http/NotModifiedV1Test.php b/packages/drive/tests/Http/NotModifiedV1Test.php
