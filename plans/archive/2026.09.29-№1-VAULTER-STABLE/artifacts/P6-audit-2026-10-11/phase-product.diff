--- /dev/null
+++ b/packages/documents/src/Http/Controllers/Collaboration/CreateCollaborationSessionController.php
@@ -0,0 +1,30 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Vaulter\Documents\Http\Controllers\Collaboration;
+
+use Illuminate\Http\JsonResponse;
+use Vaulter\Documents\DocumentsManager;
+use Vaulter\Documents\Http\Requests\CreateCollaborationSessionRequest;
+use Vaulter\Documents\Http\Resources\CollaborationSessionResource;
+use Vaulter\Http\Support\HttpOperationContextFactory;
+use Vaulter\Http\Support\HttpResourceResolver;
+
+/**
+ * Join a document's realtime room: a session for its current generation, read-write for
+ * an editor and read-only for everyone who may view it (View). A client whose editor
+ * speaks another schema version than the document's type gets a read-only session.
+ */
+final readonly class CreateCollaborationSessionController
+{
+    public function __construct(private HttpResourceResolver $resolver, private HttpOperationContextFactory $contexts, private DocumentsManager $documents) {}
+
+    public function __invoke(CreateCollaborationSessionRequest $request, string $node): JsonResponse
+    {
+        $drive = $this->contexts->forDrive($request, $this->resolver->driveOfNode($node));
+        $session = $this->documents->in($drive)->collaborationSession($node, $request->clientSchemaVersion());
+
+        return (new CollaborationSessionResource($session))->response()->setStatusCode(201);
+    }
+}
diff --git a/packages/documents/src/Http/Controllers/Collaboration/HubAuthenticateController.php b/packages/documents/src/Http/Controllers/Collaboration/HubAuthenticateController.php
new file mode 100644
index 00000000..69e51773
--- /dev/null
+++ b/packages/documents/src/Http/Controllers/Collaboration/HubAuthenticateController.php
@@ -0,0 +1,37 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Vaulter\Documents\Http\Controllers\Collaboration;
+
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Vaulter\Documents\Collaboration\CollaborationHub;
+use Vaulter\Documents\Http\Middleware\ResolveCollaborationCall;
+
+/**
+ * The hub's onAuthenticate: is the connection allowed, and in which mode, right now.
+ * `allowed: false` (rather than a 403) when the user no longer holds View, so the hub
+ * refuses the socket cleanly. A room of a past generation answers 409
+ * collaboration_epoch_mismatch and the client asks for a new session.
+ */
+final readonly class HubAuthenticateController
+{
+    public function __construct(private CollaborationHub $hub) {}
+
+    public function __invoke(Request $request): JsonResponse
+    {
+        $room = $this->hub->open(ResolveCollaborationCall::call($request), $request->input('room'));
+
+        if ($room->ability === null) {
+            return new JsonResponse(['allowed' => false, 'mode' => 'ro', 'userId' => null]);
+        }
+
+        return new JsonResponse([
+            'allowed' => true,
+            'mode' => $room->mode(),
+            'userId' => $room->userId,
+            'epoch' => $room->document->collab_epoch,
+        ]);
+    }
+}
