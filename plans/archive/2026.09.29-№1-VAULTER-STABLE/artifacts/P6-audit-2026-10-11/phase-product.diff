+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Support\Facades\Route;
+use Vaulter\Configuration\RoutesConfig;
+use Vaulter\Exceptions\Nodes\NodeNotFoundException;
+
+it('leaves host routes without problem+json and without Vaulter headers', function (): void {
+    Route::get('/host/boom', static function (): never {
+        throw NodeNotFoundException::forId(1);
+    });
+
+    $response = $this->getJson('/host/boom');
+
+    expect($response->headers->get('Content-Type'))->not->toContain('problem+json')
+        ->and($response->headers->has('X-Vaulter-Api-Version'))->toBeFalse()
+        ->and($response->headers->has('X-Request-Id'))->toBeFalse();
+
+    $this->get('/host/missing', ['Accept' => 'application/json'])
+        ->assertNotFound()
+        ->assertHeaderMissing('X-Vaulter-Api-Version');
+});
+
+it('leaves a path that is not the v1 surface to the host exception handler', function (): void {
+    $prefix = trim(app(RoutesConfig::class)->prefix(), '/');
+    // `v10` is not the `v1` surface, and nothing else under the prefix is Vaulter's any more.
+    foreach ([$prefix.'/__unversioned', $prefix.'/v10/__unversioned'] as $path) {
+        Route::get($path, static function (): never {
+            throw NodeNotFoundException::forId(1);
+        });
+
+        $response = $this->getJson($path)->assertStatus(500);
+
+        expect($response->headers->get('Content-Type'))->not->toContain('problem+json')
+            ->and($response->headers->has('X-Vaulter-Api-Version'))->toBeFalse();
+    }
+});
diff --git a/packages/core/tests/Http/Problems/ProblemCatalogLangTest.php b/packages/core/tests/Http/Problems/ProblemCatalogLangTest.php
new file mode 100644
index 00000000..1ae8b813
--- /dev/null
+++ b/packages/core/tests/Http/Problems/ProblemCatalogLangTest.php
@@ -0,0 +1,90 @@
+<?php
+
+declare(strict_types=1);
+
+use Vaulter\Documents\Http\Problems\DocumentsProblemCodes;
+use Vaulter\Drive\Http\Problems\DriveProblemCodes;
+use Vaulter\Exceptions\Contracts\ProblemException;
+use Vaulter\Http\Problems\CoreProblemCodes;
+use Vaulter\Http\Problems\ProblemCatalog;
+
+/**
+ * The catalogue of the whole monorepo: core plus the drive and documents sources, with
+ * their lang namespaces added by path so the check does not depend on which providers
+ * this suite boots.
+ */
+function fullProblemCatalog(): ProblemCatalog
+{
+    $root = dirname(__DIR__, 5).'/packages';
+    $translator = app('translator');
+    $translator->addNamespace('vaulter', $root.'/core/resources/lang');
+    $translator->addNamespace('vaulter-drive', $root.'/drive/resources/lang');
+    $translator->addNamespace('vaulter-documents', $root.'/documents/resources/lang');
+
+    return new ProblemCatalog(
+        static fn (): array => [new CoreProblemCodes, new DriveProblemCodes, new DocumentsProblemCodes],
+        $translator,
+    );
+}
+
+it('has an English and a Russian title for every code', function (string $locale): void {
+    $catalog = fullProblemCatalog();
+
+    foreach ($catalog->all() as $code => $entry) {
+        expect($catalog->title($code, $locale))->toBeString()->not->toBe('', $locale.' '.$code);
+        if ($code !== 'internal_error') {
+            expect($catalog->detail($code, [], $locale))->toBeString($locale.' detail '.$code);
+        }
+    }
+})->with(['en', 'ru']);
+
+it('keeps the lang files of a package in step with its code list', function (string $package, string $source): void {
+    $codes = array_keys((new $source)->codes());
+    sort($codes);
+
+    foreach (['en', 'ru'] as $locale) {
+        $lines = require dirname(__DIR__, 5)."/packages/{$package}/resources/lang/{$locale}/problems.php";
+        $keys = array_keys($lines);
+        sort($keys);
+
+        expect($keys)->toBe($codes);
+    }
+})->with([
+    'core' => ['core', CoreProblemCodes::class],
+    'drive' => ['drive', DriveProblemCodes::class],
+    'documents' => ['documents', DocumentsProblemCodes::class],
+]);
+
+it('lists the code and status of every ProblemException in the source tree', function (): void {
+    $catalog = fullProblemCatalog()->all();
+    $files = glob(dirname(__DIR__, 5).'/packages/{core,drive,documents}/src/Exceptions/{,*/}*.php', GLOB_BRACE) ?: [];
+    $seen = 0;
+
+    foreach ($files as $file) {
+        $source = (string) file_get_contents($file);
+        if (preg_match('/^namespace ([^;]+);.*?^(?:final )?class (\w+)[^{]*implements[^{]*ProblemException/ms', $source, $match) !== 1) {
+            continue;
+        }
+        /** @var ProblemException $exception */
+        $exception = (new ReflectionClass($match[1].'\\'.$match[2]))->newInstanceWithoutConstructor();
+        $seen++;
+
+        expect($catalog)->toHaveKey($exception->problemCode())
+            ->and($catalog[$exception->problemCode()]['status'])->toBe($exception->httpStatus(), $exception::class);
+    }
+
+    expect($seen)->toBeGreaterThan(50);
+});
+
+it('claims a code once, core first', function (): void {
+    $catalog = fullProblemCatalog()->all();
+
+    $codes = array_keys($catalog);
+    $sorted = $codes;
+    sort($sorted);
+
+    expect($codes)->toBe($sorted)
+        ->and($catalog['duplicate_registration']['package'])->toBe('core')
+        ->and($catalog['upload_conflict']['package'])->toBe('drive')
+        ->and($catalog['document_state_mismatch']['package'])->toBe('documents');
+});
diff --git a/packages/core/tests/Http/Problems/ProblemMetaRedactionTest.php b/packages/core/tests/Http/Problems/ProblemMetaRedactionTest.php
new file mode 100644
index 00000000..9de0a07c
--- /dev/null
+++ b/packages/core/tests/Http/Problems/ProblemMetaRedactionTest.php
@@ -0,0 +1,143 @@
+<?php
+
+declare(strict_types=1);
+
+use Psr\Log\AbstractLogger;
+use Psr\Log\LoggerInterface;
+use Vaulter\Exceptions\Concerns\ProvidesProblemDetails;
+use Vaulter\Exceptions\Contracts\ProblemException;
+use Vaulter\Exceptions\Policy\FileSizeLimitExceededException;
+use Vaulter\Exceptions\VaulterException;
+use Vaulter\Http\Problems\ProblemRenderer;
+use Vaulter\Tests\Support\ProblemProbeRoutes;
+
+it('drops forbidden meta keys at any depth and logs a warning without the values', function (): void {
+    $logger = new class extends AbstractLogger
+    {
+        /** @var list<array{level: mixed, message: string, context: array<string, mixed>}> */
+        public array $records = [];
+
+        public function log($level, string|Stringable $message, array $context = []): void
+        {
+            $this->records[] = ['level' => $level, 'message' => (string) $message, 'context' => $context];
+        }
+    };
+    $this->app->instance(LoggerInterface::class, $logger);
+    $this->app->forgetInstance(ProblemRenderer::class);
+
+    $probe = new class('leaky') extends VaulterException implements ProblemException
+    {
+        use ProvidesProblemDetails;
+
+        public function problemCode(): string
+        {
+            return 'concurrent_update';
+        }
+
+        public function httpStatus(): int
+        {
+            return 409;
+        }
+
+        public function problemDetails(): array
+        {
+            return [
+                'path' => '/srv/storage/a',
+                'token' => 'tok-123',
+                'reason' => 'kept',
+                'nested' => ['secret' => 'hunter2', 'ok' => 1, 'SQL' => 'select 1'],
+            ];
+        }
+    };
+    ProblemProbeRoutes::register(['leaky' => $probe]);
+
+    $response = $this->getJson(ProblemProbeRoutes::path('leaky'))->assertStatus(409);
+
+    expect($response->json('meta'))->toBe(['reason' => 'kept', 'nested' => ['ok' => 1]])
+        ->and($response->getContent())->not->toContain('hunter2')->not->toContain('/srv/storage')->not->toContain('tok-123');
+
+    $warnings = array_values(array_filter($logger->records, static fn (array $record): bool => $record['level'] === 'warning'));
+    expect($warnings)->toHaveCount(1)
+        ->and($warnings[0]['context']['code'])->toBe('concurrent_update')
+        ->and($warnings[0]['context']['keys'])->toBe(['path', 'token', 'nested.secret', 'nested.SQL'])
+        ->and(json_encode($warnings[0]))->not->toContain('hunter2');
+});
+
+it('does not log when the meta is clean', function (): void {
+    $logger = new class extends AbstractLogger
+    {
+        public int $warnings = 0;
+
+        public function log($level, string|Stringable $message, array $context = []): void
+        {
+            $this->warnings += $level === 'warning' ? 1 : 0;
+        }
+    };
+    $this->app->instance(LoggerInterface::class, $logger);
+    $this->app->forgetInstance(ProblemRenderer::class);
+    ProblemProbeRoutes::register(['limit' => FileSizeLimitExceededException::forLimit(1)]);
+
+    $this->getJson(ProblemProbeRoutes::path('limit'))->assertStatus(413);
+
+    expect($logger->warnings)->toBe(0);
+});
+
+it('redacts objects, nested lists and any leaf that carries the exception message', function (): void {
+    $probe = new class('[Vaulter] boom path=/tmp/x') extends VaulterException implements ProblemException
+    {
+        use ProvidesProblemDetails;
+
+        public function problemCode(): string
+        {
+            return 'concurrent_update';
+        }
+
+        public function httpStatus(): int
+        {
+            return 409;
+        }
+
+        public function problemDetails(): array
+        {
+            return [
+                'context' => (object) ['secret' => 'object-secret', 'ok' => 2],
+                'items' => [['token' => 'list-token-secret'], ['ok' => 1]],
+                'note' => ['url' => ['[Vaulter] boom path=/tmp/x']],
+            ];
+        }
+    };
+    ProblemProbeRoutes::register(['leaky' => $probe]);
+
+    $response = $this->getJson(ProblemProbeRoutes::path('leaky'))->assertStatus(409);
+
+    expect($response->json('meta'))->toBe(['context' => ['ok' => 2], 'items' => [[], ['ok' => 1]], 'note' => ['url' => []]])
+        ->and($response->getContent())->not->toContain('object-secret')->not->toContain('list-token-secret')->not->toContain('/tmp/x');
+});
+
+it('treats the errors key of problemDetails() case-insensitively as the field map', function (): void {
+    $probe = new class('[Vaulter] hidden') extends VaulterException implements ProblemException
+    {
+        use ProvidesProblemDetails;
+
+        public function problemCode(): string
+        {
+            return 'validation_failed';
+        }
+
+        public function httpStatus(): int
+        {
+            return 422;
+        }
+
+        public function problemDetails(): array
+        {
+            return ['Errors' => ['name' => ['[Vaulter] hidden']]];
+        }
+    };
+    ProblemProbeRoutes::register(['mixed' => $probe]);
+
+    $this->getJson(ProblemProbeRoutes::path('mixed'))
+        ->assertStatus(422)
+        ->assertJsonPath('errors', ['name' => ['The request data is invalid; see the errors field.']])
+        ->assertJsonPath('meta', []);
+});
diff --git a/packages/core/tests/Http/Problems/ProblemRendererTest.php b/packages/core/tests/Http/Problems/ProblemRendererTest.php
new file mode 100644
index 00000000..f202562b
--- /dev/null
+++ b/packages/core/tests/Http/Problems/ProblemRendererTest.php
@@ -0,0 +1,179 @@
+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Auth\AuthenticationException;
+use Illuminate\Http\Exceptions\ThrottleRequestsException;
+use Illuminate\Http\Request;
+use Illuminate\Validation\ValidationException;
+use Vaulter\Configuration\RoutesConfig;
+use Vaulter\Exceptions\Database\ConcurrentUpdateException;
+use Vaulter\Exceptions\Http\PreconditionRequiredException;
+use Vaulter\Exceptions\Nodes\NodeNameConflictException;
+use Vaulter\Exceptions\Policy\FileSizeLimitExceededException;
+use Vaulter\Http\Problems\ProblemCatalog;
+use Vaulter\Http\Problems\ProblemRenderer;
+use Vaulter\Tests\Support\ProblemProbeRoutes;
+
+const PROBLEM_TYPE_BASE = 'https://github.com/axiomasoft/vaulter/blob/main/docs/reference/errors.md#';
+
+it('renders a domain exception as problem+json with the catalogue title and a request id', function (): void {
+    ProblemProbeRoutes::register(['conflict' => NodeNameConflictException::forName('contract.pdf', null)]);
+
+    $response = $this->getJson(ProblemProbeRoutes::path('conflict'))
+        ->assertStatus(409)
+        ->assertHeader('Content-Type', 'application/problem+json')
+        ->assertHeader('Content-Language', 'en')
+        ->assertHeader('X-Vaulter-Api-Version', '1')
+        ->assertJsonPath('type', PROBLEM_TYPE_BASE.'node_name_conflict')
+        ->assertJsonPath('title', 'Node name conflict')
+        ->assertJsonPath('status', 409)
+        ->assertJsonPath('code', 'node_name_conflict')
+        ->assertJsonPath('detail', 'A node with this name already exists in the folder.')
+        ->assertJsonPath('errors.name', ['A node with this name already exists in the folder.']);
+
+    expect($response->headers->get('Cache-Control'))->toContain('no-store')
+        ->and($response->json('request_id'))->toBe($response->headers->get('X-Request-Id'))
+        ->and($response->json('meta'))->toBe([])
+        ->and(array_keys($response->json()))->toBe(['type', 'title', 'status', 'code', 'detail', 'request_id', 'errors', 'meta']);
+    // The exception message is written for logs; it must never reach a client.
+    expect($response->getContent())->not->toContain('[Vaulter]')->not->toContain('contract.pdf');
+});
+
+it('localizes title and detail but never the code', function (): void {
+    app()->setLocale('ru');
+    ProblemProbeRoutes::register(['conflict' => NodeNameConflictException::forName('a', null)]);
+
+    $this->getJson(ProblemProbeRoutes::path('conflict'))
+        ->assertStatus(409)
+        ->assertHeader('Content-Language', 'ru')
+        ->assertJsonPath('code', 'node_name_conflict')
+        ->assertJsonPath('title', 'Конфликт имени узла')
+        ->assertJsonPath('detail', 'Узел с таким именем уже есть в папке.');
+});
+
+it('carries problemDetails() as meta and fills detail placeholders from it', function (): void {
+    ProblemProbeRoutes::register(['size' => FileSizeLimitExceededException::forLimit(5)]);
+
+    $this->getJson(ProblemProbeRoutes::path('size'))
+        ->assertStatus(413)
+        ->assertJsonPath('code', 'file_size_limit_exceeded')
+        ->assertJsonPath('meta.limit', 5)
+        ->assertJsonPath('detail', 'The file exceeds the limit of 5 bytes.')
+        ->assertJsonPath('errors', null);
+});
+
+it('answers a failed precondition with 428 and names the header', function (): void {
+    ProblemProbeRoutes::register([
+        'missing' => PreconditionRequiredException::missing('If-Match'),
+        'wildcard' => PreconditionRequiredException::wildcard(),
+    ]);
+
+    $this->getJson(ProblemProbeRoutes::path('missing'))
+        ->assertStatus(428)
+        ->assertJsonPath('code', 'precondition_required')
+        ->assertJsonPath('meta', ['header' => 'If-Match', 'reason' => 'missing'])
+        ->assertJsonPath('detail', 'The If-Match header is required for this request.');
+    $this->getJson(ProblemProbeRoutes::path('wildcard'))
+        ->assertStatus(428)
+        ->assertJsonPath('meta.reason', 'wildcard_not_allowed');
+});
+
+it('keeps the headers an exception asks for', function (): void {
+    ProblemProbeRoutes::register(['concurrent' => new ConcurrentUpdateException]);
+
+    $this->getJson(ProblemProbeRoutes::path('concurrent'))
+        ->assertStatus(409)
+        ->assertJsonPath('code', 'concurrent_update')
+        ->assertHeader('Retry-After', '1');
+});
+
+it('renders a validation failure with the Laravel error map', function (): void {
+    ProblemProbeRoutes::register(['invalid' => ValidationException::withMessages(['name' => ['The name field is required.']])]);
+
+    $this->getJson(ProblemProbeRoutes::path('invalid'))
+        ->assertStatus(422)
+        ->assertJsonPath('code', 'validation_failed')
+        ->assertJsonPath('errors', ['name' => ['The name field is required.']]);
+});
+
+it('forwards Retry-After on a throttled request', function (): void {
+    ProblemProbeRoutes::register(['throttle' => new ThrottleRequestsException('Too Many Attempts.', null, ['Retry-After' => '30', 'X-RateLimit-Limit' => '60'])]);
+
+    $response = $this->getJson(ProblemProbeRoutes::path('throttle'))
+        ->assertStatus(429)
+        ->assertJsonPath('code', 'rate_limited')
+        ->assertHeader('Retry-After', '30');
+
+    expect($response->headers->has('X-RateLimit-Limit'))->toBeFalse();
+});
+
+it('hides an unexpected failure behind internal_error', function (): void {
+    ProblemProbeRoutes::register(['boom' => new RuntimeException('SQLSTATE[HY000]: password=hunter2 at /srv/app/secret.php')]);
+
+    $response = $this->getJson(ProblemProbeRoutes::path('boom'))
+        ->assertStatus(500)
+        ->assertJsonPath('code', 'internal_error')
+        ->assertJsonPath('title', 'Internal server error')
+        ->assertJsonPath('detail', null);
+
+    expect($response->getContent())->not->toContain('hunter2')->not->toContain('SQLSTATE')->not->toContain('/srv/app');
+});
+
+it('answers a wrong method with 405 and the Allow header', function (): void {
+    ProblemProbeRoutes::register(['any' => new RuntimeException]);
+
+    $this->postJson(ProblemProbeRoutes::path('any'))
+        ->assertStatus(405)
+        ->assertHeader('Content-Type', 'application/problem+json')
+        ->assertJsonPath('code', 'method_not_allowed')
+        ->assertHeader('Allow');
+});
+
+it('answers an unknown path under the versioned prefix with route_not_found', function (): void {
+    $prefix = app(RoutesConfig::class)->versionedPrefix();
+
+    $this->getJson($prefix.'/x')
+        ->assertStatus(404)
+        ->assertHeader('Content-Type', 'application/problem+json')
+        ->assertJsonPath('code', 'route_not_found')
+        ->assertHeader('X-Vaulter-Api-Version', '1');
+});
+
+it('keeps a valid incoming request id and replaces a malformed one', function (): void {
+    ProblemProbeRoutes::register(['boom' => new RuntimeException]);
+
+    $this->getJson(ProblemProbeRoutes::path('boom'), ['X-Request-Id' => 'client-req-42'])
+        ->assertHeader('X-Request-Id', 'client-req-42')
+        ->assertJsonPath('request_id', 'client-req-42');
+
+    $replaced = $this->getJson(ProblemProbeRoutes::path('boom'), ['X-Request-Id' => "bad id\twith spaces"]);
+    expect($replaced->json('request_id'))->toMatch('/^[0-9A-HJKMNP-TV-Z]{26}$/')
+        ->and($replaced->headers->get('X-Request-Id'))->toBe($replaced->json('request_id'));
+});
+
+it('prefers the request id the correlation middleware assigned', function (): void {
+    $request = Request::create(ProblemProbeRoutes::path('boom'), 'GET');
+    $request->attributes->set('vaulter.request_id', 'assigned-1');
+    $renderer = app(ProblemRenderer::class);
+
+    $response = $renderer->render(new RuntimeException, $request);
+
+    expect($response->headers->get('X-Request-Id'))->toBe('assigned-1');
+});
+
+it('maps an authentication failure to actor_required', function (): void {
+    ProblemProbeRoutes::register(['guest' => new AuthenticationException]);
+
+    $this->getJson(ProblemProbeRoutes::path('guest'))
+        ->assertStatus(401)
+        ->assertJsonPath('code', 'actor_required');
+});
+
+it('knows every status it can answer with in the catalogue', function (): void {
+    $catalog = app(ProblemCatalog::class);
+
+    foreach (['validation_failed', 'rate_limited', 'internal_error', 'route_not_found', 'method_not_allowed', 'payload_too_large', 'precondition_required'] as $code) {
+        expect($catalog->has($code))->toBeTrue($code);
+    }
+});
diff --git a/packages/core/tests/Http/PublicShareHeadersV1Test.php b/packages/core/tests/Http/PublicShareHeadersV1Test.php
new file mode 100644
index 00000000..b0cf9fcb
--- /dev/null
+++ b/packages/core/tests/Http/PublicShareHeadersV1Test.php
@@ -0,0 +1,62 @@
+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Storage;
+use Vaulter\Contracts\Observability\MetricsRecorder;
+use Vaulter\Testing\FakeMetricsRecorder;
+use Vaulter\Tests\Drive\DriveTestHelpers;
+use Vaulter\Tests\Http\V1;
+use Vaulter\Tests\Sharing\ShareTestHelpers;
+
+/**
+ * A share token is a bearer secret in the URL: no public share response may be stored
+ * or leak the URL through a Referer, and the token is never part of a metric label.
+ */
+uses(RefreshDatabase::class);
+
+beforeEach(function (): void {
+    Storage::fake('local');
+    config()->set('vaulter.features.share_links', true);
+});
+
+it('sends private, no-store and no-referrer on every public answer, the throttle included', function (): void {
+    config()->set('vaulter.routes.rate_limits.public', 3);
+    $file = V1::file(V1::drive(), 'h.txt', 'header bytes');
+    ShareTestHelpers::share(DriveTestHelpers::model($file), token: 'headers-v1');
+
+    $responses = [
+        $this->getJson(V1::url('shares/headers-v1'))->assertOk(),
+        $this->get(V1::url('shares/headers-v1/download'))->assertOk(),
+        $this->getJson(V1::url('shares/wrong-token'))->assertNotFound(),
+        $this->getJson(V1::url('shares/headers-v1'))->assertStatus(429),
+    ];
+
+    foreach ($responses as $response) {
+        expect($response->headers->get('Cache-Control'))->toContain('private')->toContain('no-store')
+            ->and($response->headers->get('Referrer-Policy'))->toBe('no-referrer')
+            ->and($response->headers->get('X-Vaulter-Api-Version'))->toBe('1')
+            ->and($response->headers->get('X-Request-Id'))->toBeString();
+    }
+    expect($responses[1]->headers->get('X-Content-Type-Options'))->toBe('nosniff')
+        ->and($responses[1]->headers->get('Content-Security-Policy'))->toBe("sandbox; default-src 'none'")
+        ->and($responses[1]->headers->get('Content-Disposition'))->toContain('h.txt');
+});
+
+it('labels public share metrics by route name, never by the token', function (): void {
+    config()->set('vaulter.observability.enabled', true);
+    config()->set('vaulter.observability.recorder', FakeMetricsRecorder::class);
+    $this->app->forgetInstance(MetricsRecorder::class);
+    $file = V1::file(V1::drive(), 'm.txt', 'metric bytes');
+    ShareTestHelpers::share(DriveTestHelpers::model($file), token: 'metric-secret-token');
+
+    $this->get(V1::url('shares/metric-secret-token/download'))->assertOk();
+
+    $emissions = app(MetricsRecorder::class)->emissions();
+    $durations = array_values(array_filter($emissions, static fn (array $emission): bool => $emission['name'] === 'vaulter_http_request_duration_seconds'));
+
+    expect($durations)->toHaveCount(1)
+        ->and($durations[0]['labels']['operation'])->toBe('download')
+        ->and(json_encode($emissions))->not->toContain('metric-secret-token');
+});
diff --git a/packages/core/tests/Http/PublicSharesV1Test.php b/packages/core/tests/Http/PublicSharesV1Test.php
new file mode 100644
index 00000000..e1e3575d
--- /dev/null
+++ b/packages/core/tests/Http/PublicSharesV1Test.php
@@ -0,0 +1,92 @@
+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Storage;
+use Vaulter\Access\Roles\RoleRegistry;
+use Vaulter\Database\VaulterDatabase;
+use Vaulter\Enums\Access\GrantScope;
+use Vaulter\Enums\Sharing\ShareAudience;
+use Vaulter\Http\Resources\Sharing\SharedNodeResource;
+use Vaulter\Tests\Drive\DriveTestHelpers;
+use Vaulter\Tests\Http\V1;
+use Vaulter\Tests\Sharing\ShareTestHelpers;
+
+/**
+ * The public share routes: the link's own role on its node-set, opaque node ids, one
+ * level of listing for a subtree link, and problem+json denials that do not tell a bad
+ * token from a revoked one.
+ */
+uses(RefreshDatabase::class);
+
+beforeEach(function (): void {
+    Storage::fake('local');
+    config()->set('vaulter.features.share_links', true);
+    $this->drive = V1::drive(userId: 1);
+});
+
+it('shows the shared node by opaque id and lists a subtree link page by page', function (): void {
+    $folder = V1::folder($this->drive, 'album');
+    foreach (['a.txt', 'b.txt', 'c.txt'] as $name) {
+        V1::file($this->drive, $name, $name, parent: $folder->id);
+    }
+    ShareTestHelpers::share(DriveTestHelpers::model($folder), token: 'subtree-v1', scope: GrantScope::Subtree);
+
+    $this->getJson(V1::url('shares/subtree-v1'))
+        ->assertOk()
+        ->assertJsonPath('data.id', SharedNodeResource::opaqueId($folder->id))
+        ->assertJsonPath('data.name', 'album')
+        ->assertJsonPath('data.children', null);
+
+    $first = $this->getJson(V1::url('shares/subtree-v1/nodes?per_page=2'))->assertOk();
+    expect(array_column($first->json('data'), 'name'))->toBe(['a.txt', 'b.txt'])
+        ->and($first->json('meta.per_page'))->toBe(2);
+    $rest = $this->getJson(V1::url('shares/subtree-v1/nodes?per_page=2&cursor='.urlencode($first->json('meta.next_cursor'))))->assertOk();
+    expect(array_column($rest->json('data'), 'name'))->toBe(['c.txt'])
+        ->and($rest->json('meta.next_cursor'))->toBeNull();
+});
+
+it('downloads a listed child by its opaque id and refuses any other id', function (): void {
+    $folder = V1::folder($this->drive, 'docs');
+    $inside = V1::file($this->drive, 'inside.txt', 'inside bytes', parent: $folder->id);
+    $outside = V1::file($this->drive, 'outside.txt', 'outside bytes');
+    ShareTestHelpers::share(DriveTestHelpers::model($folder), token: 'pick-v1', scope: GrantScope::Subtree);
+
+    $response = $this->get(V1::url('shares/pick-v1/download?node='.SharedNodeResource::opaqueId($inside->id)))->assertOk();
+    expect($response->streamedContent())->toBe('inside bytes');
+
+    foreach ([SharedNodeResource::opaqueId($outside->id), $inside->id, 'garbage'] as $node) {
+        $this->getJson(V1::url('shares/pick-v1/download?node='.$node))->assertNotFound()->assertJsonPath('code', 'share_not_found');
+    }
+    // The folder itself has no bytes.
+    $this->getJson(V1::url('shares/pick-v1/download'))->assertNotFound()->assertJsonPath('code', 'share_not_found');
+});
+
+it('lists nothing for an item link and downloads only its own file', function (): void {
+    $file = V1::file($this->drive, 'single.txt', 'single bytes');
+    ShareTestHelpers::share(DriveTestHelpers::model($file), token: 'item-v1');
+
+    $this->getJson(V1::url('shares/item-v1/nodes'))->assertNotFound()->assertJsonPath('code', 'share_not_found');
+    expect($this->get(V1::url('shares/item-v1/download'))->assertOk()->streamedContent())->toBe('single bytes');
+});
+
+it('denies with problem+json: bad token, previewer download, password, sign-in', function (): void {
+    $file = V1::file($this->drive, 'x.txt', 'x');
+    $model = DriveTestHelpers::model($file);
+    ShareTestHelpers::share($model, token: 'preview-v1', role: RoleRegistry::PREVIEWER);
+    ShareTestHelpers::share($model, token: 'login-v1', audience: ShareAudience::Authenticated);
+
+    $this->getJson(V1::url('shares/no-such-token'))->assertNotFound()->assertHeader('Content-Type', 'application/problem+json')->assertJsonPath('code', 'share_not_found');
+    $this->getJson(V1::url('shares/preview-v1/download'))->assertForbidden()->assertJsonPath('code', 'permission_denied');
+    $this->getJson(V1::url('shares/login-v1'))->assertUnauthorized()->assertJsonPath('code', 'actor_required');
+});
+
+it('answers 423 before any byte for a quarantined file', function (): void {
+    $file = V1::file($this->drive, 'bad.txt', 'bad');
+    $revision = DriveTestHelpers::model($file)->file()->firstOrFail()->currentRevision()->firstOrFail();
+    app(VaulterDatabase::class)->write(static fn () => $revision->forceFill(['scan_status' => 'infected'])->save());
+    ShareTestHelpers::share(DriveTestHelpers::model($file), token: 'quarantine-v1');
+
+    $this->getJson(V1::url('shares/quarantine-v1/download'))->assertStatus(423)->assertJsonPath('code', 'content_unavailable');
+});
diff --git a/packages/core/tests/Http/RepresentationTagTest.php b/packages/core/tests/Http/RepresentationTagTest.php
new file mode 100644
index 00000000..d6e8772a
--- /dev/null
+++ b/packages/core/tests/Http/RepresentationTagTest.php
@@ -0,0 +1,58 @@
+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Http\Request;
+use Vaulter\Access\Roles\RoleRegistry;
+use Vaulter\Http\Resources\Drive\NodeResource;
+use Vaulter\Http\Support\RepresentationTag;
+use Vaulter\Tests\Access\AccessTestHelpers;
+use Vaulter\Tests\Drive\DriveTestHelpers;
+use Vaulter\Tests\Http\V1;
+
+/**
+ * The node tag hashes the caller's whole representation: key order does not matter,
+ * anything the caller receives does.
+ */
+uses(RefreshDatabase::class);
+
+it('ignores key order at every depth', function (): void {
+    $a = ['id' => 'n', 'abilities' => ['view' => true, 'download' => false], 'properties' => ['b' => ['y' => '1', 'x' => '2']]];
+    $b = ['properties' => ['b' => ['x' => '2', 'y' => '1']], 'abilities' => ['download' => false, 'view' => true], 'id' => 'n'];
+
+    expect(RepresentationTag::node($a, 'n', 3))->toBe(RepresentationTag::node($b, 'n', 3))
+        ->toMatch('/^"n\.3\.[0-9a-f]{16}"$/');
+});
+
+it('changes when an embedded ability changes although the sequence does not', function (): void {
+    $base = ['id' => 'n', 'abilities' => ['view' => true, 'download' => true]];
+    $without = ['id' => 'n', 'abilities' => ['view' => true, 'download' => false]];
+
+    expect(RepresentationTag::node($base, 'n', 7))->not->toBe(RepresentationTag::node($without, 'n', 7));
+});
+
+it('keeps an empty object and an empty list apart', function (): void {
+    expect(RepresentationTag::canonical(['properties' => new stdClass, 'list' => []]))->toBe('{"list":[],"properties":{}}')
+        ->and(RepresentationTag::node(['p' => new stdClass], 'n', 1))->not->toBe(RepresentationTag::node(['p' => []], 'n', 1));
+});
+
+it('formats the document content tag from the content generation only', function (): void {
+    expect(RepresentationTag::document('doc', 3, 12))->toBe('"doc.3.12"');
+});
+
+it('serializes empty node properties as {} and tags the node per caller', function (): void {
+    $drive = V1::drive(userId: 1, role: RoleRegistry::OWNER);
+    $folder = V1::folder($drive, 'tagged');
+    AccessTestHelpers::grant(DriveTestHelpers::model($folder), RoleRegistry::READER, subjectId: 2);
+
+    $owner = $drive->actingAs(V1::user(1))->nodes();
+    $reader = $drive->actingAs(V1::user(2))->nodes();
+    $asOwner = new NodeResource($owner->find($folder->id), $owner->abilities($folder->id));
+    $asReader = new NodeResource($reader->find($folder->id), $reader->abilities($folder->id));
+
+    expect(json_encode($asOwner->toArray(new Request)))->toContain('"properties":{}')
+        ->and($asOwner->etag())->toBe($asOwner->toArray(new Request)['etag'])
+        ->and($asOwner->etag())->not->toBe($asReader->etag())
+        ->and(substr($asOwner->etag(), 0, strrpos($asOwner->etag(), '.')))->toBe(substr($asReader->etag(), 0, strrpos($asReader->etag(), '.')));
+});
diff --git a/packages/core/tests/Http/SharesV1Test.php b/packages/core/tests/Http/SharesV1Test.php
new file mode 100644
index 00000000..4fee7dd4
--- /dev/null
+++ b/packages/core/tests/Http/SharesV1Test.php
@@ -0,0 +1,67 @@
+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Vaulter\Access\Roles\RoleRegistry;
+use Vaulter\Models\Sharing\NodeShare;
+use Vaulter\Tests\Http\V1;
+
+/**
+ * Share links over v1: the token and URL appear only in the create and rotate
+ * answers; update changes the policy, rotate replaces the token, revoke ends the link.
+ */
+uses(RefreshDatabase::class);
+
+beforeEach(function (): void {
+    config()->set('vaulter.features.share_links', true);
+    $this->drive = V1::drive(userId: 1);
+    $this->node = V1::folder($this->drive, 'shared');
+    $this->actingAs(V1::user(1));
+    $this->url = V1::url('nodes/'.$this->node->id.'/shares');
+});
+
+it('creates a link and shows its token exactly once', function (): void {
+    $created = $this->postJson($this->url, ['role' => RoleRegistry::READER, 'audience' => 'authenticated', 'max_uses' => 3])
+        ->assertCreated()
+        ->assertJsonPath('data.role', RoleRegistry::READER)
+        ->assertJsonPath('data.audience', 'authenticated')
+        ->assertJsonPath('data.scope', 'item')
+        ->assertJsonPath('data.max_uses', 3)
+        ->assertJsonPath('data.use_count', 0)
+        ->assertJsonPath('data.has_password', false)
+        ->assertJsonPath('data.token_generation', 1)
+        ->assertJsonPath('data.created_by', '1');
+    $token = $created->json('data.token');
+    expect($created->json('data.url'))->toEndWith('/'.$token)
+        ->and(NodeShare::query()->firstOrFail()->token_hash)->toBe(hash('sha256', $token));
+
+    $listed = $this->getJson($this->url)->assertOk()->json('data.0');
+    expect($listed)->not->toHaveKey('token')->not->toHaveKey('url')->not->toHaveKey('token_hash');
+});
+
+it('updates policy, rotates the token and revokes', function (): void {
+    $created = $this->postJson($this->url, ['role' => RoleRegistry::READER])->assertCreated();
+    $id = $created->json('data.id');
+
+    $this->patchJson($this->url.'/'.$id, ['password' => 'secret', 'max_uses' => 5])
+        ->assertOk()
+        ->assertJsonPath('data.has_password', true)
+        ->assertJsonPath('data.max_uses', 5)
+        ->assertJsonMissingPath('data.token');
+
+    $rotated = $this->postJson($this->url.'/'.$id.'/rotate')->assertOk()->assertJsonPath('data.token_generation', 2);
+    expect($rotated->json('data.token'))->not->toBe($created->json('data.token'));
+    $this->getJson(V1::url('shares/'.$created->json('data.token')))->assertNotFound();
+
+    $this->deleteJson($this->url.'/'.$id)->assertNoContent();
+    $this->getJson(V1::url('shares/'.$rotated->json('data.token')))->assertNotFound();
+});
+
+it('refuses a share id of another node and a caller without Share', function (): void {
+    $other = V1::folder($this->drive, 'other');
+    $foreign = $this->postJson(V1::url('nodes/'.$other->id.'/shares'), ['role' => RoleRegistry::READER])->assertCreated();
+
+    $this->postJson($this->url.'/'.$foreign->json('data.id').'/rotate')->assertNotFound();
+    $this->actingAs(V1::user(2))->postJson($this->url, ['role' => RoleRegistry::READER])->assertNotFound();
+});
diff --git a/packages/core/tests/Http/UniformNotFoundV1Test.php b/packages/core/tests/Http/UniformNotFoundV1Test.php
new file mode 100644
index 00000000..5ffda25d
--- /dev/null
+++ b/packages/core/tests/Http/UniformNotFoundV1Test.php
@@ -0,0 +1,75 @@
+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Testing\TestResponse;
+use Vaulter\Access\Roles\RoleRegistry;
+use Vaulter\Database\VaulterDatabase;
+use Vaulter\Enums\Drive\DriveStatus;
+use Vaulter\Tests\Drive\DriveTestHelpers;
+use Vaulter\Tests\Fixtures\TestUser;
+use Vaulter\Tests\Http\V1;
+
+/**
+ * A node or drive the caller may not see answers exactly like one that does not
+ * exist: same status, same code, same body except the request id.
+ */
+uses(RefreshDatabase::class);
+
+function bodyWithoutRequestId(TestResponse $response): array
+{
+    $body = $response->json();
+    unset($body['request_id']);
+
+    return $body;
+}
+
+it('answers an unknown node and an invisible node identically on every node-scoped core route', function (string $method, string $suffix, array $body = []): void {
+    $drive = V1::drive(userId: 1);
+    $hidden = V1::folder($drive, 'hidden');
+    $this->actingAs(V1::user(2));
+
+    $unknown = $this->json($method, V1::url('nodes/no-such-node'.$suffix), $body)->assertNotFound();
+    $invisible = $this->json($method, V1::url('nodes/'.$hidden->id.$suffix), $body)->assertNotFound();
+
+    expect($invisible->json('code'))->toBe('node_not_found')
+        ->and(bodyWithoutRequestId($invisible))->toBe(bodyWithoutRequestId($unknown));
+})->with([
+    'grants.index' => ['GET', '/grants'],
+    'grants.store' => ['POST', '/grants', ['subject' => ['type' => (new TestUser)->getMorphClass(), 'id' => '3'], 'role' => 'reader']],
+    'grants.destroy' => ['DELETE', '/grants/g1'],
+    'inheritance.restrict' => ['POST', '/inheritance/restrict'],
+    'inheritance.restore' => ['POST', '/inheritance/restore'],
+    'shares.index' => ['GET', '/shares'],
+    'shares.store' => ['POST', '/shares', ['role' => 'reader']],
+    'shares.update' => ['PATCH', '/shares/s1'],
+    'shares.rotate' => ['POST', '/shares/s1/rotate'],
+    'shares.destroy' => ['DELETE', '/shares/s1'],
+    'activity.node' => ['GET', '/activity'],
+]);
+
+it('answers an unknown drive and a drive whose root is invisible identically', function (string $suffix): void {
+    $driveId = V1::drive(userId: 1, role: RoleRegistry::OWNER)->model()->getKey();
+    $this->actingAs(V1::user(2));
+
+    $unknown = $this->getJson(V1::url('drives/no-such-drive'.$suffix))->assertNotFound();
+    $invisible = $this->getJson(V1::url('drives/'.$driveId.$suffix))->assertNotFound();
+
+    expect($invisible->json('code'))->toBe('drive_not_found')
+        ->and(bodyWithoutRequestId($invisible))->toBe(bodyWithoutRequestId($unknown));
+})->with([
+    'activity.drive' => ['/activity'],
+]);
+
+it('hides a node of a drive being deleted', function (): void {
+    $drive = V1::drive(userId: 1);
+    $node = V1::folder($drive, 'going');
+    $model = $drive->model();
+    app(VaulterDatabase::class)->write(static fn () => $model->forceFill(['status' => DriveStatus::Deleting])->save());
+    $this->actingAs(V1::user(1));
+
+    $this->getJson(V1::url('nodes/'.$node->id.'/grants'))->assertNotFound()->assertJsonPath('code', 'node_not_found');
+    $this->getJson(V1::url('drives/'.$model->getKey().'/activity'))->assertNotFound()->assertJsonPath('code', 'drive_not_found');
+    expect(DriveTestHelpers::model($node)->exists)->toBeTrue();
+});
diff --git a/packages/core/tests/Http/V1.php b/packages/core/tests/Http/V1.php
new file mode 100644
index 00000000..cfcc4bff
--- /dev/null
+++ b/packages/core/tests/Http/V1.php
@@ -0,0 +1,89 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Vaulter\Tests\Http;
+
+use Illuminate\Contracts\Auth\Access\Authorizable;
+use Illuminate\Http\Request;
+use Throwable;
+use Vaulter\Access\Roles\RoleRegistry;
+use Vaulter\Contracts\Drive\DriveHandle;
+use Vaulter\Data\Drive\UploadOptions;
+use Vaulter\Data\Drive\UploadSource;
+use Vaulter\Data\Snapshots\NodeSnapshot;
+use Vaulter\Drive\Http\Resources\NodeResponses;
+use Vaulter\Enums\Access\GrantScope;
+use Vaulter\Http\Support\HttpResourceResolver;
+use Vaulter\Tests\Access\AccessTestHelpers;
+use Vaulter\Tests\Drive\DriveTestHelpers;
+use Vaulter\Tests\Fixtures\TestUser;
+use Vaulter\VaulterManager;
+
+/** Fixtures of the REST v1 suite: a drive under real grants and its URLs. */
+final class V1
+{
+    public static function url(string $path): string
+    {
+        return 'api/vaulter/v1/'.ltrim($path, '/');
+    }
+
+    /** A fresh drive (system handle) whose root grants $role to user $userId. */
+    public static function drive(int $userId = 1, string $role = RoleRegistry::OWNER): DriveHandle
+    {
+        config()->set('vaulter.access.permission_driver', 'database');
+        $drive = DriveTestHelpers::drive();
+        AccessTestHelpers::grant($drive->root(), $role, scope: GrantScope::Subtree, subjectId: $userId);
+
+        return $drive;
+    }
+
+    public static function user(int $id = 1): TestUser
+    {
+        return AccessTestHelpers::user($id);
+    }
+
+    public static function file(DriveHandle $drive, string $name = 'report.txt', string $bytes = 'hello v1', ?string $mime = 'text/plain', ?string $parent = null): NodeSnapshot
+    {
+        return $drive->files()->upload(
+            UploadSource::fromStream(DriveTestHelpers::streamFor($bytes), $name),
+            new UploadOptions(parent: $parent, declaredMimeType: $mime),
+        );
+    }
+
+    public static function folder(DriveHandle $drive, string $name, ?string $parent = null): NodeSnapshot
+    {
+        return $drive->folders()->create(name: $name, parent: $parent);
+    }
+
+    /**
+     * The tag $drive's actor would see for a node, trashed members included — for nodes a
+     * client has no listing to read the tag from (a member inside a trashed folder).
+     */
+    public static function tagFor(DriveHandle $drive, string $nodeId): string
+    {
+        return app(NodeResponses::class)->current(Request::create('/'), $drive, $nodeId, includeTrashed: true)->etag();
+    }
+
+    /**
+     * The If-Match header the authenticated user would send for a node (live or trashed).
+     *
+     * @return array{If-Match: string}
+     */
+    public static function ifMatch(int|string $nodeId): array
+    {
+        $user = auth()->user();
+        try {
+            if (!$user instanceof Authorizable) {
+                throw new \RuntimeException('ifMatch() needs an authenticated user');
+            }
+            $drive = app(VaulterManager::class)->drive(app(HttpResourceResolver::class)->driveOfNode((string) $nodeId))->actingAs($user);
+
+            return ['If-Match' => self::tagFor($drive, (string) $nodeId)];
+        } catch (Throwable) {
+            // A node the user cannot see has no tag for it; the request then answers
+            // whatever hides the node, before any precondition.
+            return ['If-Match' => '"unseen"'];
+        }
+    }
+}
diff --git a/packages/core/tests/Http/WebhookEndpointsV1Test.php b/packages/core/tests/Http/WebhookEndpointsV1Test.php
new file mode 100644
index 00000000..550134d9
