diff --git a/packages/documents/tests/Http/CollaborationSessionV1Test.php b/packages/documents/tests/Http/CollaborationSessionV1Test.php
new file mode 100644
index 00000000..7d3f525a
--- /dev/null
+++ b/packages/documents/tests/Http/CollaborationSessionV1Test.php
@@ -0,0 +1,59 @@
+<?php
+
+declare(strict_types=1);
+
+use Vaulter\Access\Roles\RoleRegistry;
+use Vaulter\Documents\Tests\Collaboration\HubTestHelpers as Hub;
+use Vaulter\Documents\Tests\Http\DocumentsV1 as Docs;
+use Vaulter\Tests\Access\AccessTestHelpers;
+
+/** The session a client joins a document's room with: its mode follows the caller's rights and its token is never stored. */
+beforeEach(function (): void {
+    Hub::configure();
+});
+
+it('issues a read-write session to an editor and never lets it be cached', function (): void {
+    $node = Hub::document(level: RoleRegistry::WRITER, actorId: 1);
+    $this->actingAs(AccessTestHelpers::user(1));
+
+    $response = $this->postJson(Docs::url('documents/'.$node->getKey().'/collaboration/session'))
+        ->assertCreated()
+        ->assertJsonPath('data.mode', 'rw')
+        ->assertJsonPath('data.epoch', 0)
+        ->assertJsonPath('data.node_id', (string) $node->getKey())
+        ->assertJsonPath('data.room', Hub::room($node))
+        ->assertJsonStructure(['data' => ['driver', 'room', 'node_id', 'drive_id', 'epoch', 'schema_version', 'mode', 'token', 'url']]);
+
+    expect($response->headers->get('Cache-Control'))->toContain('no-store');
+});
+
+it('issues a read-only session to a reader and to an editor whose client speaks another schema', function (): void {
+    $node = Hub::document(level: RoleRegistry::READER, actorId: 1);
+    $this->actingAs(AccessTestHelpers::user(1));
+    $this->postJson(Docs::url('documents/'.$node->getKey().'/collaboration/session'))->assertCreated()->assertJsonPath('data.mode', 'ro');
+
+    $editor = Hub::document(level: RoleRegistry::WRITER, actorId: 1);
+    $this->postJson(Docs::url('documents/'.$editor->getKey().'/collaboration/session'), ['schema_version' => 99])
+        ->assertCreated()
+        ->assertJsonPath('data.mode', 'ro');
+    $this->postJson(Docs::url('documents/'.$editor->getKey().'/collaboration/session'), ['schema_version' => 'x'])
+        ->assertStatus(422)
+        ->assertJsonValidationErrors('schema_version');
+});
+
+it('answers a caller without a grant 404', function (): void {
+    $node = Hub::document(level: null);
+    $this->actingAs(AccessTestHelpers::user(1));
+
+    $this->postJson(Docs::url('documents/'.$node->getKey().'/collaboration/session'))->assertNotFound()->assertJsonPath('code', 'node_not_found');
+});
+
+it('is refused with collaboration_unavailable once collaboration is switched off', function (): void {
+    $node = Hub::document(level: RoleRegistry::WRITER, actorId: 1);
+    $this->actingAs(AccessTestHelpers::user(1));
+    config()->set('vaulter-documents.collaboration.enabled', false);
+
+    $this->postJson(Docs::url('documents/'.$node->getKey().'/collaboration/session'))
+        ->assertStatus(409)
+        ->assertJsonPath('code', 'collaboration_unavailable');
+});
diff --git a/packages/documents/tests/Http/CommentsV1Test.php b/packages/documents/tests/Http/CommentsV1Test.php
new file mode 100644
index 00000000..1185b5e2
--- /dev/null
+++ b/packages/documents/tests/Http/CommentsV1Test.php
@@ -0,0 +1,74 @@
+<?php
+
+declare(strict_types=1);
+
+use Vaulter\Access\Roles\RoleRegistry;
+use Vaulter\Documents\Tests\Collaboration\HubTestHelpers as Hub;
+use Vaulter\Documents\Tests\Http\DocumentsV1 as Docs;
+use Vaulter\Tests\Access\AccessTestHelpers;
+
+/** Comments hang off any node of a drive; the routes are always there and the operations decide. */
+beforeEach(function (): void {
+    Hub::configure();
+    $this->node = Hub::document(level: RoleRegistry::COMMENTER, actorId: 1);
+    $this->url = Docs::url('nodes/'.$this->node->getKey().'/comments');
+    $this->actingAs(AccessTestHelpers::user(1));
+});
+
+it('adds, replies, lists in pages, resolves and deletes a comment', function (): void {
+    $first = $this->postJson($this->url, ['body' => 'first', 'anchor' => ['from' => 1, 'to' => 4]])
+        ->assertCreated()
+        ->assertJsonPath('data.body', 'first')
+        ->assertJsonPath('data.parent_id', null)
+        ->assertJsonPath('data.author.id', '1')
+        ->assertJsonPath('data.resolved_at', null)
+        ->json('data.id');
+    $reply = $this->postJson($this->url, ['body' => 'reply', 'parent_id' => $first])->assertCreated()->assertJsonPath('data.parent_id', $first)->json('data.id');
+
+    $page = $this->getJson($this->url.'?per_page=1')
+        ->assertOk()
+        ->assertJsonPath('data.0.id', $first)
+        ->assertJsonPath('meta.per_page', 1);
+    $this->getJson($this->url.'?per_page=1&cursor='.urlencode($page->json('meta.next_cursor')))->assertOk()->assertJsonPath('data.0.id', $reply);
+
+    $this->postJson($this->url.'/'.$first.'/resolve')->assertOk()->assertJsonPath('data.resolved_by', '1');
+    $this->deleteJson($this->url.'/'.$reply)->assertNoContent();
+    $this->getJson($this->url)->assertOk()->assertJsonCount(1, 'data');
+});
+
+it('validates the body and keeps ids as strings', function (): void {
+    $this->postJson($this->url, [])->assertStatus(422)->assertJsonValidationErrors('body');
+    $this->postJson($this->url, ['body' => str_repeat('x', 5001)])->assertStatus(422)->assertJsonValidationErrors('body');
+    $this->postJson($this->url, ['body' => 'x', 'parent_id' => 'missing'])->assertNotFound()->assertJsonPath('code', 'comment_not_found');
+    expect($this->postJson($this->url, ['body' => 'ok'])->json('data.id'))->toBeString();
+});
+
+it('lets a reader list the thread but not write in it', function (): void {
+    $reader = Hub::document(level: RoleRegistry::READER, actorId: 1);
+    $url = Docs::url('nodes/'.$reader->getKey().'/comments');
+
+    $this->getJson($url)->assertOk();
+    $this->postJson($url, ['body' => 'no'])->assertForbidden()->assertJsonPath('code', 'permission_denied');
+});
+
+it('answers a comment of another node 404 comment_not_found and a stranger 404 node_not_found', function (): void {
+    $id = $this->postJson($this->url, ['body' => 'mine'])->json('data.id');
+    $other = Hub::document(level: RoleRegistry::OWNER, actorId: 1);
+    $otherUrl = Docs::url('nodes/'.$other->getKey().'/comments');
+
+    $this->postJson($otherUrl.'/'.$id.'/resolve')->assertNotFound()->assertJsonPath('code', 'comment_not_found');
+    $this->deleteJson($otherUrl.'/'.$id)->assertNotFound()->assertJsonPath('code', 'comment_not_found');
+
+    $this->actingAs(AccessTestHelpers::user(9));
+    $this->getJson($this->url)->assertNotFound()->assertJsonPath('code', 'node_not_found');
+});
+
+it('refuses a visible node with 403 profile_restriction when comments are switched off globally', function (): void {
+    config()->set('vaulter-documents.comments.enabled', false);
+
+    $this->getJson($this->url)->assertForbidden()->assertJsonPath('code', 'profile_restriction');
+    $this->postJson($this->url, ['body' => 'x'])->assertForbidden();
+    // An invisible node stays an ordinary 404: the flag does not reveal it.
+    $this->actingAs(AccessTestHelpers::user(9));
+    $this->getJson($this->url)->assertNotFound()->assertJsonPath('code', 'node_not_found');
+});
diff --git a/packages/documents/tests/Http/DocumentContentV1Test.php b/packages/documents/tests/Http/DocumentContentV1Test.php
new file mode 100644
index 00000000..321a4e86
--- /dev/null
+++ b/packages/documents/tests/Http/DocumentContentV1Test.php
@@ -0,0 +1,184 @@
+<?php
+
+declare(strict_types=1);
+
+use Vaulter\Access\Roles\RoleRegistry;
+use Vaulter\Database\VaulterDatabase;
+use Vaulter\Documents\Tests\Collaboration\HubTestHelpers as Hub;
+use Vaulter\Documents\Tests\Http\DocumentsV1 as Docs;
+use Vaulter\Facades\Vaulter;
+use Vaulter\Models\Access\NodeGrant;
+use Vaulter\Models\Drive\Drive;
+use Vaulter\Models\Drive\Node;
+use Vaulter\Tests\Access\AccessTestHelpers;
+
+/**
+ * The content of a document is its own resource: GET carries a tag made of the
+ * generation (`"{nodeId}.{epoch}.{stateVersion}"`), PUT is refused without it or with a
+ * stale one, and a store from the collaboration hub moves the generation under a
+ * reader's feet exactly like another writer would.
+ */
+beforeEach(function (): void {
+    Hub::configure();
+});
+
+/** @return array{0: Node, 1: string} a document under a writer (user 1) and a reader (user 2), and its id */
+function sharedDocument(): array
+{
+    $node = Hub::document(level: RoleRegistry::WRITER, actorId: 1);
+    AccessTestHelpers::grant($node, RoleRegistry::READER, subjectId: 2);
+
+    return [$node, (string) $node->getKey()];
+}
+
+it('answers a reader and a writer with the same body and the same tag', function (): void {
+    [$node, $id] = sharedDocument();
+
+    $this->actingAs(AccessTestHelpers::user(1));
+    $writer = $this->getJson(Docs::url('documents/'.$id.'/content'))->assertOk();
+    $this->actingAs(AccessTestHelpers::user(2));
+    $reader = $this->getJson(Docs::url('documents/'.$id.'/content'))->assertOk();
+
+    $epoch = Hub::aggregate($node)->collab_epoch;
+    $version = Hub::aggregate($node)->state_version;
+    expect($reader->json())->toBe($writer->json())
+        ->and($reader->headers->get('ETag'))->toBe($writer->headers->get('ETag'))
+        ->and($writer->headers->get('ETag'))->toBe('"'.$id.'.'.$epoch.'.'.$version.'"')
+        ->and($writer->json('data'))->toHaveKeys(['type', 'schema_version', 'state_version', 'collab_epoch', 'revision_id', 'content'])
+        ->and(array_keys($writer->json('data')))->toHaveCount(6);
+});
+
+it('answers 304 to a matching If-None-Match and a fresh body to a stale one', function (): void {
+    [, $id] = sharedDocument();
+    $this->actingAs(AccessTestHelpers::user(1));
+    $tag = Docs::etag($id);
+
+    $this->getJson(Docs::url('documents/'.$id.'/content'), ['If-None-Match' => $tag])
+        ->assertStatus(304)
+        ->assertHeader('ETag', $tag);
+    $this->getJson(Docs::url('documents/'.$id.'/content'), ['If-None-Match' => '"'.$id.'.0.999"'])->assertOk();
+});
+
+it('never answers 304 to a caller who lost access, and keeps the 404 uniform', function (): void {
+    [$node, $id] = sharedDocument();
+    $this->actingAs(AccessTestHelpers::user(2));
+    $tag = Docs::etag($id);
+
+    app(VaulterDatabase::class)->write(static fn () => NodeGrant::query()->where('subject_id', 2)->delete());
+
+    $gone = $this->getJson(Docs::url('documents/'.$id.'/content'), ['If-None-Match' => $tag])->assertNotFound();
+    $unknown = $this->getJson(Docs::url('documents/no-such-document/content'))->assertNotFound();
+
+    expect(Docs::problemWithoutRequestId($gone))->toBe(Docs::problemWithoutRequestId($unknown));
+});
+
+it('requires If-Match to write: 428 without it or with *, 412 for a weak or stale tag', function (): void {
+    [, $id] = sharedDocument();
+    $this->actingAs(AccessTestHelpers::user(1));
+    $url = Docs::url('documents/'.$id.'/content');
+    $tag = Docs::etag($id);
+
+    $this->putJson($url, ['content' => Docs::doc('x')])->assertStatus(428)->assertJsonPath('code', 'precondition_required')->assertJsonPath('meta.header', 'If-Match');
+    $this->putJson($url, ['content' => Docs::doc('x')], ['If-Match' => '*'])->assertStatus(428)->assertJsonPath('meta.reason', 'wildcard_not_allowed');
+    $this->putJson($url, ['content' => Docs::doc('x')], ['If-Match' => 'W/'.$tag])->assertStatus(412)->assertJsonPath('code', 'document_state_mismatch');
+    $this->putJson($url, ['content' => Docs::doc('x')], ['If-Match' => '"'.$id.'.0.999"'])->assertStatus(412);
+
+    $this->getJson($url)->assertHeader('ETag', $tag);
+});
+
+it('saves with the current tag, moves the state version by one and answers the new tag', function (): void {
+    [$node, $id] = sharedDocument();
+    $this->actingAs(AccessTestHelpers::user(1));
+    $before = Hub::aggregate($node)->state_version;
+    $tag = Docs::etag($id);
+
+    $saved = Docs::put($id, Docs::doc('Saved'), $tag)
+        ->assertOk()
+        ->assertJsonPath('data.state_version', $before + 1)
+        ->assertJsonPath('data.content.content.0.content.0.text', 'Saved');
+
+    expect($saved->headers->get('ETag'))->not->toBe($tag)
+        ->and($saved->headers->get('ETag'))->toBe(Docs::etag($id));
+});
+
+it('refuses a PUT after a hub store landed between the read and the write', function (): void {
+    [$node, $id] = sharedDocument();
+    $this->actingAs(AccessTestHelpers::user(1));
+    $tag = Docs::etag($id);
+
+    Hub::call('store', Hub::storeBody($node, 'hub-state', Hub::tiptap('From the hub')), Hub::token($node))->assertOk();
+
+    Docs::put($id, Docs::doc('Late editor'), $tag)
+        ->assertStatus(412)
+        ->assertJsonPath('code', 'document_state_mismatch');
+    expect(Hub::aggregate($node)->content['content'][0]['content'][0]['text'])->toBe('From the hub');
+});
+
+it('lets a previewer read the content and refuses its write before any tag is compared', function (): void {
+    $node = Hub::document(level: RoleRegistry::PREVIEWER, actorId: 3);
+    $id = (string) $node->getKey();
+    $this->actingAs(AccessTestHelpers::user(3));
+
+    $this->getJson(Docs::url('documents/'.$id.'/content'))->assertOk();
+    $this->putJson(Docs::url('documents/'.$id.'/content'), ['content' => Docs::doc('x')])->assertForbidden()->assertJsonPath('code', 'permission_denied');
+    $this->putJson(Docs::url('documents/'.$id.'/content'), ['content' => Docs::doc('x')], ['If-Match' => '"stale"'])->assertForbidden();
+});
+
+it('keeps the content tag when the document is renamed', function (): void {
+    [$node, $id] = sharedDocument();
+    $this->actingAs(AccessTestHelpers::user(1));
+    $tag = Docs::etag($id);
+
+    $drive = Vaulter::drive($node->storage()->firstOrFail())->actingAs(AccessTestHelpers::user(1));
+    $drive->nodes()->rename($id, 'Renamed');
+
+    expect(Docs::etag($id))->toBe($tag);
+    Docs::put($id, Docs::doc('Still valid'), $tag)->assertOk();
+});
+
+it('hides an unknown document and one of another kind consistently', function (): void {
+    [, $id] = sharedDocument();
+    $this->actingAs(AccessTestHelpers::user(1));
+    $folder = AccessTestHelpers::folder(Drive::query()->firstOrFail(), null, 'plain');
+    AccessTestHelpers::grant($folder, RoleRegistry::OWNER, subjectId: 1);
+
+    $this->getJson(Docs::url('documents/'.$folder->getKey().'/content'))->assertStatus(409)->assertJsonPath('code', 'not_a_document');
+    $this->getJson(Docs::url('documents/missing/content'))->assertNotFound()->assertJsonPath('code', 'node_not_found');
+});
+
+it('marks the content response as private and revalidated on every use', function (): void {
+    [, $id] = sharedDocument();
+    $this->actingAs(AccessTestHelpers::user(1));
+
+    $response = $this->getJson(Docs::url('documents/'.$id.'/content'))->assertOk();
+
+    expect($response->headers->get('Cache-Control'))->toContain('private')->toContain('no-cache')
+        ->and($response->headers->get('Vary'))->toContain('Authorization')
+        ->and($response->headers->get('X-Vaulter-Api-Version'))->toBe('1');
+});
+
+it('does not reveal the current tag in a 412, so a stale caller cannot rebuild it', function (): void {
+    [, $id] = sharedDocument();
+    $this->actingAs(AccessTestHelpers::user(1));
+    $stale = Docs::etag($id);
+    Docs::put($id, Docs::doc('Second'), $stale)->assertOk();
+    $current = Docs::etag($id);
+
+    $refused = Docs::put($id, Docs::doc('Stale'), $stale)->assertStatus(412)->assertJsonPath('meta.node_id', $id)->assertJsonMissingPath('meta.context');
+
+    expect($refused->json('meta'))->toBe(['node_id' => $id])
+        ->and($refused->headers->get('ETag'))->toBeNull()
+        ->and($current)->not->toBe($stale);
+});
+
+it('answers an editor on an archived drive 409 drive_archived before any precondition', function (): void {
+    [$node, $id] = sharedDocument();
+    $this->actingAs(AccessTestHelpers::user(1));
+    $tag = Docs::etag($id);
+    app(VaulterDatabase::class)->write(static fn () => Drive::query()->whereKey($node->drive_id)->update(['status' => 'archived']));
+
+    $this->putJson(Docs::url('documents/'.$id.'/content'), ['content' => Docs::doc('x')])->assertStatus(409)->assertJsonPath('code', 'drive_archived');
+    $this->putJson(Docs::url('documents/'.$id.'/content'), ['content' => Docs::doc('x')], ['If-Match' => '"stale"'])->assertStatus(409);
+    $this->postJson(Docs::url('documents/'.$id.'/revisions/1/restore'), [], ['If-Match' => $tag])->assertStatus(409)->assertJsonPath('code', 'drive_archived');
+    $this->getJson(Docs::url('documents/'.$id.'/content'))->assertOk();
+});
diff --git a/packages/documents/tests/Http/DocumentRevisionsV1Test.php b/packages/documents/tests/Http/DocumentRevisionsV1Test.php
new file mode 100644
index 00000000..0018d072
--- /dev/null
+++ b/packages/documents/tests/Http/DocumentRevisionsV1Test.php
@@ -0,0 +1,110 @@
+<?php
+
+declare(strict_types=1);
+
+use Vaulter\Access\Roles\RoleRegistry;
+use Vaulter\Documents\Tests\Collaboration\HubTestHelpers as Hub;
+use Vaulter\Documents\Tests\Http\DocumentsV1 as Docs;
+use Vaulter\Tests\Access\AccessTestHelpers;
+
+/**
+ * The revision history of a document: checkpoints are listed, read whole, pinned and
+ * restored; a restore is a content write, so it needs the content's tag.
+ */
+beforeEach(function (): void {
+    Hub::configure();
+    $this->node = Hub::document(level: RoleRegistry::WRITER, actorId: 1);
+    $this->id = (string) $this->node->getKey();
+    $this->actingAs(AccessTestHelpers::user(1));
+});
+
+it('lists revisions newest first with a cursor and reads one with its content', function (): void {
+    $first = $this->getJson(Docs::url('documents/'.$this->id.'/revisions'))->assertOk()->json('data.0.id');
+    $named = $this->postJson(Docs::url('documents/'.$this->id.'/revisions'), ['label' => 'Second'])->assertCreated()->json('data.id');
+
+    $page = $this->getJson(Docs::url('documents/'.$this->id.'/revisions?per_page=1'))
+        ->assertOk()
+        ->assertJsonPath('data.0.id', $named)
+        ->assertJsonPath('data.0.label', 'Second')
+        ->assertJsonPath('data.0.is_head', true)
+        ->assertJsonPath('meta.per_page', 1);
+    expect($page->json('meta.next_cursor'))->toBeString()
+        ->and($page->json('data.0'))->not->toHaveKey('content');
+
+    $this->getJson(Docs::url('documents/'.$this->id.'/revisions?per_page=1&cursor='.urlencode($page->json('meta.next_cursor'))))
+        ->assertOk()
+        ->assertJsonPath('data.0.id', $first);
+    $this->getJson(Docs::url('documents/'.$this->id.'/revisions/'.$first))
+        ->assertOk()
+        ->assertJsonPath('data.id', $first)
+        ->assertJsonPath('data.content.content.0.content.0.text', 'Draft')
+        ->assertJsonMissingPath('data.snapshot_label');
+});
+
+it('refuses a per_page out of range and an unknown revision', function (): void {
+    $this->getJson(Docs::url('documents/'.$this->id.'/revisions?per_page=0'))->assertStatus(422)->assertJsonPath('code', 'validation_failed');
+    $this->getJson(Docs::url('documents/'.$this->id.'/revisions?per_page=201'))->assertStatus(422);
+    $this->getJson(Docs::url('documents/'.$this->id.'/revisions/999999'))->assertNotFound()->assertJsonPath('code', 'document_revision_not_found');
+});
+
+it('pins and releases a revision without touching its label', function (): void {
+    $id = $this->postJson(Docs::url('documents/'.$this->id.'/revisions'), ['label' => 'Keep me'])->assertCreated()->json('data.id');
+
+    $this->patchJson(Docs::url('documents/'.$this->id.'/revisions/'.$id), ['keep_forever' => true])
+        ->assertOk()
+        ->assertJsonPath('data.keep_forever', true)
+        ->assertJsonPath('data.label', 'Keep me');
+    $this->patchJson(Docs::url('documents/'.$this->id.'/revisions/'.$id), ['label' => 'Renamed', 'keep_forever' => false])
+        ->assertOk()
+        ->assertJsonPath('data.keep_forever', false)
+        ->assertJsonPath('data.label', 'Keep me');
+    $this->patchJson(Docs::url('documents/'.$this->id.'/revisions/'.$id), [])->assertStatus(422)->assertJsonValidationErrors('keep_forever');
+});
+
+it('restores with the content tag: 428 without it, 412 when stale, the old content when current', function (): void {
+    $first = $this->getJson(Docs::url('documents/'.$this->id.'/revisions'))->json('data.0.id');
+    $stale = Docs::etag($this->id);
+    Docs::put($this->id, Docs::doc('Changed'), $stale)->assertOk();
+    $url = Docs::url('documents/'.$this->id.'/revisions/'.$first.'/restore');
+
+    $this->postJson($url)->assertStatus(428)->assertJsonPath('code', 'precondition_required');
+    $this->postJson($url, [], ['If-Match' => $stale])->assertStatus(412)->assertJsonPath('code', 'document_state_mismatch');
+    $restored = $this->postJson($url, [], Docs::ifMatch($this->id))
+        ->assertOk()
+        ->assertJsonPath('data.content.content.0.content.0.text', 'Draft');
+
+    expect($restored->headers->get('ETag'))->toBe(Docs::etag($this->id));
+});
+
+it('moves the collaboration epoch on a restore, so the old room is fenced off', function (): void {
+    $first = $this->getJson(Docs::url('documents/'.$this->id.'/revisions'))->json('data.0.id');
+    $epoch = Hub::aggregate($this->node)->collab_epoch;
+
+    $this->postJson(Docs::url('documents/'.$this->id.'/revisions/'.$first.'/restore'), [], Docs::ifMatch($this->id))
+        ->assertOk()
+        ->assertJsonPath('data.collab_epoch', $epoch + 1);
+
+    Hub::call('store', Hub::storeBody($this->node, 'old-room', epoch: $epoch), Hub::token($this->node, epoch: $epoch))
+        ->assertStatus(409)
+        ->assertJsonPath('code', 'collaboration_epoch_mismatch');
+});
+
+it('lets a reader read the history and refuses it every write', function (): void {
+    AccessTestHelpers::grant($this->node, RoleRegistry::READER, subjectId: 2);
+    $first = $this->getJson(Docs::url('documents/'.$this->id.'/revisions'))->json('data.0.id');
+    $this->actingAs(AccessTestHelpers::user(2));
+
+    $this->getJson(Docs::url('documents/'.$this->id.'/revisions'))->assertOk();
+    $this->getJson(Docs::url('documents/'.$this->id.'/revisions/'.$first))->assertOk();
+    $this->postJson(Docs::url('documents/'.$this->id.'/revisions'), ['label' => 'No'])->assertForbidden();
+    $this->patchJson(Docs::url('documents/'.$this->id.'/revisions/'.$first), ['keep_forever' => true])->assertForbidden();
+    $this->postJson(Docs::url('documents/'.$this->id.'/revisions/'.$first.'/restore'), [], ['If-Match' => '"x"'])->assertForbidden();
+});
+
+it('answers a caller without a grant 404 on every revision route', function (): void {
+    $this->actingAs(AccessTestHelpers::user(9));
+
+    $this->getJson(Docs::url('documents/'.$this->id.'/revisions'))->assertNotFound()->assertJsonPath('code', 'node_not_found');
+    $this->postJson(Docs::url('documents/'.$this->id.'/revisions'), ['label' => 'No'])->assertNotFound();
+    $this->postJson(Docs::url('documents/'.$this->id.'/revisions/1/restore'), [], ['If-Match' => '"x"'])->assertNotFound();
+});
diff --git a/packages/documents/tests/Http/DocumentsV1.php b/packages/documents/tests/Http/DocumentsV1.php
new file mode 100644
index 00000000..03f7ad97
--- /dev/null
+++ b/packages/documents/tests/Http/DocumentsV1.php
@@ -0,0 +1,72 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Vaulter\Documents\Tests\Http;
+
+use Illuminate\Testing\TestResponse;
+use Vaulter\Tests\Http\V1;
+
+/** Fixtures of the documents REST v1 suite on top of the core V1 helpers; every call runs as the test's acting user. */
+final class DocumentsV1
+{
+    public static function url(string $path): string
+    {
+        return V1::url($path);
+    }
+
+    /**
+     * A problem body without its per-request id, to compare two answers.
+     *
+     * @return array<string, mixed>
+     */
+    public static function problemWithoutRequestId(TestResponse $response): array
+    {
+        $body = $response->json();
+        unset($body['request_id']);
+
+        return $body;
+    }
+
+    /** A TipTap document with one paragraph. @return array<string, mixed> */
+    public static function doc(string $text = 'Hello'): array
+    {
+        return ['type' => 'doc', 'content' => [['type' => 'paragraph', 'content' => [['type' => 'text', 'text' => $text]]]]];
+    }
+
+    /** The tag the caller reads for a document's content. */
+    public static function etag(string $nodeId): string
+    {
+        $etag = test()->getJson(self::url('documents/'.$nodeId.'/content'))->assertOk()->headers->get('ETag');
+
+        return is_string($etag) ? $etag : throw new \RuntimeException('No ETag on documents.content.show');
+    }
+
+    /** @return array{If-Match: string} */
+    public static function ifMatch(string $nodeId): array
+    {
+        return ['If-Match' => self::etag($nodeId)];
+    }
+
+    /**
+     * PUT a document's content with the tag the caller currently reads (or $etag).
+     *
+     * @param array<string, mixed> $content
+     */
+    public static function put(string $nodeId, array $content, ?string $etag = null): TestResponse
+    {
+        return test()->putJson(self::url('documents/'.$nodeId.'/content'), ['content' => $content], ['If-Match' => $etag ?? self::etag($nodeId)]);
+    }
+
+    /**
+     * Create a document through the API; returns its node id.
+     *
+     * @param array<string, mixed> $body
+     */
+    public static function create(int|string $driveId, array $body = []): string
+    {
+        $id = test()->postJson(self::url('drives/'.$driveId.'/documents'), $body + ['name' => 'Spec'])->assertCreated()->json('data.id');
+
+        return is_string($id) ? $id : throw new \RuntimeException('Document was not created');
+    }
+}
diff --git a/packages/documents/tests/Http/ExportV1Test.php b/packages/documents/tests/Http/ExportV1Test.php
new file mode 100644
index 00000000..5039e915
--- /dev/null
+++ b/packages/documents/tests/Http/ExportV1Test.php
@@ -0,0 +1,68 @@
+<?php
+
+declare(strict_types=1);
+
+use Vaulter\Access\Roles\RoleRegistry;
+use Vaulter\Database\VaulterDatabase;
+use Vaulter\Documents\Tests\Collaboration\HubTestHelpers as Hub;
+use Vaulter\Documents\Tests\Http\DocumentsV1 as Docs;
+use Vaulter\Tests\Access\AccessTestHelpers;
+
+/** An export is a download: an attachment that is never cached, sniffed or run in the API origin. */
+beforeEach(function (): void {
+    Hub::configure();
+    $this->node = Hub::document(level: RoleRegistry::READER, actorId: 1);
+    $this->id = (string) $this->node->getKey();
+    $this->actingAs(AccessTestHelpers::user(1));
+});
+
+it('sends the exporter bytes as an attachment with the egress headers', function (): void {
+    $response = $this->get(Docs::url('documents/'.$this->id.'/export/markdown'))->assertOk();
+
+    expect($response->headers->get('Content-Type'))->toStartWith('text/markdown')
+        ->and($response->headers->get('Content-Disposition'))->toBe('attachment; filename=Spec.md')
+        ->and($response->headers->get('X-Content-Type-Options'))->toBe('nosniff')
+        ->and($response->headers->get('Content-Security-Policy'))->toBe("sandbox; default-src 'none'")
+        ->and($response->headers->get('Cache-Control'))->toContain('no-store')->toContain('private')
+        ->and($response->headers->get('Accept-Ranges'))->toBe('none')
+        ->and($response->headers->get('Content-Length'))->toBe((string) strlen((string) $response->getContent()))
+        ->and($response->getContent())->toBe("Draft\n");
+});
+
+it('answers an unknown format 422 unknown_export_format with the allowed ones', function (): void {
+    $this->getJson(Docs::url('documents/'.$this->id.'/export/docx'))
+        ->assertStatus(422)
+        ->assertJsonPath('code', 'unknown_export_format')
+        ->assertJsonPath('meta.allowed', ['html', 'markdown']);
+});
+
+it('exports the checkpoint named by ?revision= instead of the working state', function (): void {
+    $writer = Hub::document(level: RoleRegistry::WRITER, actorId: 1);
+    $id = (string) $writer->getKey();
+    $first = $this->getJson(Docs::url('documents/'.$id.'/revisions'))->json('data.0.id');
+    Docs::put($id, Docs::doc('Newer'))->assertOk();
+
+    expect($this->get(Docs::url('documents/'.$id.'/export/markdown'))->getContent())->toBe("Newer\n")
+        ->and($this->get(Docs::url('documents/'.$id.'/export/markdown?revision='.$first))->getContent())->toBe("Draft\n");
+    $this->getJson(Docs::url('documents/'.$id.'/export/markdown?revision=999999'))->assertNotFound()->assertJsonPath('code', 'document_revision_not_found');
+});
+
+it('refuses a previewer, who may view but not download, and hides the document from a stranger', function (): void {
+    $node = Hub::document(level: RoleRegistry::PREVIEWER, actorId: 4);
+    $this->actingAs(AccessTestHelpers::user(4));
+    $this->getJson(Docs::url('documents/'.$node->getKey().'/export/html'))->assertForbidden()->assertJsonPath('code', 'permission_denied');
+
+    $this->actingAs(AccessTestHelpers::user(9));
+    $this->getJson(Docs::url('documents/'.$this->id.'/export/html'))->assertNotFound()->assertJsonPath('code', 'node_not_found');
+});
+
+it('marks an export of partly readable content with X-Vaulter-Export-Lossy', function (): void {
+    $writer = Hub::document(level: RoleRegistry::READER, actorId: 1);
+    app(VaulterDatabase::class)->write(fn () => Hub::aggregate($writer)->forceFill(['content' => ['type' => 'doc', 'content' => [
+        ['type' => 'paragraph', 'content' => [['type' => 'text', 'text' => 'kept']]],
+        ['type' => 'hostWidgetNode'],
+    ]]])->save());
+
+    $this->get(Docs::url('documents/'.$writer->getKey().'/export/html'))->assertOk()->assertHeader('X-Vaulter-Export-Lossy', '1');
+    expect($this->get(Docs::url('documents/'.$this->id.'/export/html'))->assertOk()->headers->has('X-Vaulter-Export-Lossy'))->toBeFalse();
+});
diff --git a/packages/documents/tests/Http/HubV1RoutesTest.php b/packages/documents/tests/Http/HubV1RoutesTest.php
