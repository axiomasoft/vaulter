+      .mockResolvedValueOnce(pageOf([makeFile({ id: '1' })], 'next'))
+      .mockReturnValueOnce(refreshing.promise)
+      .mockResolvedValueOnce(pageOf([makeFile({ id: '2' })]))
+    const { vm } = mountWith({ nodes: { children } }, () => useNodes('7'))
+    await vm.refresh()
+
+    const pending = vm.refresh()
+    await vm.loadMore()
