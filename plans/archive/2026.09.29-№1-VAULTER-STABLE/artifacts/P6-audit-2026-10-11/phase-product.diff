+    expect(vm.nodes.value.map((n) => n.id)).toEqual(['2'])
+  })
+
+  it('takes the page of the newest listing when an older one answers last', async () => {
+    const stale = deferred<ReturnType<typeof pageOf>>()
+    const children = vi.fn()
