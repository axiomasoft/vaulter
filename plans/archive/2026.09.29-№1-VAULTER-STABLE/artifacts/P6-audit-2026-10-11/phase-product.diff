new file mode 100644
index 00000000..f224ab9e
--- /dev/null
+++ b/packages/core/tests/Support/OpenApi/OpenApiContract.php
@@ -0,0 +1,231 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Vaulter\Tests\Support\OpenApi;
+
+use LogicException;
+use stdClass;
+use Symfony\Component\Yaml\Yaml;
+
+/**
+ * The OpenAPI 3.1 document as the contract tests read it: operations indexed by operationId,
+ * `$ref` resolution inside the file, and a hard stop on any construct the response validator
+ * cannot judge. A silent skip would turn a typo in the spec into a green test.
+ */
+final class OpenApiContract
+{
+    public const string BASE_URI = 'https://vaulter.test/openapi';
+
+    private const array METHODS = ['get', 'put', 'post', 'delete', 'options', 'head', 'patch', 'trace'];
+
+    /** @var array<string, string> */
+    private const array UNSUPPORTED_KEYWORDS = [
+        'discriminator' => 'discriminator',
+        'callbacks' => 'callbacks',
+        'webhooks' => 'webhooks',
+        '$dynamicRef' => '$dynamicRef',
+        '$recursiveRef' => '$recursiveRef',
+    ];
+
+    private static ?self $shared = null;
+
+    /** @var array<string, array{method: string, path: string, operation: stdClass}> */
+    private array $operations = [];
+
+    private function __construct(public readonly stdClass $document)
+    {
+        $this->assertSupported($document, '#');
+        $this->index();
+    }
+
+    public static function specPath(): string
+    {
+        return dirname(__DIR__, 5).'/openapi/vaulter-v1.yaml';
+    }
+
+    public static function shared(): self
+    {
+        return self::$shared ??= self::fromFile(self::specPath());
+    }
+
+    public static function fromFile(string $path): self
+    {
+        $yaml = file_get_contents($path);
+        if ($yaml === false) {
+            throw new LogicException("OpenAPI document {$path} is not readable.");
+        }
+
+        return self::fromYaml($yaml);
+    }
+
+    public static function fromYaml(string $yaml): self
+    {
+        $document = Yaml::parse($yaml, Yaml::PARSE_OBJECT_FOR_MAP);
+        if (!$document instanceof stdClass) {
+            throw new LogicException('The OpenAPI document must be a mapping.');
+        }
+
+        return new self($document);
+    }
+
+    /**
+     * @return array<string, array{method: string, path: string, operation: stdClass}>
+     */
+    public function operations(): array
+    {
+        return $this->operations;
+    }
+
+    /**
+     * @return array{method: string, path: string, operation: stdClass}|null
+     */
+    public function operation(string $operationId): ?array
+    {
+        return $this->operations[$operationId] ?? null;
+    }
+
+    /**
+     * The JSON pointer of a `$ref`, relative to the document root.
+     */
+    public function pointerOf(string $ref): string
+    {
+        if (!str_starts_with($ref, '#/')) {
+            throw new UnsupportedOpenApiConstruct("External or non-pointer \$ref '{$ref}' is not supported.");
+        }
+
+        return substr($ref, 1);
+    }
+
+    /**
+     * Follows `$ref` chains until a concrete node; returns it with the pointer it lives at.
+     *
+     * @return array{0: mixed, 1: string}
+     */
+    public function resolve(mixed $node, string $pointer): array
+    {
+        $seen = [];
+        while ($node instanceof stdClass && isset($node->{'$ref'})) {
+            $pointer = $this->pointerOf((string) $node->{'$ref'});
+            if (isset($seen[$pointer])) {
+                throw new LogicException("Circular \$ref at {$pointer}.");
+            }
+            $seen[$pointer] = true;
+            $node = $this->at($pointer);
+        }
+
+        return [$node, $pointer];
+    }
+
+    public function at(string $pointer): mixed
+    {
+        $node = $this->document;
+        foreach (array_slice(explode('/', $pointer), 1) as $segment) {
+            $key = str_replace(['~1', '~0'], ['/', '~'], rawurldecode($segment));
+            if ($node instanceof stdClass && property_exists($node, $key)) {
+                $node = $node->{$key};
+            } elseif (is_array($node) && array_key_exists((int) $key, $node)) {
+                $node = $node[(int) $key];
+            } else {
+                throw new LogicException("Unresolvable \$ref pointer {$pointer}.");
+            }
+        }
+
+        return $node;
+    }
+
+    /**
+     * A JSON pointer as a URI fragment: every segment percent-encoded, so `{node}` survives the URI parser.
+     */
+    public static function fragment(string $pointer): string
+    {
+        return implode('/', array_map(rawurlencode(...), explode('/', $pointer)));
+    }
+
+    public static function escape(string $segment): string
+    {
+        return str_replace(['~', '/'], ['~0', '~1'], $segment);
+    }
+
+    /**
+     * Every `$ref` found in the document, as [location, target] pairs.
+     *
+     * @return list<array{0: string, 1: string}>
+     */
+    public function references(): array
+    {
+        $found = [];
+        $this->collectReferences($this->document, '#', $found);
+
+        return $found;
+    }
+
+    /**
+     * @param list<array{0: string, 1: string}> $found
+     */
+    private function collectReferences(mixed $node, string $location, array &$found): void
+    {
+        if ($node instanceof stdClass) {
+            foreach (get_object_vars($node) as $key => $value) {
+                if ($key === '$ref' && is_string($value)) {
+                    $found[] = [$location, $value];
+
+                    continue;
+                }
+                $this->collectReferences($value, $location.'/'.self::escape((string) $key), $found);
+            }
+        } elseif (is_array($node)) {
+            foreach ($node as $index => $value) {
+                $this->collectReferences($value, $location.'/'.$index, $found);
+            }
+        }
+    }
+
+    private function assertSupported(mixed $node, string $location): void
+    {
+        if ($node instanceof stdClass) {
+            foreach (get_object_vars($node) as $key => $value) {
+                $key = (string) $key;
+                if (isset(self::UNSUPPORTED_KEYWORDS[$key]) && !$this->isPropertyName($location)) {
+                    throw new UnsupportedOpenApiConstruct("'{$key}' at {$location} is not supported by the response validator.");
+                }
+                if ($key === '$ref') {
+                    $this->pointerOf((string) $value);
+                }
+                $this->assertSupported($value, $location.'/'.self::escape($key));
+            }
+        } elseif (is_array($node)) {
+            foreach ($node as $index => $value) {
+                $this->assertSupported($value, $location.'/'.$index);
+            }
+        }
+    }
+
+    /** A schema property may legitimately be called "callbacks"; only keywords are rejected. */
+    private function isPropertyName(string $location): bool
+    {
+        return str_ends_with($location, '/properties');
+    }
+
+    private function index(): void
+    {
+        foreach (get_object_vars($this->document->paths ?? new stdClass) as $path => $item) {
+            if (!$item instanceof stdClass) {
+                continue;
+            }
+            foreach (get_object_vars($item) as $method => $operation) {
+                if (!in_array($method, self::METHODS, true)) {
+                    continue;
+                }
+                $id = $operation->operationId ?? null;
+                if (!is_string($id) || $id === '') {
+                    throw new LogicException("Operation {$method} {$path} has no operationId.");
+                }
+                if (isset($this->operations[$id])) {
+                    throw new LogicException("Duplicate operationId '{$id}'.");
+                }
+                $this->operations[$id] = ['method' => strtoupper($method), 'path' => (string) $path, 'operation' => $operation];
+            }
+        }
+    }
+}
diff --git a/packages/core/tests/Support/OpenApi/OpenApiResponseValidator.php b/packages/core/tests/Support/OpenApi/OpenApiResponseValidator.php
new file mode 100644
index 00000000..4f390723
--- /dev/null
+++ b/packages/core/tests/Support/OpenApi/OpenApiResponseValidator.php
@@ -0,0 +1,156 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Vaulter\Tests\Support\OpenApi;
+
+use Opis\JsonSchema\Errors\ErrorFormatter;
+use Opis\JsonSchema\Validator;
+use stdClass;
+
+/**
+ * Judges one HTTP response against its operation: status, headers, media type and body.
+ * Nothing undocumented passes — an unlisted status or media type is a violation, not a skip.
+ * Bodies are checked by opis/json-schema (draft 2020-12), the dialect OpenAPI 3.1 uses.
+ */
+final class OpenApiResponseValidator
+{
+    private readonly Validator $validator;
+
+    public function __construct(private readonly OpenApiContract $contract)
+    {
+        $this->validator = new Validator;
+        $this->validator->resolver()->registerRaw($contract->document, OpenApiContract::BASE_URI);
+    }
+
+    /**
+     * @param  array<string, string> $headers lower-cased header name => value
+     * @return list<string>          violations, empty when the response matches the contract
+     */
+    public function validate(string $operationId, int $status, array $headers, string $body, bool $inspectBody = true): array
+    {
+        $operation = $this->contract->operation($operationId);
+        if ($operation === null) {
+            return ["operation '{$operationId}' is not described in the OpenAPI document"];
+        }
+
+        $responses = $operation['operation']->responses ?? new stdClass;
+        $key = (string) $status;
+        if (!property_exists($responses, $key)) {
+            return ["{$operationId}: status {$status} is not documented"];
+        }
+
+        [$response, $pointer] = $this->contract->resolve(
+            $responses->{$key},
+            '/paths/'.OpenApiContract::escape($operation['path']).'/'.strtolower($operation['method']).'/responses/'.$key,
+        );
+        $violations = $this->headerViolations($operationId, $status, $response, $pointer, $headers);
+
+        $content = $response->content ?? null;
+        if (!$content instanceof stdClass || get_object_vars($content) === []) {
+            if ($inspectBody && $body !== '') {
+                $violations[] = "{$operationId}: status {$status} documents no content but the response has a body";
+            }
+
+            return $violations;
+        }
+
+        $actual = self::mediaType($headers['content-type'] ?? '');
+        $mediaType = self::documentedMediaType($content, $actual);
+        if ($mediaType === null) {
+            $violations[] = "{$operationId}: status {$status} Content-Type '".($headers['content-type'] ?? '')."' is not documented";
+
+            return $violations;
+        }
+
+        $schema = $content->{$mediaType}->schema ?? null;
+        if (!$inspectBody || $schema === null || !str_contains($actual, 'json')) {
+            return $violations;
+        }
+
+        $data = json_decode($body, false, 512, JSON_BIGINT_AS_STRING);
+        if ($body === '' || json_last_error() !== JSON_ERROR_NONE) {
+            $violations[] = "{$operationId}: status {$status} body is not valid JSON";
+
+            return $violations;
+        }
+
+        if ($actual === 'application/problem+json' && is_object($data) && ($data->status ?? null) !== $status) {
+            $violations[] = "{$operationId}: status {$status} problem body repeats status ".json_encode($data->status ?? null);
+        }
+
+        $schemaPointer = $pointer.'/content/'.OpenApiContract::escape($mediaType).'/schema';
+        $result = $this->validator->validate($data, OpenApiContract::BASE_URI.'#'.OpenApiContract::fragment($schemaPointer));
+        if (!$result->isValid()) {
+            foreach ((new ErrorFormatter)->formatKeyed($result->error()) as $path => $messages) {
+                $violations[] = "{$operationId}: status {$status} body {$path}: ".implode('; ', $messages);
+            }
+        }
+
+        return $violations;
+    }
+
+    /**
+     * @param  array<string, string> $headers
+     * @return list<string>
+     */
+    private function headerViolations(string $operationId, int $status, mixed $response, string $responsePointer, array $headers): array
+    {
+        $violations = [];
+        foreach (get_object_vars($response->headers ?? new stdClass) as $name => $definition) {
+            [$definition, $pointer] = $this->contract->resolve($definition, $responsePointer.'/headers/'.OpenApiContract::escape((string) $name));
+            $value = $headers[strtolower((string) $name)] ?? null;
+            if ($value === null) {
+                if (($definition->required ?? false) === true) {
+                    $violations[] = "{$operationId}: status {$status} is missing the required header {$name}";
+                }
+
+                continue;
+            }
+
+            $schema = $definition->schema ?? null;
+            if ($schema === null) {
+                continue;
+            }
+            $result = $this->validator->validate(
+                $this->headerValue($value, $schema),
+                OpenApiContract::BASE_URI.'#'.OpenApiContract::fragment($pointer.'/schema'),
+            );
+            if (!$result->isValid()) {
+                $violations[] = "{$operationId}: status {$status} header {$name}: '{$value}' does not match its schema";
+            }
+        }
+
+        return $violations;
+    }
+
+    private function headerValue(string $value, mixed $schema): string|int
+    {
+        [$schema] = $this->contract->resolve($schema, '');
+
+        return ($schema->type ?? null) === 'integer' && ctype_digit($value) ? (int) $value : $value;
+    }
+
+    /**
+     * The documented key a response media type falls under: exact, then `type/*`, then `*` slash `*`.
+     */
+    private static function documentedMediaType(stdClass $content, string $actual): ?string
+    {
+        if ($actual === '') {
+            return null;
+        }
+
+        foreach ([$actual, explode('/', $actual)[0].'/*', '*/*'] as $candidate) {
+            if (property_exists($content, $candidate)) {
+                return $candidate;
+            }
+        }
+
+        return null;
+    }
+
+    private static function mediaType(string $contentType): string
+    {
+        return strtolower(trim(explode(';', $contentType)[0]));
+    }
+}
