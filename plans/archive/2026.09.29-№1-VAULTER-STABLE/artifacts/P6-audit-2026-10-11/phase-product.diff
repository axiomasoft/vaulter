diff --git a/packages/core/tests/OpenApi/OpenApiDocumentTest.php b/packages/core/tests/OpenApi/OpenApiDocumentTest.php
new file mode 100644
index 00000000..93e267f4
--- /dev/null
+++ b/packages/core/tests/OpenApi/OpenApiDocumentTest.php
@@ -0,0 +1,147 @@
+<?php
+
+declare(strict_types=1);
+
+use Vaulter\Http\Problems\ProblemCatalog;
+use Vaulter\Tests\Support\OpenApi\OpenApiContract;
+
+/**
+ * The document itself: it parses, every reference resolves, and the cross-cutting promises of
+ * the API (preconditions, validators, headers, error shape) are declared on every operation
+ * they apply to — a new operation cannot forget them.
+ */
+
+/** The operations that change a node or a document and so require If-Match. */
+const IF_MATCH_OPERATIONS = [
+    'documents.content.update',
+    'documents.revisions.restore',
+    'files.revisions.restore',
+    'files.revisions.store',
+    'nodes.move',
+    'nodes.properties.update',
+    'nodes.purge',
+    'nodes.restore',
+    'nodes.trash',
+    'nodes.update',
+];
+
+/** The single resources that answer a matching If-None-Match with 304. */
+const CONDITIONAL_GET_OPERATIONS = ['documents.content.show', 'nodes.show'];
+
+/** @return array{0: array<string, mixed>, 1: string} */
+function describedResponse(string $operationId, string $status): array
+{
+    $contract = OpenApiContract::shared();
+    $operation = $contract->operation($operationId)['operation'];
+    [$response, $pointer] = $contract->resolve($operation->responses->{$status}, '/paths');
+
+    return [$response, $pointer];
+}
+
+function declaresHeaderParameter(string $operationId, string $header, bool $required): bool
+{
+    $contract = OpenApiContract::shared();
+    foreach ($contract->operation($operationId)['operation']->parameters ?? [] as $parameter) {
+        [$parameter] = $contract->resolve($parameter, '');
+        if ($parameter->in === 'header' && strtolower($parameter->name) === strtolower($header) && ($parameter->required ?? false) === $required) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+it('is an OpenAPI 3.1 document of the first major version', function (): void {
+    $document = OpenApiContract::shared()->document;
+
+    expect($document->openapi)->toStartWith('3.1.')
+        ->and($document->info->version)->toBe('1.0.0')
+        ->and($document->servers[0]->url)->toBe('/api/vaulter/v1');
+});
+
+it('resolves every $ref', function (): void {
+    $contract = OpenApiContract::shared();
+
+    foreach ($contract->references() as [$location, $target]) {
+        expect(fn () => $contract->at($contract->pointerOf($target)))->not->toThrow(Throwable::class, "{$location} -> {$target}");
+    }
+});
+
+it('gives every operation a unique id, a tag, a summary and a success response', function (): void {
+    foreach (OpenApiContract::shared()->operations() as $id => $entry) {
+        $operation = $entry['operation'];
+        $statuses = array_map('strval', array_keys(get_object_vars($operation->responses)));
+
+        expect($operation->tags)->not->toBeEmpty("{$id}: tags")
+            ->and($operation->summary)->not->toBe('', "{$id}: summary")
+            ->and(array_filter($statuses, static fn (string $status): bool => $status[0] === '2' || $status === '302'))->not->toBeEmpty("{$id}: a success status");
+    }
+});
+
+it('requires If-Match on exactly the operations that change a node or a document, with 412 and 428', function (): void {
+    $required = [];
+    foreach (array_keys(OpenApiContract::shared()->operations()) as $id) {
+        if (declaresHeaderParameter($id, 'If-Match', required: true)) {
+            $required[] = $id;
+        }
+    }
+    sort($required);
+
+    expect($required)->toBe(IF_MATCH_OPERATIONS);
+    foreach ($required as $id) {
+        $statuses = array_map('strval', array_keys(get_object_vars(OpenApiContract::shared()->operation($id)['operation']->responses)));
+        expect($statuses)->toContain('412', '428');
+    }
+});
+
+it('offers If-None-Match and a body-less 304 on every conditional GET', function (): void {
+    foreach (CONDITIONAL_GET_OPERATIONS as $id) {
+        [$response] = describedResponse($id, '304');
+
+        expect(declaresHeaderParameter($id, 'If-None-Match', required: false))->toBeTrue("{$id}: If-None-Match")
+            ->and(isset($response->content))->toBeFalse("{$id}: 304 has no content")
+            ->and(isset($response->headers->ETag))->toBeTrue("{$id}: 304 repeats the ETag");
+    }
+});
+
+it('describes streamed responses as bytes with disposition and cache headers', function (): void {
+    foreach (['files.download', 'files.revisions.download', 'public-shares.download', 'documents.export'] as $id) {
+        [$response] = describedResponse($id, '200');
+
+        expect($response->content)->toHaveProperty('application/octet-stream')
+            ->and($response->headers)->toHaveProperties(['Content-Disposition', 'Cache-Control', 'X-Content-Type-Options']);
+    }
+});
+
+it('lets every operation answer an unexpected failure as a problem', function (): void {
+    foreach (array_keys(OpenApiContract::shared()->operations()) as $id) {
+        expect(property_exists(OpenApiContract::shared()->operation($id)['operation']->responses, '500'))->toBeTrue($id);
+    }
+});
+
+it('stamps every response with the api version and the request id, and every error is a problem', function (): void {
+    $contract = OpenApiContract::shared();
+
+    foreach ($contract->operations() as $id => $entry) {
+        foreach (get_object_vars($entry['operation']->responses) as $status => $response) {
+            [$resolved] = $contract->resolve($response, '');
+
+            foreach (['X-Vaulter-Api-Version', 'X-Request-Id', 'Cache-Control'] as $header) {
+                expect(property_exists($resolved->headers ?? new stdClass, $header))->toBeTrue("{$id} {$status}: {$header}");
+            }
+            if ((int) $status >= 400) {
+                expect(property_exists($resolved->content ?? new stdClass, 'application/problem+json'))->toBeTrue("{$id} {$status}: problem+json");
+            }
+        }
+    }
+});
+
+it('requires the stable fields of a problem and lists every catalog code as an example', function (): void {
+    $problem = OpenApiContract::shared()->document->components->schemas->Problem;
+    $examples = $problem->properties->code->examples;
+    $catalog = array_keys(app(ProblemCatalog::class)->all());
+    sort($catalog);
+
+    expect($problem->required)->toBe(['type', 'title', 'status', 'code', 'request_id'])
+        ->and($examples)->toBe($catalog);
+});
diff --git a/packages/core/tests/OpenApi/OpenApiExamplesTest.php b/packages/core/tests/OpenApi/OpenApiExamplesTest.php
new file mode 100644
index 00000000..92db7594
--- /dev/null
+++ b/packages/core/tests/OpenApi/OpenApiExamplesTest.php
@@ -0,0 +1,166 @@
+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Testing\TestResponse;
+use Vaulter\Documents\Tests\Http\DocumentsV1 as Docs;
+use Vaulter\Tests\Http\V1;
+use Vaulter\Tests\Support\OpenApi\OpenApiContract;
+use Vaulter\Tests\Support\OpenApi\OpenApiResponseValidator;
+
+/**
+ * openapi/examples/*.json: one real response per resource, written from feature requests
+ * (VAULTER_OPENAPI_EXAMPLES_WRITE=1) and otherwise checked against the schema and against the
+ * shape the API answers with today. The client's contract tests read the same files.
+ */
+const EXAMPLE_HEADERS = ['content-type', 'cache-control', 'etag', 'vary', 'referrer-policy', 'x-vaulter-api-version', 'x-request-id'];
+
+function examplesDirectory(): string
+{
+    return dirname(__DIR__, 4).'/openapi/examples';
+}
+
+/**
+ * name => [operation id, status, producer of the live response]
+ *
+ * @return array<string, array{0: string, 1: int, 2: Closure(): TestResponse}>
+ */
+function exampleProducers(): array
+{
+    $test = test();
+    $prepare = static function () use ($test): array {
+        $test->actingAs(V1::user());
+        $drive = V1::drive();
+        $folder = V1::folder($drive, 'Docs');
+        $file = V1::file($drive, 'report.txt', parent: $folder->id);
+
+        return [$drive, $folder, $file];
+    };
+
+    return [
+        'node' => ['nodes.show', 200, function () use ($test, $prepare): TestResponse {
+            [, , $file] = $prepare();
+
+            return $test->getJson(V1::url('nodes/'.$file->id))->assertOk();
+        }],
+        'drive' => ['drives.show', 200, function () use ($test, $prepare): TestResponse {
+            [$drive] = $prepare();
+
+            return $test->getJson(V1::url('drives/'.$drive->snapshot()->id))->assertOk();
+        }],
+        'file-revisions' => ['files.revisions.index', 200, function () use ($test, $prepare): TestResponse {
+            [, , $file] = $prepare();
+
+            return $test->getJson(V1::url('files/'.$file->id.'/revisions'))->assertOk();
+        }],
+        'document-content' => ['documents.content.show', 200, function () use ($test, $prepare): TestResponse {
+            [$drive] = $prepare();
+            $document = Docs::create($drive->snapshot()->id, ['type' => 'vaulter/rich-text', 'content' => Docs::doc('Hello')]);
+
+            return $test->getJson(V1::url('documents/'.$document.'/content'))->assertOk();
+        }],
+        'grant' => ['grants.store', 201, function () use ($test, $prepare): TestResponse {
+            [, $folder] = $prepare();
+
+            return $test->postJson(V1::url('nodes/'.$folder->id.'/grants'), ['subject' => ['type' => V1::user(7)->getMorphClass(), 'id' => 7], 'role' => 'reader'])->assertCreated();
+        }],
+        'share' => ['shares.store', 201, function () use ($test, $prepare): TestResponse {
+            config()->set('vaulter.features.share_links', true);
+            [, , $file] = $prepare();
+
+            return $test->postJson(V1::url('nodes/'.$file->id.'/shares'), ['role' => 'reader', 'audience' => 'authenticated', 'max_uses' => 3])->assertCreated();
+        }],
+        'change-page' => ['changes.index', 200, function () use ($test, $prepare): TestResponse {
+            [$drive] = $prepare();
+            $start = $test->getJson(V1::url('drives/'.$drive->snapshot()->id.'/changes/start'))->assertOk()->json('data.cursor');
+            V1::folder($drive, 'After');
+
+            return $test->getJson(V1::url('drives/'.$drive->snapshot()->id.'/changes?cursor='.urlencode($start)))->assertOk();
+        }],
+        'problem-412' => ['nodes.update', 412, function () use ($test, $prepare): TestResponse {
+            [, , $file] = $prepare();
+
+            return $test->patchJson(V1::url('nodes/'.$file->id), ['name' => 'renamed.txt'], ['If-Match' => '"stale"'])->assertStatus(412);
+        }],
+        'problem-428' => ['nodes.update', 428, function () use ($test, $prepare): TestResponse {
+            [, , $file] = $prepare();
+
+            return $test->patchJson(V1::url('nodes/'.$file->id), ['name' => 'renamed.txt'])->assertStatus(428);
+        }],
+    ];
+}
+
+/** @return array<string, array<string, mixed>> */
+function shapeOf(mixed $value): mixed
+{
+    if (is_object($value)) {
+        $shape = [];
+        foreach (get_object_vars($value) as $key => $item) {
+            $shape[$key] = shapeOf($item);
+        }
+        ksort($shape);
+
+        return $shape;
+    }
+
+    return is_array($value) ? ($value === [] ? [] : [shapeOf($value[0])]) : get_debug_type($value);
+}
+
+it('writes the examples from live responses when asked to', function (): void {
+    if (getenv('VAULTER_OPENAPI_EXAMPLES_WRITE') !== '1') {
+        $this->markTestSkipped('Set VAULTER_OPENAPI_EXAMPLES_WRITE=1 to regenerate openapi/examples.');
+    }
+
+    @mkdir(examplesDirectory(), 0o775, true);
+    foreach (exampleProducers() as $name => [$operation, $status, $produce]) {
+        $response = $produce();
+        $headers = [];
+        foreach (EXAMPLE_HEADERS as $header) {
+            if ($response->headers->has($header)) {
+                $headers[$header] = implode(', ', $response->headers->all($header));
+            }
+        }
+        file_put_contents(
+            examplesDirectory().'/'.$name.'.json',
+            json_encode([
+                'operation_id' => $operation,
+                'status' => $status,
+                'headers' => $headers,
+                'body' => json_decode($response->getContent(), false),
+            ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PRESERVE_ZERO_FRACTION)."\n",
+        );
+    }
+
+    expect(true)->toBeTrue();
+});
+
+it('has one example file per producer and no stray files', function (): void {
+    $files = array_map(static fn (string $path): string => basename($path, '.json'), glob(examplesDirectory().'/*.json') ?: []);
+    sort($files);
+    $expected = array_keys(exampleProducers());
+    sort($expected);
+
+    expect($files)->toBe($expected);
+});
+
+it('keeps every example valid against the schema of its operation', function (): void {
+    $validator = new OpenApiResponseValidator(OpenApiContract::shared());
+
+    foreach (glob(examplesDirectory().'/*.json') ?: [] as $path) {
+        $example = json_decode((string) file_get_contents($path), false);
+
+        expect($validator->validate($example->operation_id, $example->status, (array) $example->headers, json_encode($example->body)))
+            ->toBe([], basename($path));
+    }
+});
+
+it('keeps every example in the shape the API answers with today', function (): void {
+    foreach (exampleProducers() as $name => [$operation, $status, $produce]) {
+        $example = json_decode((string) file_get_contents(examplesDirectory().'/'.$name.'.json'), false);
+        $live = json_decode($produce()->getContent(), false);
+
+        expect($example->operation_id)->toBe($operation)
+            ->and($example->status)->toBe($status)
+            ->and(shapeOf($example->body))->toBe(shapeOf($live), $name);
+    }
+});
diff --git a/packages/core/tests/OpenApi/OpenApiRouteCoverageTest.php b/packages/core/tests/OpenApi/OpenApiRouteCoverageTest.php
new file mode 100644
index 00000000..79df17a6
--- /dev/null
+++ b/packages/core/tests/OpenApi/OpenApiRouteCoverageTest.php
@@ -0,0 +1,54 @@
+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Routing\Route as LaravelRoute;
+use Illuminate\Support\Facades\Route;
+use Vaulter\Configuration\RoutesConfig;
+use Vaulter\Tests\Support\OpenApi\OpenApiContract;
+use Vaulter\Tests\Support\OpenApi\ValidateOpenApiResponses;
+
+/**
+ * The route table and the contract describe the same API: no route without an operation, no
+ * operation without a route, and the same method and path on both sides.
+ */
+
+/** @return array<string, LaravelRoute> route name without the version prefix => route */
+function v1Routes(): array
+{
+    $routes = [];
+    foreach (Route::getRoutes()->getRoutes() as $route) {
+        $name = (string) $route->getName();
+        if (str_starts_with($name, ValidateOpenApiResponses::PREFIX) && !ValidateOpenApiResponses::isProbe($name)) {
+            $routes[substr($name, strlen(ValidateOpenApiResponses::PREFIX))] = $route;
+        }
+    }
+    ksort($routes);
+
+    return $routes;
+}
+
+it('names an operation for every vaulter.v1 route and a route for every operation', function (): void {
+    $operations = array_keys(OpenApiContract::shared()->operations());
+    sort($operations);
+
+    expect(array_keys(v1Routes()))->toBe($operations);
+});
+
+it('agrees with every route on method and path', function (): void {
+    $prefix = '/'.app(RoutesConfig::class)->versionedPrefix();
+    $operations = OpenApiContract::shared()->operations();
+
+    foreach (v1Routes() as $name => $route) {
+        $methods = array_values(array_diff($route->methods(), ['HEAD'])) ?: ['HEAD'];
+
+        expect($methods)->toBe([$operations[$name]['method']], "{$name}: HTTP method")
+            ->and('/'.ltrim($route->uri(), '/'))->toBe($prefix.$operations[$name]['path'], "{$name}: path");
+    }
+});
+
+it('mounts the contract under the documented server url', function (): void {
+    $server = OpenApiContract::shared()->document->servers[0]->url;
+
+    expect($server)->toBe('/'.app(RoutesConfig::class)->versionedPrefix());
+});
