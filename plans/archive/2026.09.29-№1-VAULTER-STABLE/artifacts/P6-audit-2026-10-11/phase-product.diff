+        return $this->contexts->onDrive($request, $drive, static function (DriveHandle $handle): DriveResource {
+            $root = $handle->root();
+            $snapshot = $handle->unarchive();
+
+            return new DriveResource($snapshot, $handle->quota(), $root->id);
+        });
+    }
+}
