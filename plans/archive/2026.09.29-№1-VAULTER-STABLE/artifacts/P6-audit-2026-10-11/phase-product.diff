index 00000000..7ea1e242
--- /dev/null
+++ b/packages/drive/tests/Http/StarPropertiesV1Test.php
@@ -0,0 +1,67 @@
+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Vaulter\Access\Roles\RoleRegistry;
+use Vaulter\Drive\Tests\Http\DriveV1;
+use Vaulter\Tests\Access\AccessTestHelpers;
+use Vaulter\Tests\Drive\DriveTestHelpers;
+use Vaulter\Tests\Http\V1;
+
+/** Personal stars and namespaced properties over v1. */
+uses(RefreshDatabase::class);
+
+beforeEach(function (): void {
+    $this->drive = V1::drive(userId: 1);
+    $this->driveId = (string) $this->drive->model()->getKey();
+});
+
+it('stars and unstars idempotently without touching the sequence, and lists the caller stars', function (): void {
+    $node = V1::folder($this->drive, 'fav');
+    $other = V1::folder($this->drive, 'other');
+    $this->actingAs(V1::user(1));
+    $sequence = DriveTestHelpers::model($node)->sequence;
+
+    $this->putJson(V1::url('nodes/'.$node->id.'/star'))->assertOk()->assertJsonPath('data.viewer.starred', true);
+    $this->putJson(V1::url('nodes/'.$node->id.'/star'))->assertOk()->assertJsonPath('data.viewer.starred', true);
+    expect(DriveTestHelpers::model($node)->sequence)->toBe($sequence);
+
+    $this->getJson(V1::url('drives/'.$this->driveId.'/starred'))
+        ->assertOk()
+        ->assertJsonCount(1, 'data')
+        ->assertJsonPath('data.0.id', $node->id);
+
+    $this->deleteJson(V1::url('nodes/'.$node->id.'/star'))->assertOk()->assertJsonPath('data.viewer.starred', false);
+    $this->getJson(V1::url('drives/'.$this->driveId.'/starred'))->assertOk()->assertJsonCount(0, 'data');
+    expect($other->id)->not->toBe($node->id);
+});
+
+it('lets a reader star but not change properties', function (): void {
+    $node = V1::folder($this->drive, 'read-only');
+    AccessTestHelpers::grant(DriveTestHelpers::model($node), RoleRegistry::READER, subjectId: 2);
+    $this->actingAs(V1::user(2));
+
+    $this->putJson(V1::url('nodes/'.$node->id.'/star'))->assertOk();
+    $this->patchJson(V1::url('nodes/'.$node->id.'/properties'), ['namespace' => 'acme', 'set' => ['k' => 'v']], ['If-Match' => DriveV1::etag($this, $node->id)])
+        ->assertForbidden();
+});
+
+it('patches one property namespace with If-Match and returns it as a JSON object', function (): void {
+    $node = V1::folder($this->drive, 'props');
+    $this->actingAs(V1::user(1));
+    $this->getJson(V1::url('nodes/'.$node->id))->assertOk()->assertJsonPath('data.properties', []);
+    expect($this->getJson(V1::url('nodes/'.$node->id))->getContent())->toContain('"properties":{}');
+
+    $set = $this->patchJson(V1::url('nodes/'.$node->id.'/properties'), ['namespace' => 'acme', 'set' => ['color' => 'red', 'size' => 'L']], ['If-Match' => DriveV1::etag($this, $node->id)])
+        ->assertOk()
+        ->assertJsonPath('data.properties.acme.color', 'red');
+
+    $this->patchJson(V1::url('nodes/'.$node->id.'/properties'), ['namespace' => 'acme', 'unset' => ['size']], ['If-Match' => $set->headers->get('ETag')])
+        ->assertOk()
+        ->assertJsonPath('data.properties.acme', ['color' => 'red']);
+
+    $this->patchJson(V1::url('nodes/'.$node->id.'/properties'), ['namespace' => 'vaulter', 'set' => ['x' => 'y']], ['If-Match' => DriveV1::etag($this, $node->id)])
+        ->assertStatus(422)
+        ->assertJsonPath('code', 'invalid_properties');
+});
diff --git a/packages/drive/tests/Http/TrashV1Test.php b/packages/drive/tests/Http/TrashV1Test.php
new file mode 100644
index 00000000..047e7c11
--- /dev/null
+++ b/packages/drive/tests/Http/TrashV1Test.php
@@ -0,0 +1,121 @@
+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Storage;
+use Vaulter\Database\VaulterDatabase;
+use Vaulter\Drive\Tests\Http\DriveV1;
+use Vaulter\Models\Drive\Node;
+use Vaulter\Tests\Drive\DriveTestHelpers;
+use Vaulter\Tests\Http\V1;
+
+/**
+ * Trash, restore and purge over v1. Restore and purge act on a trashed node, so their
+ * If-Match is the tag the trash listing showed; a stale one changes nothing — a purge
+ * in particular removes no row and no stored byte.
+ */
+uses(RefreshDatabase::class);
+
+beforeEach(function (): void {
+    Storage::fake('local');
+    $this->drive = V1::drive(userId: 1);
+    $this->driveId = (string) $this->drive->model()->getKey();
+    $this->actingAs(V1::user(1));
+});
+
+it('trashes with If-Match, lists the trash root and restores it with the listed tag', function (): void {
+    $folder = V1::folder($this->drive, 'project');
+
+    $this->postJson(V1::url('nodes/'.$folder->id.'/trash'), [], ['If-Match' => DriveV1::etag($this, $folder->id)])
+        ->assertOk()
+        ->assertJsonPath('data.trash_root', true);
+    $this->getJson(V1::url('nodes/'.$folder->id))->assertNotFound();
+
+    $listed = $this->getJson(V1::url('drives/'.$this->driveId.'/trash'))->assertOk()->assertJsonPath('data.0.id', $folder->id);
+    expect($listed->json('meta'))->toBe(['next_cursor' => null, 'per_page' => 50]);
+
+    $restored = $this->postJson(V1::url('nodes/'.$folder->id.'/restore'), [], ['If-Match' => $listed->json('data.0.etag')])
+        ->assertOk()
+        ->assertJsonPath('data.trashed_at', null);
+    expect($restored->headers->get('ETag'))->toBe($restored->json('data.etag'));
+});
+
+it('refuses a restore with a stale tag and keeps the node in the trash', function (): void {
+    $folder = V1::folder($this->drive, 'stale');
+    $this->drive->nodes()->trash($folder->id);
+    $etag = DriveV1::trashedEtag($this, $this->driveId, $folder->id);
+    // Any change of the trashed node's sequence makes the listed tag stale.
+    app(VaulterDatabase::class)->write(static fn () => Node::query()->whereKey($folder->id)->increment('sequence'));
+
+    $this->postJson(V1::url('nodes/'.$folder->id.'/restore'), [], ['If-Match' => $etag])
+        ->assertStatus(412)
+        ->assertJsonPath('code', 'node_sequence_mismatch');
+
+    expect(DriveTestHelpers::model($folder)->trashed_at)->not->toBeNull();
+});
+
+it('restores next to a same-named sibling under a free name by default', function (): void {
+    $folder = V1::folder($this->drive, 'twin');
+    $this->drive->nodes()->trash($folder->id);
+    V1::folder($this->drive, 'twin');
+
+    $this->postJson(V1::url('nodes/'.$folder->id.'/restore'), [], ['If-Match' => DriveV1::trashedEtag($this, $this->driveId, $folder->id)])
+        ->assertOk()
+        ->assertJsonPath('data.name', 'twin (2)');
+});
+
+it('refuses on_conflict=fail when the name is taken', function (): void {
+    $folder = V1::folder($this->drive, 'clash');
+    $this->drive->nodes()->trash($folder->id);
+    V1::folder($this->drive, 'clash');
+
+    $this->postJson(V1::url('nodes/'.$folder->id.'/restore'), ['on_conflict' => 'fail'], ['If-Match' => DriveV1::trashedEtag($this, $this->driveId, $folder->id)])
+        ->assertStatus(409);
+});
+
+it('purges only from the trash: a live node is 409 node_not_trashed', function (): void {
+    $file = V1::file($this->drive, 'live.txt');
+
+    $this->deleteJson(V1::url('nodes/'.$file->id), [], ['If-Match' => DriveV1::etag($this, $file->id)])
+        ->assertStatus(409)
+        ->assertJsonPath('code', 'node_not_trashed');
+
+    expect(Node::query()->whereKey($file->id)->exists())->toBeTrue();
+});
+
+it('refuses a purge with a stale tag and deletes nothing', function (): void {
+    $file = V1::file($this->drive, 'kept.txt', 'kept bytes');
+    $this->drive->nodes()->trash($file->id);
+    $etag = DriveV1::trashedEtag($this, $this->driveId, $file->id);
+    app(VaulterDatabase::class)->write(static fn () => Node::query()->whereKey($file->id)->increment('sequence'));
+    $used = $this->drive->quota()->usedBytes;
+
+    $this->deleteJson(V1::url('nodes/'.$file->id), [], ['If-Match' => $etag])
+        ->assertStatus(412)
+        ->assertJsonPath('code', 'node_sequence_mismatch');
+
+    expect(Node::query()->whereKey($file->id)->exists())->toBeTrue()
+        ->and($this->drive->quota()->usedBytes)->toBe($used);
+});
+
+it('purges a trashed node with its listed tag and answers 204', function (): void {
+    $file = V1::file($this->drive, 'gone.txt');
+    $this->drive->nodes()->trash($file->id);
+
+    $this->deleteJson(V1::url('nodes/'.$file->id), [], ['If-Match' => DriveV1::trashedEtag($this, $this->driveId, $file->id)])
+        ->assertNoContent();
+
+    expect(Node::query()->whereKey($file->id)->exists())->toBeFalse();
+});
+
+it('empties the trash and reports how many roots were purged', function (): void {
+    foreach (['a', 'b'] as $name) {
+        $this->drive->nodes()->trash(V1::folder($this->drive, $name)->id);
+    }
+
+    $this->deleteJson(V1::url('drives/'.$this->driveId.'/trash'))
+        ->assertOk()
+        ->assertExactJson(['data' => ['purged_count' => 2]]);
+    $this->getJson(V1::url('drives/'.$this->driveId.'/trash'))->assertOk()->assertJsonCount(0, 'data');
+});
diff --git a/packages/drive/tests/Http/UniformNotFoundDriveV1Test.php b/packages/drive/tests/Http/UniformNotFoundDriveV1Test.php
new file mode 100644
index 00000000..df73c797
--- /dev/null
+++ b/packages/drive/tests/Http/UniformNotFoundDriveV1Test.php
@@ -0,0 +1,109 @@
+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Storage;
+use Vaulter\Drive\Tests\Http\DriveV1;
+use Vaulter\Tests\Http\V1;
+
+/**
+ * A node or drive the caller may not see answers exactly like one that does not exist,
+ * on every drive route: same status, same code, same body except the request id.
+ */
+uses(RefreshDatabase::class);
+
+beforeEach(function (): void {
+    Storage::fake('local');
+});
+
+it('answers an unknown node and an invisible node identically', function (string $method, string $prefix, string $suffix, array $body = []): void {
+    $drive = V1::drive(userId: 1);
+    $hidden = V1::file($drive, 'hidden.txt');
+    $this->actingAs(V1::user(2));
+
+    $unknown = $this->json($method, V1::url($prefix.'no-such-node'.$suffix), $body)->assertNotFound();
+    $invisible = $this->json($method, V1::url($prefix.$hidden->id.$suffix), $body)->assertNotFound();
+
+    expect($invisible->json('code'))->toBe('node_not_found')
+        ->and(DriveV1::problem($invisible))->toBe(DriveV1::problem($unknown));
+})->with([
+    'nodes.show' => ['GET', 'nodes/', ''],
+    'nodes.update' => ['PATCH', 'nodes/', '', ['name' => 'x']],
+    'nodes.properties.update' => ['PATCH', 'nodes/', '/properties', ['namespace' => 'acme']],
+    'nodes.star' => ['PUT', 'nodes/', '/star'],
+    'nodes.unstar' => ['DELETE', 'nodes/', '/star'],
+    'nodes.move' => ['POST', 'nodes/', '/move', ['destination_id' => null]],
+    'nodes.copy' => ['POST', 'nodes/', '/copy'],
+    'nodes.trash' => ['POST', 'nodes/', '/trash'],
+    'nodes.restore' => ['POST', 'nodes/', '/restore'],
+    'nodes.purge' => ['DELETE', 'nodes/', ''],
+    'nodes.abilities' => ['GET', 'nodes/', '/abilities'],
+    'files.download' => ['GET', 'files/', '/download'],
+    'files.revisions.index' => ['GET', 'files/', '/revisions'],
+    'files.revisions.restore' => ['POST', 'files/', '/revisions/r1/restore'],
+    'files.revisions.update' => ['PATCH', 'files/', '/revisions/r1', ['keep_forever' => true]],
+    'files.revisions.destroy' => ['DELETE', 'files/', '/revisions/r1'],
+    'files.revisions.download' => ['GET', 'files/', '/revisions/r1/download'],
+]);
+
+it('answers an unknown drive and a drive whose root is invisible identically', function (string $method, string $suffix): void {
+    $driveId = (string) V1::drive(userId: 1)->model()->getKey();
+    $this->actingAs(V1::user(2));
+
+    $unknown = $this->json($method, V1::url('drives/no-such-drive'.$suffix))->assertNotFound();
+    $invisible = $this->json($method, V1::url('drives/'.$driveId.$suffix))->assertNotFound();
+
+    expect($invisible->json('code'))->toBe('drive_not_found')
+        ->and(DriveV1::problem($invisible))->toBe(DriveV1::problem($unknown));
+})->with([
+    'drives.show' => ['GET', ''],
+    'drives.archive' => ['POST', '/archive'],
+    'drives.unarchive' => ['POST', '/unarchive'],
+    'drives.destroy' => ['DELETE', ''],
+    'nodes.index' => ['GET', '/nodes'],
+]);
+
+it('answers a child id under an invisible drive like an unknown drive', function (string $method, string $suffix, array $body): void {
+    $driveId = (string) V1::drive(userId: 1)->model()->getKey();
+    $this->actingAs(V1::user(2));
+
+    $unknown = $this->json($method, V1::url('drives/no-such-drive'.$suffix), $body)->assertNotFound();
+    $invisible = $this->json($method, V1::url('drives/'.$driveId.$suffix), $body)->assertNotFound();
+
+    expect($invisible->json('code'))->toBe('drive_not_found')
+        ->and(DriveV1::problem($invisible))->toBe(DriveV1::problem($unknown));
+})->with([
+    'nodes.index?parent' => ['GET', '/nodes?parent=no-such', []],
+    'folders.store parent_id' => ['POST', '/folders', ['name' => 'x', 'parent_id' => 'no-such']],
+    'uploads.store parent_id' => ['POST', '/uploads', ['name' => 'x.bin', 'total_size_bytes' => 1, 'parent_id' => 'no-such']],
+    'uploads.store node_id' => ['POST', '/uploads', ['total_size_bytes' => 1, 'node_id' => 'no-such']],
+]);
+
+it('keeps node_not_found for a missing child of a drive the caller can see', function (): void {
+    $driveId = (string) V1::drive(userId: 1)->model()->getKey();
+    $this->actingAs(V1::user(1));
+
+    $this->getJson(V1::url('drives/'.$driveId.'/nodes?parent=no-such'))->assertNotFound()->assertJsonPath('code', 'node_not_found');
+});
+
+it('filters the drive-wide lists down to what the caller can see', function (string $suffix): void {
+    $driveId = (string) V1::drive(userId: 1)->model()->getKey();
+    $this->actingAs(V1::user(2));
+
+    // A caller granted only a folder deep inside may search or list the trash of the
+    // drive; a stranger gets an empty page, an unknown drive id 404.
+    $this->getJson(V1::url('drives/'.$driveId.$suffix))->assertOk()->assertJsonCount(0, 'data');
+    $this->getJson(V1::url('drives/no-such-drive'.$suffix))->assertNotFound()->assertJsonPath('code', 'drive_not_found');
+})->with([
+    'nodes.search' => ['/search?q=a'],
+    'nodes.starred' => ['/starred'],
+    'trash.index' => ['/trash'],
+]);
+
+it('answers the retired unversioned drive paths with route_not_found under the v1 prefix only', function (): void {
+    $this->actingAs(V1::user(1));
+
+    $this->getJson(V1::url('storages/1/nodes'))->assertNotFound()->assertJsonPath('code', 'route_not_found');
+    $this->getJson('api/vaulter/storages/1/nodes')->assertNotFound()->assertHeaderMissing('X-Vaulter-Api-Version');
+});
diff --git a/packages/drive/tests/Http/UploadsV1Test.php b/packages/drive/tests/Http/UploadsV1Test.php
new file mode 100644
index 00000000..da8a25f7
--- /dev/null
+++ b/packages/drive/tests/Http/UploadsV1Test.php
@@ -0,0 +1,136 @@
+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Testing\TestResponse;
+use Orchestra\Testbench\TestCase;
+use Vaulter\Drive\Tests\Http\DriveV1;
+use Vaulter\Tests\Drive\DriveTestHelpers;
+use Vaulter\Tests\Http\V1;
+
+/**
+ * Resumable uploads over v1: tus create → HEAD → PATCH → commit and S3 parts → complete,
+ * all under uploads/{upload}, with the protocol headers intact and errors as problem+json.
+ */
+uses(RefreshDatabase::class);
+
+beforeEach(function (): void {
+    Storage::fake('local');
+    config()->set('vaulter-media.dedup.scope', 'tenant');
+    $this->drive = V1::drive(userId: 1);
+    $this->driveId = (string) $this->drive->model()->getKey();
+    $this->actingAs(V1::user(1));
+});
+
+/** @param array<string, string> $headers */
+function tusPatch(TestCase $test, string $uploadId, int $offset, string $bytes, array $headers = []): TestResponse
+{
+    return $test->call('PATCH', V1::url('uploads/'.$uploadId), [], [], [], [
+        'HTTP_UPLOAD_OFFSET' => (string) $offset,
+        'CONTENT_TYPE' => 'application/offset+octet-stream',
+        'HTTP_TUS_RESUMABLE' => '1.0.0',
+        'HTTP_ACCEPT' => 'application/json',
+        ...$headers,
+    ], $bytes);
+}
+
+it('runs a tus upload end to end under v1', function (): void {
+    $created = $this->postJson(V1::url('drives/'.$this->driveId.'/uploads'), ['protocol' => 'tus', 'name' => 'tus.bin', 'total_size_bytes' => 10])
+        ->assertCreated()
+        ->assertHeader('Tus-Resumable', '1.0.0')
+        ->assertHeader('Upload-Offset', '0')
+        ->assertJsonPath('data.drive_id', $this->driveId)
+        ->assertJsonPath('data.protocol', 'tus');
+    $uploadId = $created->json('data.upload_id');
+    expect($created->headers->get('Location'))->toEndWith('/api/vaulter/v1/uploads/'.$uploadId)
+        ->and($created->json('data'))->not->toHaveKey('assembled_blob_id');
+
+    $this->call('HEAD', V1::url('uploads/'.$uploadId), [], [], [], ['HTTP_TUS_RESUMABLE' => '1.0.0'])
+        ->assertNoContent()
+        ->assertHeader('Upload-Offset', '0')
+        ->assertHeader('Upload-Length', '10');
+
+    tusPatch($this, $uploadId, 0, '12345')->assertNoContent()->assertHeader('Upload-Offset', '5');
+    $this->getJson(V1::url('uploads/'.$uploadId))->assertOk()->assertJsonPath('data.received_bytes', 5);
+
+    $done = tusPatch($this, $uploadId, 5, '67890')
+        ->assertCreated()
+        ->assertHeader('Tus-Resumable', '1.0.0')
+        ->assertHeader('Upload-Offset', '10')
+        ->assertJsonPath('data.name', 'tus.bin')
+        ->assertJsonPath('data.size_bytes', 10);
+    expect($done->headers->get('ETag'))->toBe($done->json('data.etag'));
+});
+
+it('keeps the tus protocol refusals: a missing Tus-Resumable is 412 with the supported version', function (): void {
+    $uploadId = $this->postJson(V1::url('drives/'.$this->driveId.'/uploads'), ['name' => 'v.bin', 'total_size_bytes' => 4])->json('data.upload_id');
+
+    $this->call('PATCH', V1::url('uploads/'.$uploadId), [], [], [], ['HTTP_UPLOAD_OFFSET' => '0', 'CONTENT_TYPE' => 'application/offset+octet-stream', 'HTTP_ACCEPT' => 'application/json'], 'abcd')
+        ->assertStatus(412)
+        ->assertHeader('Tus-Resumable', '1.0.0')
+        ->assertHeader('Content-Type', 'application/problem+json');
+});
+
