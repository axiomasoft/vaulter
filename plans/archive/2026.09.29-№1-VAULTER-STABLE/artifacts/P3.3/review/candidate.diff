@@ -0,0 +1,46 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Vaulter\Drive\Content;
+
+use Vaulter\Enums\Cas\ScanMode;
+use Vaulter\Exceptions\Content\ContentQuarantinedException;
+use Vaulter\Models\Drive\FileRevision;
+use Vaulter\Operations\OperationContext;
+use Vaulter\Profiles\ProfilePolicy;
+use Vaulter\Profiles\ProfileRegistry;
+
+/** @internal P3.7 extends this destination admission seam with evidence and durable work. */
+final readonly class CopyDestinationAdmission
+{
+    public function __construct(private ProfilePolicy $policy, private ProfileRegistry $profiles) {}
+
+    public function assertSource(FileRevision $source): void
+    {
+        // Scan facts are authority for immutable bytes, including legacy infected rows.
+        $ids = $source->blobs()->pluck('blob_id')->all();
+        if ($source->blob_id !== null) {
+            $ids[] = $source->blob_id;
+        }
+        $infected = $source->newQuery()->where('scan_status', 'infected')
+            ->where(function ($query) use ($ids): void {
+                $query->whereIn('blob_id', $ids)
+                    ->orWhereHas('blobs', fn ($blobs) => $blobs->whereIn($blobs->getModel()->qualifyColumn('id'), $ids));
+            })->exists();
+        if ($source->scan_status === 'infected' || $infected) {
+            throw new ContentQuarantinedException;
+        }
+    }
+
+    public function status(OperationContext $context): string
+    {
+        foreach ($this->policy->scanSpecs($this->profiles->get($context->drive->profile)) as $spec) {
+            if ($spec->mode !== ScanMode::Off) {
+                return 'pending';
+            }
+        }
+
+        return 'not_required';
+    }
+}
