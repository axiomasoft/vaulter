name: vaulter-r03-4f565edf
services:
  app:
    build:
      context: /home/vostrikov/projects/packages/vaulter
      dockerfile: load/docker/Dockerfile.app
    cpuset: 0,2
    depends_on:
      minio-init:
        condition: service_completed_successfully
        required: true
      pgbouncer:
        condition: service_healthy
        required: true
      postgres:
        condition: service_healthy
        required: true
      redis:
        condition: service_healthy
        required: true
    environment:
      CACHE_STORE: redis
      DB_CONNECTION: pgsql
      DB_DATABASE: vaulter_r03_4f565edf_s
      DB_HOST: pgbouncer
      DB_MIGRATE_HOST: postgres
      DB_MIGRATE_PORT: "5432"
      DB_PASSWORD: secret
      DB_PORT: "6432"
      DB_USERNAME: vaulter
      LOAD_ATTEMPT: ""
      LOAD_CELL_ID: ""
      LOAD_DB_TRACE: "false"
      LOAD_DB_TRACE_PATH: ""
      LOAD_QUEUE_FINGERPRINT: ""
      LOAD_QUEUE_LEDGER: ""
      LOAD_RUN_ID: 4f565edf-58ca-47a0-869f-b9148ebcd2b6
      LOAD_SINK_HOSTS: webhook-sink,127.0.0.1,localhost
      LOAD_SINK_PORT: "8090"
      MINIO_BUCKET: vaulter-r03-4f565edf-s
      MINIO_ENDPOINT: http://minio:9000
      MINIO_REGION: us-east-1
      MINIO_ROOT_PASSWORD: vaulter-load-secret
      MINIO_ROOT_USER: vaulter
      PM_MAX_CHILDREN: "8"
      QUEUE_CONNECTION: redis
      REDIS_CLIENT: phpredis
      REDIS_HOST: redis
      REDIS_PORT: "6379"
      TESTBENCH_WORKING_PATH: /app
      TIER: S
      VAULTER_COLLAB_SECRET: vlt-load-dev-collab-secret-not-for-production
      VAULTER_LOAD_ID_STRATEGY: bigint
      VAULTER_LOAD_METRICS_ENABLED: "true"
      VAULTER_OBSERVABILITY_ENABLED: "true"
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q -O- http://127.0.0.1:8080/up >/dev/null 2>&1 || exit 1
      timeout: 3s
      interval: 3s
      retries: 60
    image: vaulter-load-app:latest
    mem_limit: "2147483648"
    memswap_limit: "2147483648"
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8183"
        protocol: tcp
    volumes:
      - type: bind
        source: /home/vostrikov/projects/packages/vaulter
        target: /app
        bind: {}
      - type: bind
        source: /home/vostrikov/projects/packages/vaulter/load/app/testbench.load.yaml
        target: /app/testbench.yaml
        read_only: true
        bind: {}
    working_dir: /app
  hocuspocus:
    build:
      context: /home/vostrikov/projects/packages/vaulter/hocuspocus-server
      dockerfile: Dockerfile
    depends_on:
      app:
        condition: service_healthy
        required: true
    environment:
      NODE_ENV: production
      VAULTER_API_PREFIX: api/vaulter
      VAULTER_BACKEND_URL: http://app:8080
      VAULTER_COLLAB_ALLOWED_ORIGINS: '*'
      VAULTER_COLLAB_HEALTH_PORT: "1235"
      VAULTER_COLLAB_PORT: "1234"
      VAULTER_COLLAB_WEBHOOK_SECRET: vlt-load-dev-collab-secret-not-for-production
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - fetch('http://localhost:1235/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))
      timeout: 3s
      interval: 5s
      retries: 20
    networks:
      default: null
    ports:
      - mode: ingress
        target: 1235
        published: "1235"
        protocol: tcp
  minio:
    cpuset: "6"
    command:
      - server
      - /data
      - --console-address
      - :9001
    environment:
      MINIO_ROOT_PASSWORD: vaulter-load-secret
      MINIO_ROOT_USER: vaulter
    healthcheck:
      test:
        - CMD
        - mc
        - ready
        - local
      timeout: 3s
      interval: 3s
      retries: 30
    image: minio/minio:latest
    mem_limit: "1073741824"
    memswap_limit: "1073741824"
    networks:
      default: null
    volumes:
      - type: volume
        source: minio-data
        target: /data
        volume: {}
  minio-init:
    depends_on:
      minio:
        condition: service_healthy
        required: true
    entrypoint:
      - sh
      - -c
      - mc alias set load http://minio:9000 vaulter vaulter-load-secret && mc mb --ignore-existing
        load/vaulter-r03-4f565edf-s && printf ok | mc pipe load/vaulter-r03-4f565edf-s/.vaulter-health-sentinel
    image: minio/mc:latest
    networks:
      default: null
    restart: 'no'
  pgbouncer:
    cpuset: 0,2
    depends_on:
      postgres:
        condition: service_healthy
        required: true
    environment:
      ADMIN_USERS: vaulter
      AUTH_TYPE: plain
      DATABASE_URL: postgres://vaulter:secret@postgres:5432/vaulter_r03_4f565edf_s
      DEFAULT_POOL_SIZE: "8"
      LISTEN_PORT: "6432"
      MAX_CLIENT_CONN: "200"
      POOL_MODE: transaction
      RESERVE_POOL_SIZE: "2"
      RESERVE_POOL_TIMEOUT: "3"
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -h 127.0.0.1 -p 6432 -U vaulter -d vaulter_load
      timeout: 3s
      interval: 3s
      retries: 30
    image: edoburu/pgbouncer:latest
    mem_limit: "268435456"
    memswap_limit: "268435456"
    networks:
      default: null
  postgres:
    build:
      context: /home/vostrikov/projects/packages/vaulter/load
      dockerfile: docker/Dockerfile.postgres-profile
    cpuset: "4"
    command:
      - postgres
      - -c
      - shared_buffers=1GB
      - -c
      - effective_cache_size=3GB
      - -c
      - work_mem=16MB
      - -c
      - maintenance_work_mem=256MB
      - -c
      - max_connections=32
      - -c
      - max_parallel_workers_per_gather=0
      - -c
      - random_page_cost=1.1
      - -c
      - effective_io_concurrency=200
      - -c
      - checkpoint_timeout=15min
      - -c
      - max_wal_size=4GB
      - -c
      - log_lock_waits=on
      - -c
      - deadlock_timeout=1s
      - -c
      - shared_preload_libraries=pg_stat_statements
      - -c
      - pg_stat_statements.track=all
      - -c
      - pg_stat_statements.max=10000
      - -c
      - fsync=on
      - -c
      - synchronous_commit=on
      - -c
      - full_page_writes=on
    environment:
      POSTGRES_DB: vaulter_load
      POSTGRES_PASSWORD: secret
      POSTGRES_USER: vaulter
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U vaulter -d vaulter_load
      timeout: 3s
      interval: 3s
      retries: 30
    image: vaulter-load-postgres-profile:16-hypopg-1.4.1
    mem_limit: "4294967296"
    memswap_limit: "4294967296"
    networks:
      default: null
    volumes:
      - type: volume
        source: pg-data
        target: /var/lib/postgresql/data
        volume: {}
  prometheus:
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --web.enable-remote-write-receiver
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q -O- http://127.0.0.1:9090/-/ready >/dev/null 2>&1 || exit 1
      timeout: 3s
      interval: 3s
      retries: 30
    image: prom/prometheus:latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 9090
        published: "9093"
        protocol: tcp
    volumes:
      - type: bind
        source: /home/vostrikov/projects/packages/vaulter/load/docker/prometheus.yml
        target: /etc/prometheus/prometheus.yml
        read_only: true
        bind: {}
      - type: volume
        source: prom-data
        target: /prometheus
        volume: {}
  queue-worker:
    build:
      context: /home/vostrikov/projects/packages/vaulter
      dockerfile: load/docker/Dockerfile.app
    command:
      - php
      - vendor/bin/testbench
      - queue:work
      - redis
      - --queue=load-health,default
      - --sleep=1
      - --tries=1
    depends_on:
      app:
        condition: service_healthy
        required: true
      redis:
        condition: service_healthy
        required: true
      webhook-sink:
        condition: service_started
        required: true
    environment:
      CACHE_STORE: redis
      DB_CONNECTION: pgsql
      DB_DATABASE: vaulter_load
      DB_HOST: pgbouncer
      DB_PASSWORD: secret
      DB_PORT: "6432"
      DB_USERNAME: vaulter
      LOAD_ATTEMPT: ""
      LOAD_CELL_ID: ""
      LOAD_DB_TRACE: "false"
      LOAD_DB_TRACE_PATH: ""
      LOAD_QUEUE_CONTEXT: /app/load/seed/out/p6-queue-context.json
      LOAD_QUEUE_FINGERPRINT: ""
      LOAD_QUEUE_LEDGER: ""
      LOAD_RUN_ID: ""
      LOAD_SINK_HOSTS: webhook-sink,127.0.0.1,localhost
      LOAD_SINK_PORT: "8090"
      MINIO_BUCKET: vaulter-load
      MINIO_ENDPOINT: http://minio:9000
      MINIO_REGION: us-east-1
      MINIO_ROOT_PASSWORD: vaulter-load-secret
      MINIO_ROOT_USER: vaulter
      PM_MAX_CHILDREN: "1"
      QUEUE_CONNECTION: redis
      REDIS_CLIENT: phpredis
      REDIS_HOST: redis
      REDIS_PORT: "6379"
      TESTBENCH_WORKING_PATH: /app
      TIER: S
      VAULTER_LOAD_ID_STRATEGY: bigint
      VAULTER_LOAD_METRICS_ENABLED: "true"
    networks:
      default: null
    volumes:
      - type: bind
        source: /home/vostrikov/projects/packages/vaulter
        target: /app
        bind: {}
      - type: bind
        source: /home/vostrikov/projects/packages/vaulter/load/app/testbench.load.yaml
        target: /app/testbench.yaml
        read_only: true
        bind: {}
    working_dir: /app
  redis:
    command:
      - redis-server
      - --save
      - ""
      - --appendonly
      - 'no'
    healthcheck:
      test:
        - CMD
        - redis-cli
        - ping
      timeout: 3s
      interval: 3s
      retries: 30
    image: redis:7-alpine
    networks:
      default: null
  webhook-sink:
    build:
      context: /home/vostrikov/projects/packages/vaulter
      dockerfile: load/docker/Dockerfile.app
    entrypoint:
      - php
      - -S
      - 0.0.0.0:8090
      - -t
      - /app/load/webhook-sink
      - /app/load/webhook-sink/router.php
    environment:
      LOAD_SINK_DELAY_MS: "50"
      LOAD_SINK_HANG_SECONDS: "8"
      LOAD_SINK_LEDGER: /app/load/seed/out/sink-ledger.jsonl
      LOAD_SINK_PORT: "8090"
    expose:
      - "8090"
    networks:
      default: null
    volumes:
      - type: bind
        source: /home/vostrikov/projects/packages/vaulter
        target: /app
        bind: {}
    working_dir: /app
networks:
  default:
    name: vaulter-r03-4f565edf_default
volumes:
  minio-data:
    name: vaulter-load_minio-data
    external: true
  pg-data:
    name: vaulter-load_pg-data
    external: true
  prom-data:
    name: vaulter-r03-4f565edf_prom-data
