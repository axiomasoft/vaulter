# VLT-LOAD (plans/VLT-LOAD) — run artifacts, not stand definition (seed manifests/
# snapshots are P2.3, not produced yet — ignored ahead of time so they never land by accident).
load/seed/out/
load/*.tar
load/*.tar.gz
# load/scripts/run.sh (P2.4) stages the seed manifest here for the k6 container to read
# (docker-compose.load.yml only mounts load/k6/, not load/seed/out/) — a run artifact.
load/k6/dataset.json
# load/scripts/run.sh (P2.5) stages the gates/thresholds.js source here for the same
# reason (k6 container only mounts load/k6/, not load/gates/) — a run artifact, not a
# second source of truth.
load/k6/lib/thresholds.js
# perf-assert.py/collect-container-stats.sh outputs (P2.5) — run artifacts, not spec.
# Non-recursive: does NOT match load/baselines/*.json (those ARE committed — slo-gates.md
# §4.1: baseline is a version-reviewed artifact) or load/seed/profiles/*.
load/*.json
# k6's writable output mount (docker-compose.load.yml `k6.volumes`) — summary.json etc,
# always a run artifact.
load/results/
# load/gates/*.py bytecode cache — never a repo artifact.
load/gates/__pycache__/
.grok/config.toml
/:memory:
.claude/.maind-feature-log.last
.claude/maind-*.sh
.claude/settings.json
.claude/agent-pack.lock.json

# Local quality/baseline run output (plans VLT-LOAD, KERNEL P1)
/var/
.grok/state/
