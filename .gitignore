# Load stand run artifacts, not the stand definition (seed manifests and snapshots are
# ignored ahead of time so they never land by accident).
load/seed/out/
load/*.tar
load/*.tar.gz
# load/scripts/run.sh stages the seed manifest here for the k6 container to read
# (docker-compose.load.yml only mounts load/k6/, not load/seed/out/) — a run artifact.
load/k6/dataset.json
# load/scripts/run.sh stages the gates/thresholds.js source here for the same
# reason (k6 container only mounts load/k6/, not load/gates/) — a run artifact, not a
# second source of truth.
load/k6/lib/thresholds.js
# perf-assert.py/collect-container-stats.sh outputs — run artifacts, not spec.
# Non-recursive: does NOT match load/baselines/*.json (those ARE committed — slo-gates.md
# §4.1: baseline is a version-reviewed artifact) or load/seed/profiles/*.
load/*.json
# k6's writable output mount (docker-compose.load.yml `k6.volumes`) — summary.json etc,
# always a run artifact.
load/results/
# load/gates/*.py bytecode cache — never a repo artifact.
load/gates/__pycache__/
/:memory:

# Local quality and baseline run output
/var/
# Generated coverage report
coverage.xml
clover.xml

