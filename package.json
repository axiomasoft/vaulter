{
  "name": "vaulter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vaulter monorepo — Vue components and VitePress documentation.",
  "workspaces": [
    "packages/vue"
  ],
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "npm run build --workspace @vaulter/vue",
    "test": "npm run test --workspace @vaulter/vue",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@microsoft/api-extractor": "7.58.9",
    "typescript": "5.9.3",
    "vitepress": "^1.6.3",
    "vue-tsc": "2.2.12"
  }
}
