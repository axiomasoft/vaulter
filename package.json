{
  "name": "vaulter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vaulter monorepo — Vue components, Hocuspocus collaboration server and VitePress documentation.",
  "workspaces": [
    "packages/vue",
    "hocuspocus-server"
  ],
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "npm run build --workspace @vaulter/vue",
    "test": "npm run test --workspace @vaulter/vue"
  },
  "devDependencies": {
    "vitepress": "^1.6.3"
  }
}
