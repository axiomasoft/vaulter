# DocVault collaboration server
DOCVAULT_COLLAB_PORT=1234

# Shared with the Laravel backend (config/docvault.php → collaboration.*)
DOCVAULT_COLLAB_APP_ID=your-app-id
DOCVAULT_COLLAB_SECRET=your-secret-key

# Laravel backend base URL used to validate tokens / persist snapshots
DOCVAULT_BACKEND_URL=http://localhost
