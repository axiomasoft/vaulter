# Vaulter collaboration server
VAULTER_COLLAB_PORT=1234

# Shared with the Laravel backend (config/vaulter.php → collaboration.*)
VAULTER_COLLAB_APP_ID=your-app-id
VAULTER_COLLAB_SECRET=your-secret-key

# Laravel backend base URL used to validate tokens / persist snapshots
VAULTER_BACKEND_URL=http://localhost
