includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max

    paths:
        - packages/core/src
        - packages/core/database

    inferPrivatePropertyTypeFromConstructor: true
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Eloquent dynamic builder/property magic that Larastan cannot fully model.
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder#'
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model#'

        # NullPermissionDriver implements the PermissionDriver contract, whose override()
        # is ?Effect (a real driver returns null when it has no opinion). The OPEN
        # null-driver always returns Effect::Allow by design (H.2 / D6″), so the
        # concrete body never hits the null branch — but the declared type must stay
        # nullable to satisfy the interface. The over-strict return.unusedType is
        # scoped to this env-gated test-support class only.
        -
            identifier: return.unusedType
            path: packages/core/src/Testing/NullPermissionDriver.php

        # The commit path stages the upload stream INTO the CAS inside the transaction
        # (uploadFile->execute), which may consume + fclose it; the finally re-guards
        # with is_resource() to avoid a double-close. PHPStan proves the stream is a
        # resource from the entry guard and cannot see that runtime mutation, so it
        # flags the (genuinely necessary) re-check as always-true. Scoped to this line.
        -
            identifier: if.alwaysTrue
            path: packages/core/src/Drive/Uploads/Actions/CommitUploadAction.php

        # HasDrives is the opt-in trait a HOST puts on its own model (the same way it uses
        # Laravel's own traits); the package never applies it, so the analysis of
        # "a trait used zero times" does not apply. Scoped to this one file.
        -
            identifier: trait.unused
            path: packages/core/src/Concerns/HasDrives.php

        # Shipped for host test suites: the trait is consumed by Pest `uses()` in the
        # host's own tests, never inside this package's src.
        -
            identifier: trait.unused
            path: packages/core/src/Testing/InteractsWithVaulter.php

        # Offered to package providers (the manifest is declared from their register()); the
        # package's own providers adopt it in their own items, the fixture provider in tests.
        -
            identifier: trait.unused
            path: packages/core/src/Modules/OffersModules.php
