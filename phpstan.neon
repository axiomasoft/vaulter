includes:
    - vendor/axiomasoft/packman-devtools/config/phpstan-base.neon
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon

rules:
    - Vaulter\Ci\VaulterSqlStopRail

parameters:
    level: max
    tmpDir: build/phpstan
    paths:
        - packages/core/src
        - packages/core/database
        - packages/media/src
        - packages/media/database
        - packages/drive/src
        - packages/drive/database
        - packages/documents/src
        - packages/documents/database
        - packages/collaboration/src
        - packages/collaboration/database
        - packages/webhooks/src
        - packages/webhooks/database
        - packages/azguard/src
        - packages/filament/src

    inferPrivatePropertyTypeFromConstructor: true

    disallowedStaticCalls:
        -
            method: 'Illuminate\Support\Facades\DB::transaction()'
            message: 'Use VaulterDatabase::transaction().'

    disallowedMethodCalls:
        -
            method: 'Illuminate\Database\ConnectionInterface::transaction()'
            message: 'Use VaulterDatabase::transaction().'
            allowIn:
                - packages/core/src/Database/VaulterDatabase.php
                # The migrator runs DDL on the migration's own connection.
                - packages/core/src/Console/ModuleUninstallCommand.php
        -
            method: 'ZipArchive::extractTo()'
            message: 'Inspect a bounded ZIP directory before reading entries.'

    disallowedFunctionCalls:
        -
            function: 'parse_url()'
            message: 'Use purpose-specific URL validation.'
        -
            function: 'env()'
            message: 'Read environment variables from configuration files.'
            allowIn:
                - '*/config/*.php'

    disallowedNamespaces:
        -
            class: 'Illuminate\Foundation\Http\Middleware\VerifyCsrfToken'
            message: 'Use Laravel 13 PreventRequestForgery.'

    disallowedConstants:
        -
            constant: CURLOPT_RESOLVE
            message: 'Pin webhook connections with CURLOPT_CONNECT_TO.'

    ignoreErrors:
        # Illuminate\Database\Query\Builder and Staudenmeir\LaravelCte\Query\Builder declare incompatible PHPDoc parameter types for insertUsing/insertOrIgnoreUsing/updateFrom and bare Closure.
        -
            identifier: method.childParameterType
            message: '#of method Vaulter\\Database\\(GuardedBuilder|GuardedCteBuilder)::(insertUsing|insertOrIgnoreUsing|updateFrom)\(\) should be contravariant with parameter#'
            path: packages/core/src/Database/GuardsStatements.php

        # Illuminate\Database\Eloquent\Factories\Factory::for() omits the generic type argument in Laravel's PHPDoc.
        -
            identifier: method.childParameterType
            message: '#of method Vaulter\\Drive\\Database\\Factories\\(DriveFactory|FileRevisionFactory)::for\(\) should be contravariant with parameter#'
            paths:
                - packages/drive/database/factories/DriveFactory.php
                - packages/drive/database/factories/FileRevisionFactory.php

        # Shipped host/test-kit traits consumed by host apps or Pest test suites outside src/.
        -
            identifier: trait.unused
            paths:
                - packages/core/src/Testing/Concerns/*.php
                - packages/core/src/Testing/Support/OpenApi/ValidatesOpenApiResponses.php
                - packages/media/src/Testing/Contracts/StorageDriverContractTests.php
                - packages/drive/src/Concerns/HasDrives.php
                - packages/drive/src/Testing/Concerns/ExercisesWideNodeListing.php
                - packages/documents/src/Testing/Contracts/DocumentTypeContractTests.php
                - packages/documents/src/Testing/Contracts/CollaborationProtocolContractTests.php

        # NullPermissionDriver implements PermissionDriver::override(): ?Effect, returning Effect::Allow unconditionally by design.
        -
            identifier: return.unusedType
            path: packages/drive/src/Testing/NullPermissionDriver.php

        # Larastan marks forwarded Eloquent/Container/Auth magic reflections as isStatic(): true, colliding with phpstan-strict-rules.
        -
            identifier: staticMethod.dynamicCall
            message: '#^Dynamic call to static method (Illuminate\\Database\\Eloquent\\(Builder|Model)|Vaulter\\Drive\\Repositories\\NodeQueryBuilder|Illuminate\\Container\\Container|Illuminate\\Contracts\\Auth\\(Guard|Authenticatable)|Illuminate\\Auth\\SessionGuard|Illuminate\\Http\\Client\\PendingRequest)#'
