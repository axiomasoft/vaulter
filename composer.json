{
    "name": "axiomasoft/vaulter-monorepo",
    "description": "Vaulter — embeddable document management for Laravel (monorepo dev workspace).",
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/axiomasoft/vaulter",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/vaulter": "1.0.x-dev",
                    "axiomasoft/vaulter-azguard": "1.0.x-dev",
                    "axiomasoft/vaulter-core": "1.0.x-dev",
                    "axiomasoft/vaulter-documents": "1.0.x-dev",
                    "axiomasoft/vaulter-drive": "1.0.x-dev",
                    "axiomasoft/vaulter-filament": "1.0.x-dev",
                    "axiomasoft/vaulter-media": "1.0.x-dev",
                    "axiomasoft/vaulter-webhooks": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../packman/packages/*",
            "options": {
                "symlink": false,
                "versions": {
                    "axiomasoft/packman": "0.1.1",
                    "axiomasoft/packman-devtools": "0.1.1",
                    "axiomasoft/packman-filament": "0.1.1",
                    "axiomasoft/packman-panels": "0.1.1",
                    "axiomasoft/packman-plugins": "0.1.1",
                    "axiomasoft/packman-schema": "0.1.1",
                    "axiomasoft/packman-testkit": "0.1.1"
                }
            }
        },
        {
            "type": "path",
            "url": "../azguard/packages/*",
            "options": {
                "symlink": false,
                "versions": {
                    "axiomasoft/azguard": "2.0.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-plugins": "^0.1",
        "axiomasoft/packman-schema": "^0.1",
        "axiomasoft/vaulter-core": "@dev",
        "axiomasoft/vaulter-documents": "@dev",
        "axiomasoft/vaulter-drive": "@dev",
        "axiomasoft/vaulter-media": "@dev",
        "axiomasoft/vaulter": "@dev"
    },
    "require-dev": {
        "axiomasoft/packman-devtools": "^0.1",
        "axiomasoft/packman-testkit": "^0.1",
        "axiomasoft/vaulter-azguard": "@dev",
        "axiomasoft/vaulter-filament": "@dev",
        "axiomasoft/vaulter-webhooks": "@dev",
        "driftingly/rector-laravel": "^2.7",
        "larastan/larastan": "^3.15.0",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.32",
        "laravel/sanctum": "^4.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "nikic/php-parser": "^5.7",
        "open-telemetry/api": "^1.1",
        "open-telemetry/sdk": "^1.16.1",
        "opis/json-schema": "^2.4",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-type-coverage": "^5.1",
        "phpstan/phpstan": "^2.3.6",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "rector/rector": "^2.6",
        "spatie/laravel-permission": "^8.0",
        "spaze/phpstan-disallowed-calls": "^4.15.1",
        "symfony/yaml": "^8.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Ci\\": "scripts/ci/",
            "Vaulter\\Tests\\": "packages/core/tests/",
            "Vaulter\\Integration\\Tests\\": "tests/Integration/",
            "Vaulter\\Documents\\Tests\\": "packages/documents/tests/",
            "Vaulter\\Load\\": "load/app/",
            "Vaulter\\Load\\Tests\\": "load/tests/",
            "Vaulter\\Media\\Tests\\": "packages/media/tests/",
            "Vaulter\\Drive\\Tests\\": "packages/drive/tests/",
            "Vaulter\\Webhooks\\Tests\\": "packages/webhooks/tests/",
            "Vaulter\\AzGuard\\Tests\\": "packages/azguard/tests/",
            "Vaulter\\Filament\\Tests\\": "packages/filament/tests/"
        }
    },
    "extra": {
        "phpstan/extension-installer": {
            "ignore": [
                "larastan/larastan",
                "nesbot/carbon",
                "pestphp/pest",
                "phpstan/phpstan-strict-rules",
                "spaze/phpstan-disallowed-calls"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "process-timeout": 1800,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "tbachert/spi": false
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": [
            "@php vendor/bin/testbench package:discover",
            "vendor/bin/phpstan analyse --memory-limit=1G --no-progress"
        ],
        "phpstan": "@analyse",
        "refactor": "vendor/bin/rector process",
        "refactor:check": "vendor/bin/rector process --dry-run",
        "test": "scripts/t sqlite",
        "test:pg": "scripts/t pgsql --full",
        "test:all": "scripts/t sqlite",
        "test:changed": "scripts/t --changed --db=pgsql",
        "test:db": "scripts/t pgsql --group=database",
        "test:full": "scripts/t sqlite --full",
        "test:baseline": "scripts/t baseline --compare",
        "gate": "@php vendor/bin/packman gate",
        "php-api": "@php vendor/bin/packman php-api --check",
        "error-codes": "@php vendor/bin/packman error-codes --check",
        "config-schema": "@php vendor/bin/packman config-schema --check",
        "ai:sync": "@php vendor/bin/packman ai:sync --dry-run"
    }
}
